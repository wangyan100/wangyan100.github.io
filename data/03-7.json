    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Dieses Waschmittel beschädigt die Wäsche nicht.",
          "start": 117.31,
          "end": 120.21
        },
        {
          "text": "Er wirft die Wäsche in den Wäschekorb.",
          "start": 123.26,
          "end": 126.14
        },
        {
          "text": "Die Türklingel des Hauses ist defekt.",
          "start": 129.38,
          "end": 132.32
        },
        {
          "text": "Das 3-jährige Kind kann die Türklinke noch nicht erreichen.",
          "start": 135.45,
          "end": 140.05
        },
        {
          "text": "Er reibt seine Schuhe auf der Fußmatte.",
          "start": 143.13,
          "end": 146.45
        },
        {
          "text": "Der Schuhlöffel hat eine längliche Form und ein gebogenes Ende.",
          "start": 149.22,
          "end": 154.28
        },
        {
          "text": "Diese Flasche Rotwein hat 5 Jahre im Keller gelagert.",
          "start": 157.56,
          "end": 162.48
        },
        {
          "text": "Mit einer Bohrmaschine hat er ein Loch in die Wand gebohrt.",
          "start": 165.08,
          "end": 169.14
        },
        {
          "text": "Du triffst den Nagel auf den Kopf.",
          "start": 172.16,
          "end": 174.6
        },
        {
          "text": "Die Säge schreit.",
          "start": 177.71,
          "end": 179.53
        },
        {
          "text": "Der Säugling saugt Milch mit Sauger von der Babyflasche.",
          "start": 182.14,
          "end": 186.94
        },
        {
          "text": "Der Säugling saugt an der Mutterbrust.",
          "start": 189.66,
          "end": 192.94
        },
        {
          "text": "Damals lag er noch in den Windeln.",
          "start": 196.05,
          "end": 198.29
        }
      ]
    }
