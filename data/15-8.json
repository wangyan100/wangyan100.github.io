    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Hunde, die viel bellen, beißen nicht.",
          "start": 129.39,
          "end": 132.81
        },
        {
          "text": "Die Hundeleine wird oft am Halsband des Hundes befestigt.",
          "start": 135.88,
          "end": 139.98
        },
        {
          "text": "Die Haltung von Haushunden ist in Deutschland steuerpflichtig und die Hundesteuer wird von der Gemeinde erhoben.",
          "start": 143.06,
          "end": 150.8
        },
        {
          "text": "Der Labrador ist ein mittelgroßer und kräftig gebauter Hund mit einem breiteren Schädel.",
          "start": 153.8,
          "end": 159.88
        },
        {
          "text": "Die Katze ist so glücklich, weil es heute mehr Futter als sonst gibt.",
          "start": 162.67,
          "end": 167.19
        },
        {
          "text": "Kater fühlte sich auf seinem Arm sichtlich wohl.",
          "start": 169.56,
          "end": 173.64
        },
        {
          "text": "Wenn man so wachsam wie die Wildkatze ist, dann kann einem gar nichts passieren.",
          "start": 176.69,
          "end": 181.75
        },
        {
          "text": "Hamster sind vorwiegend Pflanzenfresser und insbesondere Samenfresser.",
          "start": 185.01,
          "end": 190.15
        },
        {
          "text": "Meerschweinchen sind Pflanzenfresser, die je nach Art und Lebensraum unterschiedlichste Pflanzen zu sich nehmen.",
          "start": 193.47,
          "end": 200.39
        },
        {
          "text": "Der Hase stellt die Löffel hoch.",
          "start": 203.49,
          "end": 205.73
        },
        {
          "text": "Mit Kamm und Bürste kann man die losen Haare der Angora-Kaninchen auskämmen, damit das Fell nicht verfilzt.",
          "start": 207.97,
          "end": 216.55
        },
        {
          "text": "Die Affen rollen beim Laufen den Schwanz ein.",
          "start": 219.6,
          "end": 222.66
        },
        {
          "text": "Bei den im Aquarium kultivierten Pflanzen handelt es sich entweder um Wasserpflanzen oder um auch Emas gedeihende Sumpfpflanzen.",
          "start": 225.59,
          "end": 235.11
        },
        {
          "text": "Hier darf der Vermieter seinen Mietern untersagen, diese Tiere zu füttern.",
          "start": 238.32,
          "end": 243.0
        }
      ]
    }
