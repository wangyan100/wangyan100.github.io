    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Blütezeit von Geisblatt dauert von Mai bis Juni an.",
          "start": 136.49,
          "end": 141.27
        },
        {
          "text": "Die Nachtkerze gilt heute als eines der besten Heilkräuter bei Hautbeschwerden.",
          "start": 144.22,
          "end": 150.2
        },
        {
          "text": "Wenn es sehr kalt wird, rollen sich die Blütenblätter der Zaubernuss zum Schutz ein.",
          "start": 153.04,
          "end": 158.86
        },
        {
          "text": "In unserem Garten steht ein großer lilafarbener Flieder.",
          "start": 161.13,
          "end": 165.93
        },
        {
          "text": "In der griechischen Mythologie heißt es, Hyacinthen seien aus den Blutstropfen des getöteten Jünglings Hyakintos.",
          "start": 168.97,
          "end": 177.37
        },
        {
          "text": "Im Blumenbeet neben der Haustüre wachsen Primeln und Stiefmütterchen.",
          "start": 180.98,
          "end": 186.12
        },
        {
          "text": "Die Azalee ist als Zimmerpflanze im Winter sehr beliebt.",
          "start": 189.04,
          "end": 193.46
        },
        {
          "text": "In Japan symbolisiert die Kirschblüte Schönheit und Vergänglichkeit.",
          "start": 195.7,
          "end": 201.78
        },
        {
          "text": "Er ist empfindlich wie eine Mimose.",
          "start": 204.9,
          "end": 207.46
        },
        {
          "text": "In Hawaii wird die Blüte vom Hibiskus als Haarschmuck getragen.",
          "start": 210.52,
          "end": 215.66
        },
        {
          "text": "Kamelien gelten als eher empfindliche und schwer zu pflegende Zierpflanzen.",
          "start": 218.65,
          "end": 223.61
        },
        {
          "text": "Aus der Türkei kam die Tulpe um die Mitte des 16.",
          "start": 226.79,
          "end": 230.51
        },
        {
          "text": "Jahrhunderts nach Mittel- und Westeuropa.",
          "start": 230.69,
          "end": 232.27
        },
        {
          "text": "Gardeinie gehört zu den Halbpflanzen in der traditionellen chinesischen Medizin.",
          "start": 232.27,
          "end": 241.1
        },
        {
          "text": "Die Lilie ist in Europa eine wichtige Futterpflanze.",
          "start": 241.1,
          "end": 247.49
        }
      ]
    }
