    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Planen Sie entsprechende Zeit ein. 15 Minuten vor Abflug werden die Bordeingänge geschlossen.",
          "start": 137.66,
          "end": 144.56
        },
        {
          "text": "Sie können Ihre Bordkarte am Flughafen an einem Check-in-Automaten ausdrucken.",
          "start": 147.62,
          "end": 152.6
        },
        {
          "text": "Wenn Sie online einchecken, können Sie Ihr Übergepäck im Voraus bezahlen.",
          "start": 156.04,
          "end": 161.1
        },
        {
          "text": "Die Russin war 2016 mit einem Studentenvisum in die USA eingereist.",
          "start": 164.06,
          "end": 169.14
        },
        {
          "text": "Trotz eines schwerwiegenden technischen Defekts an ihrer Maschine ist die Kanzlerin unbeschadet in Köln gelandet.",
          "start": 169.14,
          "end": 180.81
        },
        {
          "text": "Ein Flugzeug musste heute auf dem Flug von Amsterdam nach Zürich wegen eines Triebwerkausfalls in Frankfurt-Notlanden.",
          "start": 183.76,
          "end": 191.94
        },
        {
          "text": "Der Flugkapitän sprach von einem technischen Problem, das den Ausfall einiger elektrischer Systeme bewirkt hat.",
          "start": 194.8,
          "end": 202.82
        },
        {
          "text": "Der Co-Pilot ist auch für den Funkverkehr auf dem Flugzeug zuständig, wenn er das Flugzeug nicht führt.",
          "start": 205.06,
          "end": 212.76
        },
        {
          "text": "An Bord der Maschine befinden sich 200 Passagiere.",
          "start": 215.94,
          "end": 219.96
        },
        {
          "text": "Passagiere dürfen nur ein Handgepäck mitnehmen.",
          "start": 223.19,
          "end": 226.23
        },
        {
          "text": "Nach dem Flugzeugabsturz war der Verbleib der zwei Piloten unklar.",
          "start": 229.32,
          "end": 234.76
        },
        {
          "text": "Während des Fluges kümmerten sich die Stördessen sehr gut um uns.",
          "start": 237.69,
          "end": 241.85
        },
        {
          "text": "Die Zollerklärung ist die wichtigste statistische Informationsquelle über den Warenaustausch.",
          "start": 244.19,
          "end": 251.55
        }
      ]
    }
