    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Religion kann Trost spenden und Ruhe stiften.",
          "start": 139.77,
          "end": 144.23
        },
        {
          "text": "Das Christentum ist die weltweit größte Religion.",
          "start": 147.15,
          "end": 150.89
        },
        {
          "text": "Wegen unterschiedlicher Kale, Die Kirchen der Orthodoxie Osten in diesem Jahr eine Woche später.",
          "start": 153.96,
          "end": 161.48
        },
        {
          "text": "Die Demonstranten, darunter viele Geistliche, versammelten sich vor dem Parlament und hielten Plakate und den Koran in die Höhe.",
          "start": 164.38,
          "end": 173.96
        },
        {
          "text": "Der Papst betet für Anschlagsopfer.",
          "start": 176.81,
          "end": 179.71
        },
        {
          "text": "Nach dem verheerenden Brand in Notre-Dame rückt die Frage nach dem Brandschutz in Deutschlands großen Domen in den Fokus.",
          "start": 182.7,
          "end": 190.92
        },
        {
          "text": "Jeden Sonntag findet in der Kirche der Gottesdienst statt.",
          "start": 193.12,
          "end": 197.86
        },
        {
          "text": "In Kalifornien hat ein fanatischer Antisemit in einer Synagoge das Feuer eröffnet, als Gläubige ein wichtiges jüdisches Fest feierten.",
          "start": 200.92,
          "end": 211.06
        },
        {
          "text": "Immer mehr Kirchengemeinden laden im Sommer zu Gottesdiensten oder Taufen unter freiem Himmel ein.",
          "start": 214.16,
          "end": 221.36
        },
        {
          "text": "Große deutsche Unternehmen spenden insgesamt 5 Millionen Euro und helfen beim Bau einer Holocaust-Gedenkstätte in Jerusalem.",
          "start": 224.38,
          "end": 234.7
        },
        {
          "text": "Martin Luther hat die Bibel ins Deutsche übersetzt.",
          "start": 237.85,
          "end": 241.11
        },
        {
          "text": "In einem Brief von 1954 hat Einstein seine Gedanken über Gott und die Welt beschrieben.",
          "start": 244.22,
          "end": 251.18
        }
      ]
    }
