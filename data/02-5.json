    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Kohlensäure verleiht dem Wasser einen gewissen Geschmack.",
          "start": 144.57,
          "end": 149.61
        },
        {
          "text": "Mineralwasser wird direkt am Gewinnungsort abgefüllt und benötigt eine amtliche Anerkennung.",
          "start": 152.4,
          "end": 159.38
        },
        {
          "text": "Wasser ohne Kohlensäure schmeckt immer wie Leitungswasser.",
          "start": 161.75,
          "end": 166.43
        },
        {
          "text": "Brausen werden nicht nur aus natürlichen Stoffen hergestellt, sondern können auch künstliche Aroma und Farbstoffe enthalten.",
          "start": 169.41,
          "end": 178.33
        },
        {
          "text": "Schorle hat weniger Kalorien, ist nicht so süß, leichter verträglich und erfrischender als purer Saft.",
          "start": 181.63,
          "end": 190.47
        },
        {
          "text": "Möchtest du den Saft gespritzt?",
          "start": 193.3,
          "end": 195.42
        },
        {
          "text": "In Deutschland werden jährlich ca. 6,6 Millionen Hektoliter Eistee abgesetzt.",
          "start": 197.95,
          "end": 205.12
        },
        {
          "text": "Der Hongkonger bevorzugt Milchtee oder Zitronenlimo mit Salz.",
          "start": 208.33,
          "end": 213.45
        },
        {
          "text": "Buttermilch enthält maximal 1% Fett.",
          "start": 216.58,
          "end": 219.9
        },
        {
          "text": "Sauermilch schlägt durch.",
          "start": 219.9,
          "end": 225.02
        },
        {
          "text": "Im Unterschied zu Joghurt werden bei der Herstellung von Dickmilch Laktokokken beigefügt.",
          "start": 225.02,
          "end": 234.37
        },
        {
          "text": "Vollmilch enthält mindestens 3,5% Fett.",
          "start": 234.37,
          "end": 241.65
        }
      ]
    }
  ]
