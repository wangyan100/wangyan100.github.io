    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Alle Besuche von Gruppen müssen vorher angemeldet werden.",
          "start": 128.12,
          "end": 132.16
        },
        {
          "text": "Audioguides gibt es für alle Museen in den Sprachen Deutsch und Englisch.",
          "start": 135.38,
          "end": 140.62
        },
        {
          "text": "Die genauen Termine werden durch Aushang bekannt gegeben.",
          "start": 143.3,
          "end": 146.9
        },
        {
          "text": "Die Führung durch das Historische Museum ist kostenlos.",
          "start": 150.03,
          "end": 153.77
        },
        {
          "text": "Ihre Garderobe können Sie hier ablegen.",
          "start": 156.86,
          "end": 160.06
        },
        {
          "text": "Rucksäcke und größere Taschen müssen abgegeben oder in Schließfächern aufbewahrt werden.",
          "start": 162.37,
          "end": 168.75
        },
        {
          "text": "Es ist nicht gestattet, in den Ausstellungsräumen zu essen oder zu trinken.",
          "start": 171.86,
          "end": 177.02
        },
        {
          "text": "In der Sonderausstellung sind viele hübsche Porzellane zu sehen.",
          "start": 180.1,
          "end": 184.08
        },
        {
          "text": "Der Roman ist ein Gemälde des Befreiungskrieges in China.",
          "start": 187.14,
          "end": 191.26
        },
        {
          "text": "Auf den ersten Blick erscheint sie wie ein Ölgemälde.",
          "start": 194.32,
          "end": 197.96
        },
        {
          "text": "Der Maler zeichnet von dem Besucher ein Portrait.",
          "start": 200.2,
          "end": 204.18
        },
        {
          "text": "Pergamonmuseum beeindruckt zahlreiche Touristen aus aller Welt.",
          "start": 207.56,
          "end": 212.04
        }
      ]
    }
