    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Er gibt seiner Freundin Brief und Siegel darauf, morgen rechtzeitig anzukommen.",
          "start": 112.03,
          "end": 118.31
        },
        {
          "text": "Diesen wichtigen Brief sollst du einschreiben lassen.",
          "start": 120.55,
          "end": 124.85
        },
        {
          "text": "Das Paket ist gut verpackt.",
          "start": 127.98,
          "end": 130.48
        },
        {
          "text": "Jetzt kann man die Pakete jederzeit direkt an einer Packstation versenden.",
          "start": 133.11,
          "end": 138.37
        },
        {
          "text": "Er klebt die Briefmarke auf den Brief.",
          "start": 141.48,
          "end": 144.28
        },
        {
          "text": "Um Zeit und Geld zu sparen, frankiert man die Post online.",
          "start": 147.34,
          "end": 151.74
        },
        {
          "text": "Der Postbeamte berechnet das Porto mit dem Rechner.",
          "start": 154.74,
          "end": 158.9
        },
        {
          "text": "Falls ein Brief verzogen, bitte zurück an den Absender.",
          "start": 161.53,
          "end": 165.11
        },
        {
          "text": "Bei einem offiziellen Brief gibt der Absender ganz oben seine Informationen an und schreibt darunter die Informationen des Empfängers.",
          "start": 168.22,
          "end": 177.36
        },
        {
          "text": "Wir bewahren Briefe, Postkarten etc., die während ihrer Abwesenheit eintreffen, sicher für Sie auf.",
          "start": 180.22,
          "end": 187.7
        },
        {
          "text": "An jedem Werktag stellen die deutschen Booten rund 59 Millionen Briefsendungen zu.",
          "start": 190.74,
          "end": 197.22
        },
        {
          "text": "Ich verpacke das Geschenk in einen Karton.",
          "start": 200.23,
          "end": 202.93
        }
      ]
    }
  ]
