    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Auf einen Hieb fällt kein Baum.",
          "start": 131.05,
          "end": 134.05
        },
        {
          "text": "Der Specht behackt die Rinde des Baumes.",
          "start": 136.97,
          "end": 140.13
        },
        {
          "text": "In den Wipfeln der Bäume rauscht der Wind.",
          "start": 143.08,
          "end": 146.12
        },
        {
          "text": "Dieser Gedanke fasst Wurzel in seinem Hirn.",
          "start": 149.39,
          "end": 152.73
        },
        {
          "text": "Als Holzlieferanten werden in Mitteleuropa vor allem die Birken genutzt.",
          "start": 155.31,
          "end": 161.35
        },
        {
          "text": "Im Sommer toben Kinder unter alten Eichen, Turnen auf Holzgerüsten und Spielen verstecken.",
          "start": 163.93,
          "end": 170.43
        },
        {
          "text": "Bei den Germanen und den Slaven galt die Linde als heiliger Baum.",
          "start": 173.24,
          "end": 178.16
        },
        {
          "text": "Diese Ulme ist vielleicht fünf Meter hoch.",
          "start": 181.27,
          "end": 184.09
        },
        {
          "text": "Diese Möbel aus Holz der Fichte sind solide gearbeitet.",
          "start": 187.14,
          "end": 191.04
        },
        {
          "text": "Lärchen werfen im Spätherbst ihre Blätter ab.",
          "start": 194.25,
          "end": 197.49
        },
        {
          "text": "Das natürliche Verbreitungsgebiet der Pinie befindet sich im nördlichen Mittelmeerraum und erstreckt sich von der iberischen Halbinsel bis nach Anatolien.",
          "start": 200.59,
          "end": 211.33
        },
        {
          "text": "Die Disteln ritzen seine nackten Füße.",
          "start": 214.34,
          "end": 217.18
        },
        {
          "text": "Hirtentäschel ist ein häufig anzutreffendes Unkraut in Gärten oder auf Äckern.",
          "start": 220.51,
          "end": 225.85
        },
        {
          "text": "Der Bahndamm ist voller Nesseln.",
          "start": 228.79,
          "end": 231.13
        },
        {
          "text": "Der Weg war von Quecken bewuchert.",
          "start": 234.24,
          "end": 236.66
        },
        {
          "text": "Der Spierstrauch ist recht pflegeleicht und anspruchslos und wird daher gerne in Grün- und Parkanlagen gepflanzt.",
          "start": 239.72,
          "end": 247.2
        }
      ]
    }
