    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Als Strafe musste er schließlich die Hosen fallen lassen und stand in blauen Boxershorts da.",
          "start": 114.6,
          "end": 120.86
        },
        {
          "text": "Diese Anzughose hat schon ausgebeulte Knie.",
          "start": 123.89,
          "end": 127.29
        },
        {
          "text": "Die Mutter hat ein Loch in den Bermudas gestopft.",
          "start": 130.37,
          "end": 133.55
        },
        {
          "text": "Die Bügelfalte ist eine Erfindung vom Anfang des 20.",
          "start": 136.23,
          "end": 140.43
        },
        {
          "text": "Jahrhunderts.",
          "start": 141.27,
          "end": 142.19
        },
        {
          "text": "Jeans waren nie wirklich out.",
          "start": 144.57,
          "end": 146.77
        },
        {
          "text": "Im Orangen Overall stehen er und seine Kumpels im warmen Sonnenlicht.",
          "start": 149.81,
          "end": 155.17
        },
        {
          "text": "Der Minirock erfreut sich bis heute besonderer Beliebtheit.",
          "start": 158.32,
          "end": 162.26
        },
        {
          "text": "Sie verwandte den Stoff für einen Plisserock.",
          "start": 165.29,
          "end": 168.63
        },
        {
          "text": "Sie hat beim Bügeln den Wickelrock gesenkt.",
          "start": 171.6,
          "end": 174.66
        },
        {
          "text": "Dieser Büstenhalter sieht nicht nur gut aus, er gehört auch zu den teuersten der Welt.",
          "start": 177.5,
          "end": 183.24
        },
        {
          "text": "Es ging jetzt um die Frage, ob sie ein Korsett tragen sollte.",
          "start": 186.37,
          "end": 190.23
        },
        {
          "text": "Ist das Mieder zu eng, kann es für bestimmte Muskeln schädlich sein.",
          "start": 193.34,
          "end": 197.66
        },
        {
          "text": "Mit beiden Händen hat sie vorsichtig den weißen Schlüpfer etwas nach unten gezogen.",
          "start": 200.72,
          "end": 205.92
        },
        {
          "text": "Für Männer ist das Unterhemd eines der wichtigsten Kleidungsstücke überhaupt.",
          "start": 209.02,
          "end": 213.72
        },
        {
          "text": "Eine Frau im Morgenmantel öffnet vorsichtig die Haustüre.",
          "start": 215.99,
          "end": 220.91
        }
      ]
    }
