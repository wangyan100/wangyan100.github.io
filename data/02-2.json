    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Im deutschen Sprachraum ist Sekt die Bezeichnung für hochwertige Schaumweine.",
          "start": 127.16,
          "end": 133.54
        },
        {
          "text": "Dessertwein wird in einigen Ländern am Ende einer Mahlzeit mit dem Dessert getrunken.",
          "start": 136.52,
          "end": 143.1
        },
        {
          "text": "Riesling genießt hohes Ansehen auf internationalen Märkten.",
          "start": 145.65,
          "end": 150.51
        },
        {
          "text": "Sie trinkt gern französische Rotweine.",
          "start": 153.47,
          "end": 156.37
        },
        {
          "text": "Um ihre Schaumweine noch besser in Szene zu setzen, engagieren die Winzer Künstler aus aller Welt.",
          "start": 158.74,
          "end": 166.66
        },
        {
          "text": "Man kann Portwein rot bei Zimmertemperatur trinken.",
          "start": 169.82,
          "end": 174.18
        },
        {
          "text": "Sherry wurde im 18. und 19.",
          "start": 177.04,
          "end": 179.6
        },
        {
          "text": "Jahrhundert durch englische Handelshäuser weltweit bekannt gemacht.",
          "start": 179.82,
          "end": 184.08
        },
        {
          "text": "Nach Qualitätsbezeichnung für Wein aus Deutschland ist Tafelwein die niedrigste Qualitätsstufe.",
          "start": 187.22,
          "end": 194.54
        },
        {
          "text": "Der Prädikatswein ist die Bezeichnung für die höchste Weinqualität in Deutschland.",
          "start": 196.81,
          "end": 202.85
        },
        {
          "text": "Die Auslese ist als Wein von der Güte zwischen der Spätlese und der Beerenauslese eingeordnet.",
          "start": 205.99,
          "end": 213.47
        },
        {
          "text": "Weinschorle besteht etwa zur Hälfte aus frischem Weißwein und kohlesäurehaltigem Mineralwasser.",
          "start": 216.69,
          "end": 223.89
        },
        {
          "text": "Honigwein ist zu jeder Jahres- und Tageszeit ein Genuss.",
          "start": 227.18,
          "end": 230.8
        },
        {
          "text": "Aus einer Ortschronik vom Ende des 19.",
          "start": 230.8,
          "end": 236.78
        },
        {
          "text": "Jahrhunderts geht hervor, dass Most auf der Schwäbischen Alb zu einem der wichtigsten Getränke zählte.",
          "start": 236.78,
          "end": 243.94
        }
      ]
    }
