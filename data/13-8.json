    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Belgien hat eine Fläche von 32.545 km².",
          "start": 117.9,
          "end": 124.6
        },
        {
          "text": "Es ist damit ein bisschen kleiner als das deutsche Bundesland Nordrhein-Westfalen.",
          "start": 127.97,
          "end": 133.43
        },
        {
          "text": "Deutschland ist etwa neunmal so groß wie die Schweiz.",
          "start": 136.03,
          "end": 139.47
        },
        {
          "text": "Amsterdam ist die Hauptstadt der Niederlande.",
          "start": 142.68,
          "end": 146.42
        },
        {
          "text": "Die Geografie von England ist geprägt durch niedrige Hügel und Ebenen, aber es gibt auch Hochland im Norden und Südwesten.",
          "start": 148.84,
          "end": 158.16
        },
        {
          "text": "Im Alter von 16 Jahren wurde er von Seeräubern nach Irland entführt.",
          "start": 160.62,
          "end": 166.1
        },
        {
          "text": "Staatsoberhaupt des Vatikans ist der Papst.",
          "start": 169.14,
          "end": 172.2
        },
        {
          "text": "Das ist der Vorsteher der römisch-katholischen Christen.",
          "start": 172.78,
          "end": 176.1
        },
        {
          "text": "Der nördliche Teil Finnlands liegt über dem Polarkreis.",
          "start": 179.14,
          "end": 183.12
        },
        {
          "text": "Die Einwohner Äthiopiens sprechen über 80 verschiedene Sprachen.",
          "start": 185.98,
          "end": 190.6
        },
        {
          "text": "Den elektrischen Strom hat Marokko vor allem aus Kraftwerken, die mit Erdöl oder Erdgas betrieben werden.",
          "start": 193.4,
          "end": 200.7
        },
        {
          "text": "In Rwanda gibt es zwei große Volksgruppen, Hutu und Tutsi.",
          "start": 203.82,
          "end": 209.48
        },
        {
          "text": "In der Kolonialzeit gehörte ein Teil von Somalia zu Italien und ein anderer Teil zu Großbritannien.",
          "start": 212.06,
          "end": 219.5
        },
        {
          "text": "Palau lebt heute vor allem vom Tourismus und dem Fischfang.",
          "start": 222.56,
          "end": 226.6
        }
      ]
