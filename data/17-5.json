    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Pharao war im alten Ägypten ein Titel für den König.",
          "start": 123.25,
          "end": 127.25
        },
        {
          "text": "Die größte und bekannteste Pyramide ist die Cheops-Pyramide aus dem alten Ägypten.",
          "start": 130.35,
          "end": 135.99
        },
        {
          "text": "In einer Bibliothek in Amsterdam haben die Autoren in uralten Schriften nach dem Schlüssel der Sphinx gesucht.",
          "start": 139.02,
          "end": 146.14
        },
        {
          "text": "Die Konstruktionsweise dieses Gewölbes weckt das Interesse vieler Baufachleute.",
          "start": 149.18,
          "end": 154.66
        },
        {
          "text": "Das Gewölbe wird von Säulen gestützt.",
          "start": 157.54,
          "end": 160.54
        },
        {
          "text": "Die Kreuzblume findet sich als Schmuck auf Dachfürsten, Giebeln, Fialen und Turmpyramiden.",
          "start": 163.49,
          "end": 170.49
        },
        {
          "text": "Die Akropolis ist ein Weltkulturerbe der UNESCO und zielt heute viele Urlauber an.",
          "start": 173.53,
          "end": 179.77
        },
        {
          "text": "Der Patenon war sowohl innen als auch außen mit aufwendigen Marmornen-Bildhauer-Arbeiten dekoriert.",
          "start": 182.71,
          "end": 189.57
        },
        {
          "text": "Der Dacherker dient zur Belichtung und Belüftung des Dachraumes.",
          "start": 191.88,
          "end": 197.28
        },
        {
          "text": "Das Rollwerk ist eine Dekorationsform, die hauptsächlich in der Kunst- und Architektur Frühbarock vorkommt.",
          "start": 200.39,
          "end": 207.13
        },
        {
          "text": "Die Zeitdauer ist ein unbezahlbarer Schatz.",
          "start": 207.13,
          "end": 213.47
        },
        {
          "text": "Absieden sind typische Bestandteile von antiken Basiliken.",
          "start": 213.47,
          "end": 220.28
        },
        {
          "text": "Die steinerne Brücke ruht auf vier Pfeilern.",
          "start": 220.28,
          "end": 226.49
        }
      ]
    }
