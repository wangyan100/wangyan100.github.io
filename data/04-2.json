    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Ich plane mit meiner Freundin den Kunstpark zu besuchen.",
          "start": 146.44,
          "end": 151.44
        },
        {
          "text": "Bei der Reise möchten wir diesen besonderen Themenpark mitnehmen.",
          "start": 154.3,
          "end": 158.46
        },
        {
          "text": "Im Winter vergnügen sich die Kinder im Park mit Schneeballwerfen.",
          "start": 161.5,
          "end": 165.86
        },
        {
          "text": "Die Deutschen nehmen gerne Sonnenbäder im Garten, auf Balkon oder Terrasse.",
          "start": 168.8,
          "end": 174.34
        },
        {
          "text": "Seine Tochter wippt auf einer Wippe.",
          "start": 177.68,
          "end": 181.14
        },
        {
          "text": "Auf der Bank saßen wir bequem beieinander.",
          "start": 183.38,
          "end": 186.74
        },
        {
          "text": "Das Kind schwingt sich auf der Schaukel hin und her.",
          "start": 189.86,
          "end": 193.62
        },
        {
          "text": "Die hohen Bäume spenden genug Schatten.",
          "start": 196.58,
          "end": 199.48
        },
        {
          "text": "Man darf keine Blumen im Park pflücken.",
          "start": 202.5,
          "end": 205.14
        },
        {
          "text": "Bitte betreten Sie den Rasen nicht.",
          "start": 208.22,
          "end": 210.5
        },
        {
          "text": "Er möchte alle Brücken hinter sich abbrechen und von vorn anfangen.",
          "start": 213.58,
          "end": 218.22
        },
        {
          "text": "Die Schüler sind mit einem Boot über den See gefahren.",
          "start": 221.2,
          "end": 224.78
        },
        {
          "text": "Auf dem Hinweisschild steht Schwimmen verboten.",
          "start": 226.99,
          "end": 231.49
        }
      ]
    }
