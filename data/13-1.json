    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Zu den fünf Sinnen zählen der Sehsin, der Hörsin, der Tastsin sowie der Geruchssin und der Geschmackssin.",
          "start": 136.33,
          "end": 145.59
        },
        {
          "text": "Der Vorschlag lässt sich hören.",
          "start": 148.31,
          "end": 150.45
        },
        {
          "text": "Sie ist nicht böse wegen dem Lärm vor ihrer Wohnung.",
          "start": 153.55,
          "end": 156.85
        },
        {
          "text": "Nicht jeder hat Lust, Lobeshymnen zu lauschen.",
          "start": 159.95,
          "end": 163.75
        },
        {
          "text": "Stellen Sie bitte den Fernseher leiser, es ist zu laut.",
          "start": 166.18,
          "end": 169.88
        },
        {
          "text": "Es ist zu spät, die Kinder sollen zur Ruhe gehen und ich möchte auch in Ruhe bleiben.",
          "start": 172.92,
          "end": 178.14
        },
        {
          "text": "Ich habe vor kurzem einen zehnjährigen Jungen kennengelernt, der taub zur Welt kam.",
          "start": 181.32,
          "end": 186.74
        },
        {
          "text": "Nachdem man seinen Geruchssin gezielt trainiert hat, kann man mehrere tausend Gerüche unterscheiden.",
          "start": 189.79,
          "end": 196.55
        },
        {
          "text": "Hier duftet es nach Rosen.",
          "start": 199.56,
          "end": 201.38
        },
        {
          "text": "Das Brot riecht dumpf.",
          "start": 204.4,
          "end": 206.62
        },
        {
          "text": "Geld stinkt nicht.",
          "start": 209.05,
          "end": 211.01
        },
        {
          "text": "Die Geschmäcker sind verschieden.",
          "start": 213.96,
          "end": 216.28
        },
        {
          "text": "Die Suppe schmeckt scheußlich.",
          "start": 218.87,
          "end": 220.83
        },
        {
          "text": "Der Koch verfeinerte den Geschmack dieser Speise.",
          "start": 223.85,
          "end": 227.35
        },
        {
          "text": "Hans ist ein blind geborenes Kind.",
          "start": 230.26,
          "end": 232.48
        },
        {
          "text": "Ich bin hochgradig kurzsichtig.",
          "start": 235.49,
          "end": 238.03
        },
        {
          "text": "Dich juckt wohl das Fell?",
          "start": 241.08,
          "end": 242.64
        },
        {
          "text": "Rauerstoff juckt meine Haut.",
          "start": 245.94,
          "end": 247.86
        },
        {
          "text": "Ich taste mich durch einen dunklen Gang.",
          "start": 250.93,
          "end": 253.41
        }
      ]
    }
