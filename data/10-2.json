    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Kirche hat im vierten Jahrhundert festgelegt, dass Ostern den ersten Sonntag nach dem ersten Vollmond nach Frühlingsanfang fällt.",
          "start": 129.53,
          "end": 138.59
        },
        {
          "text": "Am Aschermittwoch beginnt die Fastenzeit.",
          "start": 141.66,
          "end": 144.68
        },
        {
          "text": "An Gründanastag wird an das letzte Mal Jesu mit seinen Jüngern vor seiner Verhaftung erinnert.",
          "start": 147.53,
          "end": 154.38
        },
        {
          "text": "Am Ostersonntag wird die Auferweckung Jesu von den Toten gefeiert.",
          "start": 157.4,
          "end": 162.6
        },
        {
          "text": "An Pfingsten wird die Ausgießung des Heiligen Geistes gefeiert.",
          "start": 165.69,
          "end": 170.13
        },
        {
          "text": "Das klassische Osterei schenkte man traditionell am Ostermorgen als Zeichen der Auferstehung.",
          "start": 173.26,
          "end": 180.04
        },
        {
          "text": "Eierschale besteht hauptsächlich aus Kalk.",
          "start": 183.02,
          "end": 186.66
        },
        {
          "text": "Der Osterhase gilt als Überbringer der Ostereier.",
          "start": 189.65,
          "end": 193.53
        },
        {
          "text": "Beim Abendmahl kommen Christinnen und Christen zusammen und teilen miteinander Brot und Wein.",
          "start": 196.47,
          "end": 203.05
        },
        {
          "text": "Das Kreuz ist eines der Hauptsinnzeichen des Christentums.",
          "start": 206.11,
          "end": 210.43
        },
        {
          "text": "Im römischen Reich wurden die Kreuzigungen nur bei schweren Verbrechen oder an Nichtrömern und Sklaven angewandt.",
          "start": 213.49,
          "end": 221.35
        }
      ]
    }
