    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Frosch quakt Kröten leben oft in feuchten Gebieten.",
          "start": 129.78,
          "end": 138.23
        },
        {
          "text": "Der Salamander kann dem Mythos nach im Feuer wohnen.",
          "start": 140.83,
          "end": 145.27
        },
        {
          "text": "Wie ein Chamäleon passt er sich dem jeweiligen Umfeld an.",
          "start": 147.79,
          "end": 151.87
        },
        {
          "text": "Die meisten Gekkonen sind ausgesprochen nachtaktiv.",
          "start": 154.9,
          "end": 159.4
        },
        {
          "text": "Schildkröten können Farben besser differenzieren als Menschen.",
          "start": 162.52,
          "end": 166.86
        },
        {
          "text": "Da Fleisch und Eier von Tabaskoschildkröte hohe Preise erzielen, wird sie überjagt.",
          "start": 169.68,
          "end": 177.11
        },
        {
          "text": "Zierschildkröten bevorzugen langsam fließende, flache Gewässer mit weichem, schlammigem Grund und starker Vegetation.",
          "start": 180.66,
          "end": 189.46
        },
        {
          "text": "Königskobra ist die größte Giftschlange der Welt.",
          "start": 192.54,
          "end": 196.34
        },
        {
          "text": "Der Python hat die Haut abgestreift.",
          "start": 199.34,
          "end": 202.26
        },
        {
          "text": "Die Schlange kriecht über den Boden.",
          "start": 205.2,
          "end": 207.62
        },
        {
          "text": "Alle Krokodile sind vor allem Fleischfresser.",
          "start": 209.96,
          "end": 213.88
        },
        {
          "text": "Ein Spaziergänger hat am Dienstagabend ein junges Krokodil am See gesehen.",
          "start": 217.1,
          "end": 222.16
        },
        {
          "text": "Varane entsprechen in ihrem Äußeren der Grundform einer Echse mit vier Beinen und einem Schwanz.",
          "start": 225.62,
          "end": 232.4
        },
        {
          "text": "Der Winterschläfer verwandelt sich in Hibernation von einem gleich warmen Tier in ein wechselwarmes Tier.",
          "start": 235.44,
          "end": 243.1
        }
      ]
    }
