    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Berliner Pfannkuchen, kurz Berliner oder auch nur Pfannkuchen, ist ein etwa faustgroßes Gebäck.",
          "start": 121.36,
          "end": 130.34
        },
        {
          "text": "Heute werden Brötchen auch im Handwerk mit Unterstützung von Maschinen überwiegend halbautomatisch gefertigt.",
          "start": 132.99,
          "end": 140.73
        },
        {
          "text": "Croissant gehört heute zu den klassischen Bestandteilen eines französischen Frühstücks.",
          "start": 143.1,
          "end": 149.8
        },
        {
          "text": "Roggenbrot schmeckt sauer.",
          "start": 152.88,
          "end": 155.24
        },
        {
          "text": "Toastbrot ist in der Regel auch nach Ablauf des Mindesthaltbarkeitsdatum genießbar.",
          "start": 158.18,
          "end": 164.08
        },
        {
          "text": "Die Fülle von Apfelstrudel besteht üblicherweise aus süß-sauren Äpfeln, Rosinen und Semmelbröseln, Zimt und Kristallzucker.",
          "start": 167.07,
          "end": 176.97
        },
        {
          "text": "Mondkuchen ist ein traditioneller Kuchen in Mittel- und Osteuropa.",
          "start": 179.3,
          "end": 184.32
        },
        {
          "text": "Schwarzwälder Kirschtorte ist heute die bekannteste und beliebteste Torte Deutschlands.",
          "start": 184.32,
          "end": 193.88
        },
        {
          "text": "Blauschimmelkäse ist Schimmelkäse, bei dessen Herstellung blau-grünlich erscheinende Edelschimmelpilze eingesetzt werden.",
          "start": 193.88,
          "end": 206.51
        },
        {
          "text": "Gouda ist eine Art von Schnittkäse.",
          "start": 206.51,
          "end": 212.08
        },
        {
          "text": "Aus 100 Liter Milch werde nur 8 bis 9 kg Sauermilchkäse.",
          "start": 212.08,
          "end": 220.28
        },
        {
          "text": "Ihr Wassergehalt in dem fettfreien Weichkäse liegt bei über 67%.",
          "start": 220.28,
          "end": 229.56
        },
        {
          "text": "Zum Frühstück hat sie zwei Scheiben Brot mit Butter und Marmelade gegessen.",
          "start": 229.56,
          "end": 238.47
        }
      ]
    }
