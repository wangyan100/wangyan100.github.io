    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Arzt verordnet dem Patienten ein Medikament.",
          "start": 144.72,
          "end": 149.02
        },
        {
          "text": "Der Arzt diagnostizierte die Krankheit als Lungenentzündung.",
          "start": 152.04,
          "end": 156.56
        },
        {
          "text": "Der Arzt hat ihm die Tabletten gegen Kopfschmerzen verschrieben.",
          "start": 159.48,
          "end": 163.18
        },
        {
          "text": "Er hat hier einen guten Ruf als Hausarzt.",
          "start": 166.22,
          "end": 169.34
        },
        {
          "text": "Zu den Aufgaben des Internisten zählt die Prävention, Diagnose und Behandlung von Erkrankungen.",
          "start": 171.64,
          "end": 179.92
        },
        {
          "text": "Schwindelanfall ist ein Symptom von Unterernährung.",
          "start": 183.18,
          "end": 187.02
        },
        {
          "text": "Er hat eine Allergie gegen Blütenstaub.",
          "start": 189.89,
          "end": 193.47
        },
        {
          "text": "Sie hat Erbrechen und Durchfall.",
          "start": 195.98,
          "end": 198.5
        },
        {
          "text": "Das Fieber fällt.",
          "start": 201.54,
          "end": 202.76
        },
        {
          "text": "Das Fieber steigt.",
          "start": 203.86,
          "end": 205.22
        },
        {
          "text": "Das Kind hat sich wieder eine Grippe eingefangen.",
          "start": 208.29,
          "end": 211.09
        },
        {
          "text": "Ich hörte gequältes Stöhnen und Husten.",
          "start": 213.36,
          "end": 217.76
        },
        {
          "text": "Krebs ruft im frühen Stadium in der Regel keine Beschwerden hervor.",
          "start": 220.48,
          "end": 225.16
        },
        {
          "text": "Wo hast du Schmerzen?",
          "start": 228.24,
          "end": 229.7
        },
        {
          "text": "Ihr Puls war nicht mehr fühlbar.",
          "start": 232.76,
          "end": 235.14
        },
        {
          "text": "Apotheken dürfen starke Beruhigungsmittel nur gegen Rezept verkaufen.",
          "start": 238.02,
          "end": 243.08
        },
        {
          "text": "Sie trägt die Salbe auf ihre Wunde auf.",
          "start": 246.21,
          "end": 249.03
        }
      ]
    }
