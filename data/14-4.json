    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Ich nahm meine Brieftasche aus der Innentasche und zog 500 Markscheine heraus.",
          "start": 135.9,
          "end": 141.88
        },
        {
          "text": "Im Bus stahl ein Dieb einem Mann den Geldbeutel.",
          "start": 145.01,
          "end": 149.15
        },
        {
          "text": "Lukas zog sein Portemonnaie aus der Tasche und bezahlte 10 Euro.",
          "start": 151.76,
          "end": 156.26
        },
        {
          "text": "Von jedem verkauften Schlüsselanhänger auf dem Weihnachtsmarkt wird 1 Euro gespendet.",
          "start": 159.51,
          "end": 165.99
        },
        {
          "text": "Lange Haarnadeln werden noch mit Vorliebe in Japan, China und Indien getragen.",
          "start": 168.32,
          "end": 174.76
        },
        {
          "text": "Haarspangen sind oft aus Kunststoff und Metall verarbeitet.",
          "start": 177.98,
          "end": 182.7
        },
        {
          "text": "Perücken wurden schon im alten Ägypten von Männern und Frauen gleichermaßen getragen.",
          "start": 185.35,
          "end": 190.79
        },
        {
          "text": "Eine Schleife hält ihr Haar zusammen.",
          "start": 194.02,
          "end": 196.42
        },
        {
          "text": "Im alten Griechenland Rom und im Bizanz kam der Brosche eine doppelte Funktion zu.",
          "start": 199.46,
          "end": 205.84
        },
        {
          "text": "Sie wurde sowohl als Gewandschließe als auch als Schmuckstück verwendet.",
          "start": 205.84,
          "end": 211.6
        },
        {
          "text": "In einem Ohr hatte einen Ohrring mit einem glitzernden Stein getragen.",
          "start": 214.59,
          "end": 219.53
        },
        {
          "text": "Früher glaubte man, dass das Pulver aus Diamanten tödlich sein kann.",
          "start": 222.49,
          "end": 227.21
        },
        {
          "text": "Die rote Koralle ist in allen warmen Meeren beheimatet.",
          "start": 230.2,
          "end": 234.62
        },
        {
          "text": "Aufgrund der hohen Nachfrage sind die Vorkommen aber bedrohlich geschrumpft.",
          "start": 234.9,
          "end": 240.84
        },
        {
          "text": "Sie erhielten neben dem traditionellen T-Shirt mit Logo auch eine Gürteltasche als Geschenk.",
          "start": 243.15,
          "end": 249.99
        }
      ]
    }
  ]
