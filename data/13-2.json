    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Ich werde mir die Sache mal ansehen.",
          "start": 137.6,
          "end": 140.1
        },
        {
          "text": "Als er aus der Dunkelheit ins grelle Sonnenlicht kam, musste er blinzeln.",
          "start": 143.07,
          "end": 148.03
        },
        {
          "text": "Einem geschenkten Gaul guckt man nicht ins Maul.",
          "start": 151.14,
          "end": 154.7
        },
        {
          "text": "Das Kind schielt.",
          "start": 157.2,
          "end": 158.56
        },
        {
          "text": "Er zwinkert nervös mit den Augen.",
          "start": 161.52,
          "end": 163.88
        },
        {
          "text": "Mir ist kalt und ich hüpfe von einem Bein auf das andere.",
          "start": 166.99,
          "end": 170.59
        },
        {
          "text": "Er ging auf den Bürgersteig, stolperte und fiel hin.",
          "start": 173.72,
          "end": 177.52
        },
        {
          "text": "Er ballt die Hand zur Faust.",
          "start": 179.88,
          "end": 183.28
        },
        {
          "text": "Sie griffen beide zugleich nach dem Buch.",
          "start": 185.88,
          "end": 188.54
        },
        {
          "text": "Er kniff mich in den Arm.",
          "start": 191.66,
          "end": 193.34
        },
        {
          "text": "Eine Frau hat meinen Arm gefasst, wenn ich an der Ecke vorbei gegangen bin.",
          "start": 196.47,
          "end": 201.25
        },
        {
          "text": "Sie strich mit der Hand über das Gesicht ihres Freundes.",
          "start": 204.26,
          "end": 208.16
        },
        {
          "text": "Meine Mutter winkt außer dem Bus zum Abschied.",
          "start": 211.0,
          "end": 214.22
        },
        {
          "text": "Der Schüler stößt während des Unterrichts auf.",
          "start": 217.21,
          "end": 220.39
        },
        {
          "text": "Wer gehend, sollte die Hand vor den Mund nehmen.",
          "start": 223.31,
          "end": 226.53
        },
        {
          "text": "Der Schluckauf geht meistens schnell vorüber.",
          "start": 229.62,
          "end": 232.5
        },
        {
          "text": "Das Kind kreischte den ganzen Vormittag über.",
          "start": 235.47,
          "end": 238.59
        }
      ]
    }
  ]
}
