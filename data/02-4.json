    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Gin ist Hauptbestandteil vieler Cocktails.",
          "start": 97.89,
          "end": 101.05
        },
        {
          "text": "Der Long Island Iced Tea wird in einem langen Long Drink Glas serviert und mit Minzblättern garniert.",
          "start": 104.19,
          "end": 112.07
        },
        {
          "text": "Als trockener, herber und stark alkoholischer Short Drink zählt der Martini zu den Aparitifs.",
          "start": 115.14,
          "end": 122.38
        },
        {
          "text": "Gut herum zeichnet sich im Gegensatz zu den meisten anderen Zuckerrohrbränden durch eine lange Reifung in Holzfässern aus.",
          "start": 125.59,
          "end": 134.91
        },
        {
          "text": "Der Old Cuban gilt als veredelte Short Drink Variante des beliebten Long Drink Klassikers Mojito.",
          "start": 137.94,
          "end": 146.34
        },
        {
          "text": "Der Geschmack des aus Kartoffel gewonnenen Vodkas ist gewöhnlich schwerer und süßlicher als der des aus Weizen destillierten Vodkas.",
          "start": 149.46,
          "end": 159.94
        },
        {
          "text": "Die Bloody Mary soll nach der englischen Königin Maria I.",
          "start": 162.18,
          "end": 167.92
        },
        {
          "text": "Tudor benannt worden sein.",
          "start": 168.08,
          "end": 169.94
        },
        {
          "text": "Der Moscow Mule ist ein Cocktail mit Ingwer-Geschmack und gehört zu den High Balls.",
          "start": 173.24,
          "end": 179.02
        },
        {
          "text": "Collins's waren bereits im 19.",
          "start": 179.02,
          "end": 183.966
        },
        {
          "text": "Jahrhundert in den Vereinigten Staaten sehr populär.",
          "start": 184.86,
          "end": 188.38
        },
        {
          "text": "Die Limettenscheibe ist eine übliche kleine Dekoration der Cocktails.",
          "start": 191.29,
          "end": 196.03
        }
      ]
    }
  ]
