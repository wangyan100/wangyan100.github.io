    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Karl-Marx-Allee in Berlin war ein Prachtboulevard mit luxuriösem Wohnraum, der in den 1950er Jahren errichtet worden war.",
          "start": 146.37,
          "end": 156.51
        },
        {
          "text": "Ab dem 1.",
          "start": 159.72,
          "end": 160.76
        },
        {
          "text": "Juli soll auf französischen Landstraßen das Tempolimit auf 80 kmh gesenkt werden.",
          "start": 160.98,
          "end": 167.26
        },
        {
          "text": "Fahren sollen die neuen Tretroller in der Regel auf Radwegen oder Fahrbahnen.",
          "start": 169.66,
          "end": 175.86
        },
        {
          "text": "Ein Autofahrer war am Freitagabend mit hoher Geschwindigkeit auf eine Gruppe Passanten auf einem Bürgersteig zugerast.",
          "start": 178.73,
          "end": 185.93
        },
        {
          "text": "Eine Fußgängerin hat in Rostock ein totes Baby auf einer Straße entdeckt.",
          "start": 189.51,
          "end": 194.57
        },
        {
          "text": "Bis zum 8.",
          "start": 197.54,
          "end": 198.46
        },
        {
          "text": "Lebensjahr dürfen Kinder mit ihrem Fahrrad auf dem Gehweg fahren.",
          "start": 198.78,
          "end": 202.8
        },
        {
          "text": "Bitte überqueren Sie nicht die Straße, wenn die Ampel noch rot ist.",
          "start": 205.04,
          "end": 210.42
        },
        {
          "text": "Der Parkplatz dient ausschließlich Kunden des Kaufhauses.",
          "start": 213.47,
          "end": 217.55
        },
        {
          "text": "Der Parkschein zeigt Ihnen, auf welchem Parkplatz Sie Ihren Pkw abgestellt haben, so wie das Datum und die Uhrzeit Ihres Parkbeginns.",
          "start": 220.55,
          "end": 229.59
        },
        {
          "text": "Wir sollen eine andere Straße nehmen, um Staus zu vermeiden.",
          "start": 233.16,
          "end": 237.3
        },
        {
          "text": "Mit seiner über 30-jährigen Erfahrung steuert der Busfahrer souverän durch das Verkehrschaos.",
          "start": 239.7,
          "end": 247.34
        }
      ]
    }
