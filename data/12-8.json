    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Für alkoholsüchtige Menschen besteht es ein starker Wunsch oder Zwang, Alkohol zu trinken.",
          "start": 127.92,
          "end": 135.42
        },
        {
          "text": "Familiengewalt betrifft nicht nur Frauen, sondern auch Männer.",
          "start": 138.46,
          "end": 142.36
        },
        {
          "text": "Er misshandelt seinen Sohn durch Körperstrafe.",
          "start": 145.54,
          "end": 148.6
        },
        {
          "text": "Fremdgehen ist zwar immer ein Betrug an einer Person, doch dahinter steckt nicht selten eine komplexere Geschichte.",
          "start": 151.84,
          "end": 159.34
        },
        {
          "text": "Jede Trennung der Eltern ist schlimm für ein Kind, ob die Eltern verheiratet waren oder nicht.",
          "start": 162.62,
          "end": 168.84
        },
        {
          "text": "Viele Eheleute glauben, die Trennung muss irgendwie aktenkundig gemacht werden.",
          "start": 172.05,
          "end": 177.37
        },
        {
          "text": "Beide Ehegatten halten ihre Ehe für gescheitert.",
          "start": 180.52,
          "end": 183.74
        },
        {
          "text": "Die dauernden Streitigkeiten haben ihre Ehe zerrüttet.",
          "start": 185.98,
          "end": 190.46
        },
        {
          "text": "Zu Beginn der 1990er Jahre sind mehr als 80% der Scheidungen innerhalb der ersten 15 Ehejahre vollzogen worden.",
          "start": 193.57,
          "end": 202.37
        },
        {
          "text": "Der Mann war zum Zeitpunkt der Ehe-Lösung bereits mehr als 80 Jahre alt.",
          "start": 202.37,
          "end": 210.81
        },
        {
          "text": "In Deutschland wurde die Mehrheit der Scheidungen von Frauen eingereicht.",
          "start": 210.81,
          "end": 218.0
        },
        {
          "text": "Ich bin der Meinung, dass bei einem einvernehmlichen Scheidungsverfahren die Scheidungskosten unangemessen hoch sind.",
          "start": 218.0,
          "end": 228.86
        },
        {
          "text": "Wegen der Wiederheirat wurde der katholische Chefarzt eines katholischen Krankenhauses entlassen.",
          "start": 228.86,
          "end": 237.89
        }
      ]
    }
