    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die deutsche Fußball-Nationalmannschaft hat die Finale der Weltmeisterschaft 2014 gewonnen.",
          "start": 141.05,
          "end": 149.19
        },
        {
          "text": "Der Abwehrspieler hat einen Spieler der gegnerischen Mannschaft umspielt.",
          "start": 152.05,
          "end": 156.83
        },
        {
          "text": "Der Außenstürmer hat ein Tor geköpft.",
          "start": 159.84,
          "end": 162.94
        },
        {
          "text": "Beim Fußballspiel dürfen maximal drei Ersatzspieler eingewechselt werden.",
          "start": 165.55,
          "end": 171.27
        },
        {
          "text": "Der Mittelstürmer hat zwei Treffer markiert.",
          "start": 174.35,
          "end": 177.59
        },
        {
          "text": "Der Stürmer sorgt im Feld für die Tore.",
          "start": 180.55,
          "end": 183.55
        },
        {
          "text": "Der Stürmer stand schon wieder im Abseits.",
          "start": 186.53,
          "end": 189.29
        },
        {
          "text": "Eine Fußballmannschaft besteht aus zehn Feldspielern und einem Torwart.",
          "start": 192.32,
          "end": 197.44
        },
        {
          "text": "Der Verteidiger passt den Ball zu Außenstürmer.",
          "start": 200.51,
          "end": 203.71
        },
        {
          "text": "Der Freistoß fliegt in den Strafraum.",
          "start": 207.23,
          "end": 210.15
        },
        {
          "text": "Der Spieler verschießt den Elfmeter und seine Mannschaft verliert deshalb das Spiel.",
          "start": 213.19,
          "end": 218.75
        },
        {
          "text": "Er verwandelte den Elfmeter zum 1 zu 0.",
          "start": 221.86,
          "end": 225.28
        },
        {
          "text": "Er hat mich absichtlich auf den Fuß getreten.",
          "start": 228.31,
          "end": 231.19
        },
        {
          "text": "Nach Auslosung war der Bundestrainer Löw zuversichtlich.",
          "start": 234.24,
          "end": 238.1
        },
        {
          "text": "Die beiden Mannschaften trennen sich unentschieden.",
          "start": 241.14,
          "end": 244.62
        },
        {
          "text": "Sein Debüt als Torwart war ein großer Erfolg.",
          "start": 247.41,
          "end": 250.43
        }
      ]
    }
