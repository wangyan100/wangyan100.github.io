    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Aktiengesellschaft AG ist die übliche Gesellschaftsform für börsennotierte Firmen.",
          "start": 147.46,
          "end": 155.72
        },
        {
          "text": "Der Professor kommt mit seinem Assistenten in das Zimmer, der sein Buch und Laptop trägt.",
          "start": 158.1,
          "end": 164.62
        },
        {
          "text": "Meine Mutter arbeitet in der Buchhaltung.",
          "start": 167.22,
          "end": 169.96
        },
        {
          "text": "Die Personalabteilung lässt mich als Sekretär anmelden.",
          "start": 172.9,
          "end": 176.98
        },
        {
          "text": "Wir müssen uns mal treffen und das näher besprechen.",
          "start": 179.97,
          "end": 183.07
        },
        {
          "text": "Man kann am Wochenende oder nach Feierabend in den Park gehen.",
          "start": 186.07,
          "end": 190.67
        },
        {
          "text": "Alles hat sich sinnvoll geordnet.",
          "start": 193.53,
          "end": 196.37
        },
        {
          "text": "Anbei schicke ich Ihnen das Protokoll.",
          "start": 199.18,
          "end": 201.84
        },
        {
          "text": "Für weitere Rückfragen stehe ich Ihnen zur Verfügung.",
          "start": 204.64,
          "end": 208.22
        },
        {
          "text": "Der Mann bemüht sich täglich um einen Arbeitsplatz.",
          "start": 211.34,
          "end": 214.56
        },
        {
          "text": "Seine Arbeit ist zu stressig.",
          "start": 217.8,
          "end": 220.04
        },
        {
          "text": "Um mehr Geld zu verdienen, macht er jeden Abend Überstunden.",
          "start": 222.97,
          "end": 227.33
        }
      ]
    }
