    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Chinakohl stammt ursprünglich aus China.",
          "start": 126.94,
          "end": 131.44
        },
        {
          "text": "Seit der Steinzeit nutzen Menschen den Feldsalat als Nahrungspflanze.",
          "start": 134.62,
          "end": 140.62
        },
        {
          "text": "Spinat dient zur Behandlung von Nierensteinen.",
          "start": 143.11,
          "end": 147.37
        },
        {
          "text": "Der alte Ingwer ist der schärfste.",
          "start": 150.32,
          "end": 152.88
        },
        {
          "text": "Knoblauch diente den ägyptischen Sklaven für den Pyramidenbau als wichtige Nahrung.",
          "start": 155.98,
          "end": 162.4
        },
        {
          "text": "Das Speicherorgan des Spargels liegt unter der Erde.",
          "start": 165.46,
          "end": 169.46
        },
        {
          "text": "Im alten Ägypten war die Zwiebel ein Symbol für das ewige Leben.",
          "start": 172.63,
          "end": 177.47
        },
        {
          "text": "Die dümmsten Bauern ernten die dicksten Kartoffeln.",
          "start": 179.74,
          "end": 183.92
        },
        {
          "text": "Nach den Tomaten kommen Karotten an zweiter Stelle auf der Gemüse-Beliebtheitsskala in Deutschland.",
          "start": 187.29,
          "end": 194.85
        },
        {
          "text": "Brokkoli kann man sowohl roh als auch gegart genießen.",
          "start": 198.1,
          "end": 202.38
        },
        {
          "text": "Auberginen werden meist gegrillt, gebraten, gedünstet oder geschmort.",
          "start": 205.54,
          "end": 211.76
        },
        {
          "text": "Bitter schmeckende Kürbisse sind giftig und sollen nicht verzehrt werden.",
          "start": 214.83,
          "end": 219.83
        },
        {
          "text": "Sie hat ein Pfund Paprika gekauft.",
          "start": 222.93,
          "end": 225.69
        }
      ]
    }
