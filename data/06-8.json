    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Spieler kann sich durch Anlauf bewegen, um ihren Wurf des Bowlings durchzuführen.",
          "start": 140.54,
          "end": 146.1
        },
        {
          "text": "Er stellt sofort das umgestoßene Glas wieder auf.",
          "start": 149.2,
          "end": 152.74
        },
        {
          "text": "Sie erhielt im dritten Durchgang die höchste Bewertung.",
          "start": 155.8,
          "end": 159.4
        },
        {
          "text": "Er wirft alle Kegel auf einen Schub um.",
          "start": 162.34,
          "end": 165.26
        },
        {
          "text": "Er ist ein Ass im Boxen.",
          "start": 168.2,
          "end": 170.05
        },
        {
          "text": "Budo ist der Oberbegriff für alle japanischen Kampfkünste, darunter auch Judo.",
          "start": 172.32,
          "end": 179.44
        },
        {
          "text": "Die drei Silben von dem Namen Taekwondo bedeuten jeweils Fußtechnik, Handtechnik und Weg.",
          "start": 182.51,
          "end": 191.01
        },
        {
          "text": "Diskuswerfen, Hochspringen und Kugelstoßen sind Disziplinen der Leichtathletik.",
          "start": 194.3,
          "end": 200.92
        },
        {
          "text": "Der Marathonlauf ist die längste Laufdisziplin in der Leichtathletik.",
          "start": 203.23,
          "end": 209.23
        },
        {
          "text": "Leichtathletik ist, abgesehen vom Staffellauf, ein Einzelsport.",
          "start": 211.81,
          "end": 216.43
        },
        {
          "text": "Der Barren zählt zu den Geräten, die beim Kunstturnen nur von den Männern eingesetzt werden.",
          "start": 219.51,
          "end": 226.13
        },
        {
          "text": "Stufenbarren gehört zu den Disziplinen für Kunstturnen der Frauen.",
          "start": 229.72,
          "end": 234.26
        },
        {
          "text": "Rue Venard gewann bei den Olympischen Sommerspielen 2008 Goldmedaille im Trampolin.",
          "start": 236.76,
          "end": 244.94
        },
        {
          "text": "Beim Golf spricht man auch über das Geschäft.",
          "start": 247.66,
          "end": 250.44
        },
        {
          "text": "Viele Golfspieler vernachlässigen bei ihrem Training das so wichtige Patten.",
          "start": 253.71,
          "end": 258.89
        }
      ]
    }
