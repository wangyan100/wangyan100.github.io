    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Addition, Subtraktion, Multiplikation und Division sind die vier Grundrechnungsarten Bei der Addition kommt eine hohe Summe heraus.",
          "start": 134.96,
          "end": 149.4
        },
        {
          "text": "Die Addition ist die wichtigste Grundrechenart, denn auf alle mathematischen Operationen bauen auf ihr auf.",
          "start": 152.47,
          "end": 159.75
        },
        {
          "text": "Will man zwei Zahlen addieren, schreibt man dazwischen ein Pluszeichen. 1 plus 1 ist 2.",
          "start": 162.73,
          "end": 173.08
        },
        {
          "text": "Subtrahiert man 58 von 120, erhält man 62.",
          "start": 176.14,
          "end": 181.4
        },
        {
          "text": "Bei der Subtraktion wird eine Zahl von der anderen abgezogen.",
          "start": 184.24,
          "end": 188.9
        },
        {
          "text": "Die Division ist nicht glatt aufgegangen.",
          "start": 192.02,
          "end": 194.82
        },
        {
          "text": "Die beiden Operanden werden in Subtraktion Minuend und Subtrahend genannt.",
          "start": 197.8,
          "end": 203.7
        },
        {
          "text": "Das Ergebnis heißt Differenzwert.",
          "start": 204.06,
          "end": 206.9
        },
        {
          "text": "Wenn die Operanden natürliche oder ganze Zahlen sind, so ist das Ergebnis der Multiplikation ebenfalls wieder eine natürliche oder ganze Zahl.",
          "start": 210.02,
          "end": 221.3
        },
        {
          "text": "Wenn sowohl der Dividend, Divisor als auch der Wert des Quotienten eine ganze Zahl ist, nennt man den Divisor einen Teiler des Dividenden.",
          "start": 224.36,
          "end": 235.04
        },
        {
          "text": "Eine gerade Zahl heißt gerade, wenn sie ohne Rest durch 2 teilbar ist.",
          "start": 238.14,
          "end": 243.58
        },
        {
          "text": "Eine Primzahl ist eine natürliche Zahl.",
          "start": 246.63,
          "end": 249.53
        }
      ]
    }
