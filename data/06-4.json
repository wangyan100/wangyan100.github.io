    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Teams im Baseball erringen Punkte durch Ablaufen der Bases.",
          "start": 126.26,
          "end": 130.72
        },
        {
          "text": "Baseballspiel wird von zwei Mannschaften zu je neun Spielern gespielt.",
          "start": 134.43,
          "end": 139.21
        },
        {
          "text": "Der Ball berührte den Handschuh des Fängers.",
          "start": 142.4,
          "end": 145.14
        },
        {
          "text": "Ein Läufer kann jederzeit versuchen, die Base zu stehlen, auch wenn der Ball vom Schlagmann gar nicht geschlagen wurde.",
          "start": 148.15,
          "end": 156.85
        },
        {
          "text": "Schlagmänner und Läufer im Feld tragen Schlaghelme zum Schützen von Kopftreffern mit dem Ball.",
          "start": 160.19,
          "end": 166.71
        },
        {
          "text": "Der Schlagmann hat den Ball getroffen.",
          "start": 169.73,
          "end": 171.95
        },
        {
          "text": "Dieser Werfer hat zwei Strikes geworfen.",
          "start": 174.91,
          "end": 178.19
        },
        {
          "text": "Im Baseball ist die Homeplate die Endbase.",
          "start": 181.23,
          "end": 184.89
        },
        {
          "text": "Der Hauptschiedsrichter kann sich leicht entscheiden, ob der Ball in der Strikezone war oder nicht.",
          "start": 187.9,
          "end": 194.62
        },
        {
          "text": "Das Spielfeld besteht aus zwei Teilen und wird durch eine Umzäunung begrenzt.",
          "start": 197.67,
          "end": 203.39
        },
        {
          "text": "Ein Homerun zählt als Hit.",
          "start": 206.26,
          "end": 208.6
        },
        {
          "text": "Ein Baseballspiel besteht im Regelfall aus neun Innings.",
          "start": 211.65,
          "end": 215.69
        },
        {
          "text": "Der Fanghandschuh des First Basemans ist etwas größer als jene der anderen.",
          "start": 218.47,
          "end": 224.42
        },
        {
          "text": "Der Schiedsrichter zeigte einen Strikeout durch eine Handbewegung an.",
          "start": 227.55,
          "end": 232.67
        },
        {
          "text": "Die Heimmannschaft hat schnell den ersten Run erzielt.",
          "start": 235.6,
          "end": 239.24
        },
        {
          "text": "Der Schuss verfehlte sein Ziel.",
          "start": 242.27,
          "end": 244.41
        }
      ]
    }
