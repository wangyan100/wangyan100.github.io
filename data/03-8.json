    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "In der Warmmiete sind die Kosten für Strom, Gas und Wasser einbezogen.",
          "start": 143.33,
          "end": 149.43
        },
        {
          "text": "In Deutschland werden normalerweise drei Monatsmieten als Kaution verlangt.",
          "start": 152.52,
          "end": 158.18
        },
        {
          "text": "Der Mieter hat sein Zimmer an eine Frau untervermietet.",
          "start": 161.06,
          "end": 164.88
        },
        {
          "text": "Soll ich auf dem Mietvertrag unterschreiben?",
          "start": 167.83,
          "end": 170.74
        },
        {
          "text": "Ich möchte ein Zimmer möbliert mieten.",
          "start": 173.9,
          "end": 176.96
        },
        {
          "text": "Nach dem Studium bin ich von Berlin nach Heidelberg umgezogen.",
          "start": 179.94,
          "end": 184.18
        },
        {
          "text": "Wenn ich durch das Wohnviertel fahre, sehe ich viele leerstehende Apartments.",
          "start": 187.26,
          "end": 192.72
        },
        {
          "text": "Um Geld zu sparen, suchen viele Studenten die Wohnungen im Wohnheim.",
          "start": 195.82,
          "end": 201.28
        },
        {
          "text": "Schloss Neuschwanstein ist sehenswert.",
          "start": 204.44,
          "end": 207.38
        },
        {
          "text": "Hier lasst uns Hütten bauen.",
          "start": 209.81,
          "end": 212.45
        },
        {
          "text": "Der Kaiserpalast befindet sich im Zentrum Pekings.",
          "start": 215.71,
          "end": 219.45
        },
        {
          "text": "Das Brandenburger Tor ist das Symbol für Deutschland.",
          "start": 222.62,
          "end": 226.22
        },
        {
          "text": "Der Sturm rappelte an den Fensterläden und das Kind weinte vor Angst.",
          "start": 229.4,
          "end": 234.4
        }
      ]
    }
