    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Startaufstellung der Feldspieler besteht aus einem Center, zwei Forwards und zwei Guards.",
          "start": 130.23,
          "end": 137.11
        },
        {
          "text": "Der Center ist meist der größte und körperlich stärkste Spieler einer Mannschaft.",
          "start": 139.32,
          "end": 145.52
        },
        {
          "text": "Der Guard gibt den Ball zum Power Forward ab.",
          "start": 148.92,
          "end": 152.6
        },
        {
          "text": "Der Ball hat die Auslinie überschritten.",
          "start": 155.58,
          "end": 157.8
        },
        {
          "text": "Immer wenn Nowitzki zum Korbwurf ansetzte, erhoben sich die Fans von ihren Sitzen.",
          "start": 161.16,
          "end": 167.22
        },
        {
          "text": "Der Schiedsrichter stellt wegen Faul den Feldspieler vom Platz.",
          "start": 170.22,
          "end": 174.48
        },
        {
          "text": "Der Ballführende Spieler begeht ein Faul durch rempeln.",
          "start": 174.48,
          "end": 181.61
        },
        {
          "text": "In der zweiten Halbzeit hat die Mannschaft noch einmal aufgedreht.",
          "start": 184.61,
          "end": 189.19
        },
        {
          "text": "Der Treffer in den Korb zählt nach Entfernung 2 oder 3 Punkte.",
          "start": 191.62,
          "end": 196.26
        },
        {
          "text": "Ein Basketballspiel besteht aus Vierteln und jedes Viertel hat eine Dauer von 10 Minuten.",
          "start": 199.32,
          "end": 205.8
        },
        {
          "text": "Gute Verteidiger können den Angreifer schnell abdrängen.",
          "start": 208.86,
          "end": 212.88
        },
        {
          "text": "Dieser Spieler kann 2 Meter hoch springen.",
          "start": 215.16,
          "end": 219.16
        },
        {
          "text": "Der 40 Jahre alte Profi kündigte nach dem letzten Heimspiel an, seine Karriere zu beenden.",
          "start": 221.82,
          "end": 228.82
        },
        {
          "text": "Einen Heimvorteil haben Mannschaften an die örtlichen Gegebenheiten besser angepasst zu sein als der Gegner.",
          "start": 232.0,
          "end": 239.68
        }
      ]
    }
