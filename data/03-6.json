    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Möchtest du den Aufzug nehmen oder die Treppe?",
          "start": 125.18,
          "end": 128.48
        },
        {
          "text": "Ein Gartenzwerg wird verwendet, um Gärten auszustatten und Wohnraum zu dekorieren.",
          "start": 131.61,
          "end": 137.49
        },
        {
          "text": "Und völlig verwirrt hatte der kleine Prinz eine Gießkanne mit frischem Wasser geholt und die Blumen begossen.",
          "start": 139.8,
          "end": 148.14
        },
        {
          "text": "Der kleine Prinz Mit einem Schlauch bewässert man große Grünflächen in Parks.",
          "start": 148.88,
          "end": 157.58
        },
        {
          "text": "Laut Polizei brach ein Mann mit seinem Auto durch den Zaun, als das Paar in der Küche kochte.",
          "start": 160.76,
          "end": 167.74
        },
        {
          "text": "Die Antenne wurde auf dem Dach angebracht.",
          "start": 170.96,
          "end": 173.76
        },
        {
          "text": "Die Bauarbeiter decken ein Dach mit Ziegeln.",
          "start": 176.13,
          "end": 180.23
        },
        {
          "text": "Er hat seine Frau angeherrscht, das Dachzimmer sofort zu verlassen.",
          "start": 183.36,
          "end": 188.32
        },
        {
          "text": "Er ist endlich die Leiter des Erfolgs emporgestiegen.",
          "start": 191.45,
          "end": 195.17
        },
        {
          "text": "Der Schornstein raucht wieder.",
          "start": 198.3,
          "end": 200.22
        },
        {
          "text": "Wir können eine Kaffeepause auf der Terrasse machen.",
          "start": 203.32,
          "end": 206.6
        },
        {
          "text": "Mein Freund hat ein gebrauchtes Auto gekauft.",
          "start": 209.92,
          "end": 213.02
        },
        {
          "text": "Vielen Dank für's Zuschauen.",
          "start": 213.02,
          "end": 213.1
        }
      ]
    }
