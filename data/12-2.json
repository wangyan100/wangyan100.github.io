    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Er traute sich nicht, seine Ex-Freundin wieder anzusprechen.",
          "start": 137.14,
          "end": 141.38
        },
        {
          "text": "Sie sieht ihren Freund voller Zärtlichkeit an.",
          "start": 144.45,
          "end": 148.11
        },
        {
          "text": "Nachts traf er sich immer mit seiner Geliebten.",
          "start": 150.89,
          "end": 153.95
        },
        {
          "text": "Transgeschlechtlichkeit ist unabhängig von sexueller Orientierung.",
          "start": 157.33,
          "end": 161.75
        },
        {
          "text": "Prinzipiell ist jeder Mensch bisexuell veranlagt.",
          "start": 164.08,
          "end": 168.08
        },
        {
          "text": "Sind zwei Mädchen oder zwei Junge ein Paar, sind sie homosexuell.",
          "start": 171.58,
          "end": 176.36
        },
        {
          "text": "Homosexuelle Mädchen werden als junge Lesben bezeichnet.",
          "start": 179.51,
          "end": 183.85
        },
        {
          "text": "Dieser Ehevermittler möchte diese junge Frau mit einem älteren Mann verkuppeln.",
          "start": 186.96,
          "end": 191.88
        },
        {
          "text": "In den meisten Ländern Europas ist Heiratsvermittlung heute meist eine kommerzielle Dienstleistung.",
          "start": 194.88,
          "end": 201.78
        },
        {
          "text": "Wir sind zusammen, seit wir 17 sind.",
          "start": 204.05,
          "end": 208.01
        },
        {
          "text": "Die Mutter fasste ihr Kind an und ging über die Straße.",
          "start": 211.07,
          "end": 214.33
        },
        {
          "text": "Das Liebespaar kuschelt zusammen.",
          "start": 217.67,
          "end": 219.83
        },
        {
          "text": "Sie hauchte ihm einen Luftkuss zu.",
          "start": 222.94,
          "end": 225.72
        },
        {
          "text": "Nach der Trennung von seiner Freundin ist es ihm lange Zeit ziemlich schlecht gegangen.",
          "start": 228.92,
          "end": 234.44
        },
        {
          "text": "Wir sind schon lange auseinander.",
          "start": 237.61,
          "end": 239.47
        }
      ]
