    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "In der Werbungssprache werden Mountainbikes öfter als Geländefahrräder verwendet.",
          "start": 137.23,
          "end": 143.13
        },
        {
          "text": "Beim Radfahren kann man mit dem Lenker die Richtung bestimmen.",
          "start": 145.5,
          "end": 149.8
        },
        {
          "text": "Eines der Pedale meines Fahrrads ist kaputt und muss repariert werden.",
          "start": 152.46,
          "end": 157.18
        },
        {
          "text": "Laut einer großen Umfrage fühlen sich Radfahrer in Deutschland beim Fahren immer unsicherer.",
          "start": 160.32,
          "end": 166.82
        },
        {
          "text": "Ein Führerschein ist zum Autofahren erforderlich.",
          "start": 169.83,
          "end": 173.01
        },
        {
          "text": "Die Feuerwehr nutzte ein Leitergerüst und einen Flaschenzug, um den Mann auf einer Krankentrage nach unten zu bringen.",
          "start": 175.98,
          "end": 183.8
        },
        {
          "text": "In dem Erste-Hilfe-Kurs lernt man, wie man mit Notfällen umgeht.",
          "start": 186.69,
          "end": 191.46
        },
        {
          "text": "Die Raumfahrtbehörde wird nächsten Monat eine Rakete starten.",
          "start": 194.56,
          "end": 198.86
        },
        {
          "text": "Die Raumfahrer befinden sich in einem schwere, losen Zustand.",
          "start": 201.8,
          "end": 205.84
        },
        {
          "text": "Der Schlepper hat am Montag den im Boden gebliebenen Fischdampfer in tiefes Wasser gezogen.",
          "start": 208.85,
          "end": 215.11
        },
        {
          "text": "Er pumpt sein Schlauchboot auf, setzt sich hinein und rudert los.",
          "start": 218.17,
          "end": 222.91
        }
      ]
    }
