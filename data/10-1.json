    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Weihnachten ist ein wichtiges christliches Fest und Christen feiern die Geburt Jesu Christi.",
          "start": 126.33,
          "end": 132.69
        },
        {
          "text": "In Dortmund erstrahlt auf dem Weihnachtsmarkt der weltgrößte Weihnachtsbaum.",
          "start": 135.54,
          "end": 140.96
        },
        {
          "text": "Während Weihnachten schmücken Lichterketten, Lametta, Adventskranz und Christbaum die Häuser.",
          "start": 143.92,
          "end": 149.88
        },
        {
          "text": "Der Weihnachtsmann fährt Jahr für Jahr mit seinem Schlitten durch die Dörfer und Städte.",
          "start": 152.08,
          "end": 158.4
        },
        {
          "text": "Aufgrund seiner roten Nase wird Rudolf jedoch von den anderen Rentieren verspottet.",
          "start": 160.75,
          "end": 166.15
        },
        {
          "text": "Die Wunschzettel sind gelesen, die Geschenke verpackt.",
          "start": 169.13,
          "end": 172.45
        },
        {
          "text": "Der Weihnachtsmann hat sich auf den Weg gemacht.",
          "start": 172.79,
          "end": 175.29
        },
        {
          "text": "Im Kamin brennt ein herrliches Feuer.",
          "start": 178.35,
          "end": 180.61
        },
        {
          "text": "Der 24.",
          "start": 183.66,
          "end": 184.7
        },
        {
          "text": "Dezember wird in Deutschland Heiligabend genannt und in vielen Familien findet an diesem Abend die Bescherung statt.",
          "start": 184.94,
          "end": 192.28
        },
        {
          "text": "Im Krippenspiel wird die Weihnachtsgeschichte dargestellt, die von der Geburt Jesu handelt.",
          "start": 195.28,
          "end": 200.74
        },
        {
          "text": "Im bekannten Weihnachtslied Morgen kommt der Weihnachtsmann lauten die ersten beiden Zeilen Morgen kommt der Weihnachtsmann, kommt mit seinen Gaben.",
          "start": 203.68,
          "end": 214.3
        },
        {
          "text": "Auf dem Weihnachtsmarkt gibt es Glühwein, Lebkuchen und andere Süßigkeiten ohne Ende.",
          "start": 216.76,
          "end": 222.82
        },
        {
          "text": "Je nach Region werden unterschiedliche Weine für Glühwein verwendet.",
          "start": 225.03,
          "end": 230.07
        }
      ]
    }
  ]
