    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Fahrt beschleunigte sich und bei Morgengrauen lief der Zug in den Hauptbahnhof von Berlin ein.",
          "start": 139.09,
          "end": 145.45
        },
        {
          "text": "Die Bundespolizei hatte gestern Abend die ICE-Strecke zwischen Hamburg und Berlin vorübergehend gesperrt.",
          "start": 147.69,
          "end": 156.81
        },
        {
          "text": "Nach dem Regen schien wieder die Sonne.",
          "start": 159.3,
          "end": 162.22
        },
        {
          "text": "Es geschah vor Jahrzehnten.",
          "start": 164.68,
          "end": 166.94
        },
        {
          "text": "Die deutsche Grammatik kennt drei Zeitformen der Vergangenheit für ein Verb.",
          "start": 169.75,
          "end": 174.91
        },
        {
          "text": "Es ist Viertel nach 12 Uhr.",
          "start": 178.04,
          "end": 180.18
        },
        {
          "text": "Bitte wecke mich um 8 Uhr.",
          "start": 183.16,
          "end": 185.18
        },
        {
          "text": "Weil die Zeiger der Uhren rechtsdrehend sind, wird bei Rechtsdrehungen meist einfach nur vom Uhrzeigersinn, UZS, gesprochen.",
          "start": 187.54,
          "end": 197.98
        },
        {
          "text": "Katholische und orthodoxe Geistliche umrunden den Altar während des Gottesdienstes gegen den Uhrzeigersinn.",
          "start": 201.16,
          "end": 209.28
        },
        {
          "text": "In der Krankenpflege wurden früher kleine Sanduhren mit einer Laufzeit von 15 Sekunden zum Messen des Pulses verwendet.",
          "start": 211.52,
          "end": 221.52
        },
        {
          "text": "Kommen Sie vorzeitig zu einer Party, müssen Sie damit rechnen, dass Sie Ihre Gastgeber noch in der Küche antreffen.",
          "start": 224.53,
          "end": 232.03
        },
        {
          "text": "Napoleon soll gesagt haben, China ist ein schlafender Löwe.",
          "start": 235.05,
          "end": 239.83
        },
        {
          "text": "Lasst ihn schlafen.",
          "start": 240.13,
          "end": 241.55
        },
        {
          "text": "Wenn er aufwacht, erschüttert er die Welt.",
          "start": 241.85,
          "end": 244.41
        },
        {
          "text": "Als Halbschlaf bezeichnen wir den Dämmerzustand zwischen Schlaf und Wachsein.",
          "start": 246.72,
          "end": 253.03
        },
        {
          "text": "Im Gegensatz dazu steht der Tiefschlaf.",
          "start": 253.74,
          "end": 256.52
        }
      ]
    }
