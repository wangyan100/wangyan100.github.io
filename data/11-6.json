    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Wenn bei einer Bruchzahl der Betrag des Zählers kleiner als der des Nenners ist, dann spricht man von einem echten oder eigentlichen Bruch.",
          "start": 119.13,
          "end": 129.23
        },
        {
          "text": "In manchen Fällen wird der Bruchstrich auch schräg geschrieben.",
          "start": 132.2,
          "end": 136.64
        },
        {
          "text": "Wenn der Zähler der Bruchzahl größer als der Nenner ist, bezeichnet man solche Bruchzahl als den unechten Bruch.",
          "start": 139.7,
          "end": 148.06
        },
        {
          "text": "Doppelbrüche lassen sich durch Erweitern mit einem geeigneten Faktor vereinfachen.",
          "start": 151.44,
          "end": 157.26
        },
        {
          "text": "Zähler und Nenner eines Bruches sind ganze Zahlen.",
          "start": 159.83,
          "end": 163.27
        },
        {
          "text": "Bei einem Bruch darf der Nenner nicht Null sein.",
          "start": 166.3,
          "end": 169.52
        },
        {
          "text": "Unter einem endlichen Dezimalbruch versteht man einen Dezimalbruch, der bis auf die letzte Stelle berechenbar ist.",
          "start": 172.64,
          "end": 180.52
        },
        {
          "text": "Pi ist ein typischer unendlicher unperiodischer Dezimalbruch.",
          "start": 183.56,
          "end": 188.3
        },
        {
          "text": "Die gemeinsamen Teiler von 12 und 18 sind also 1, 2, 3, 6 und der größte gemeinsame Teiler von diesen ist 6.",
          "start": 190.96,
          "end": 203.58
        },
        {
          "text": "Die reellen Zahlen beinhalten die rationalen Zahlen und die irrationalen Zahlen.",
          "start": 206.53,
          "end": 212.55
        },
        {
          "text": "Irrationale Zahl ist auch der unendliche unperiodische Dezimalbruch.",
          "start": 215.64,
          "end": 221.5
        },
        {
          "text": "Die kleinste natürliche Zahl ist die Null. 20 steht im Verhältnis zu 100 wie 1 zu 5.",
          "start": 223.74,
          "end": 235.0
        }
      ]
    }
