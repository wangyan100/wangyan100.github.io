    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Viele Tankstellen in Deutschland verdienen mehr mit dem Verkauf von Supermarktartikeln als mit dem von Kraftstoff.",
          "start": 139.06,
          "end": 146.39
        },
        {
          "text": "An der Tankstelle kann sowohl flüssiger als auch gasförmiger Wasserstoff getankt werden.",
          "start": 149.66,
          "end": 155.82
        },
        {
          "text": "Außerhalb der Öffnungszeiten kann man an manchen Tankstellen einen Tankautomaten benutzen.",
          "start": 159.02,
          "end": 164.76
        },
        {
          "text": "Ein Tankfahrzeug kann flüssige Stoffe, Gase, pulverförmige oder körnige Stoffe befördern.",
          "start": 167.7,
          "end": 174.74
        },
        {
          "text": "Über das Zapfventil wird der Kraftstoff in den Tank des Fahrzeuges gefüllt.",
          "start": 177.78,
          "end": 182.94
        },
        {
          "text": "An einer Zapfsäule hat der Mann plötzlich eine Waffe aus einer Jackentasche gezogen.",
          "start": 185.99,
          "end": 191.53
        },
        {
          "text": "Der Motor dieses Krans kann sowohl mit Benzin als auch mit Autogas betrieben werden.",
          "start": 194.59,
          "end": 200.99
        },
        {
          "text": "Der Dieselskandal hat dem Ruf von Volkswagen schwer geschadet.",
          "start": 204.08,
          "end": 209.1
        },
        {
          "text": "Früher war es üblich, dass die Tankwarte auch die Windschutzscheibe putzten.",
          "start": 211.93,
          "end": 216.67
        },
        {
          "text": "Bei stark verschmutzter Wäsche und auch bei großen Textilien wie Gardinen, soll man zuerst vorwaschen.",
          "start": 219.63,
          "end": 226.85
        },
        {
          "text": "Ein Vorteil von Waschstraßen ist, dass das Auto meist vom Kunden nicht verlassen werden muss.",
          "start": 229.88,
          "end": 236.18
        },
        {
          "text": "Ich habe das Stromkabel in die Steckdose eingesteckt.",
          "start": 239.14,
          "end": 242.98
        }
      ]
    }
  ]
