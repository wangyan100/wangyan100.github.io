    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Herzlichen Glückwunsch zum Geburtstag!",
          "start": 133.63,
          "end": 136.75
        },
        {
          "text": "Meine beste Freundin verschickt mir die Einladung zu Ihrer Geburtstagsfeier.",
          "start": 139.67,
          "end": 144.57
        },
        {
          "text": "Das Geburtstagskind lebe hoch!",
          "start": 147.34,
          "end": 149.82
        },
        {
          "text": "Man kann daran teilnehmen, aber das ist nicht obligatorisch.",
          "start": 152.98,
          "end": 157.46
        },
        {
          "text": "Schätzchen, lass uns auf die Liebe anstoßen!",
          "start": 160.39,
          "end": 163.65
        },
        {
          "text": "Am 3.",
          "start": 165.95,
          "end": 167.11
        },
        {
          "text": "Oktober haben alle Deutschen den Jahrestag der Wiedervereinigung Deutschlands gefeiert.",
          "start": 167.25,
          "end": 172.95
        },
        {
          "text": "Nach 10 gemeinsamen Ehejahren darf gefeiert werden, die Rosenhochzeit.",
          "start": 176.05,
          "end": 181.53
        },
        {
          "text": "Die Franzosen sind die aufmerksameren Liebhaber, finden es sehr wichtig, den Partner zu verwöhnen.",
          "start": 184.58,
          "end": 191.26
        },
        {
          "text": "Es ist schon eine Ewigkeit her.",
          "start": 194.3,
          "end": 196.48
        },
        {
          "text": "Das neue Ehepaar lässt Luftballons fliegen.",
          "start": 199.46,
          "end": 202.42
        },
        {
          "text": "Eros ist in der griechischen Mythologie der ursprüngliche Gott der Liebe.",
          "start": 204.79,
          "end": 210.57
        },
        {
          "text": "Jupiter gilt als Beschützer des Staates, sowie der Familie und des Hauses.",
          "start": 213.74,
          "end": 219.12
        },
        {
          "text": "Der 14.",
          "start": 222.3,
          "end": 223.04
        },
        {
          "text": "Februar galt im Volksglauben auch als einer der sogenannten Lostage.",
          "start": 223.28,
          "end": 228.44
        },
        {
          "text": "Venus war eine der drei Göttinnen im Schönheitswettbewerb der griechischen Antike.",
          "start": 231.73,
          "end": 237.19
        },
        {
          "text": "Er führte den Unfall auf einen Defekt an den Bremsen zurück.",
          "start": 239.65,
          "end": 244.27
        }
      ]
    }
