    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Du sollst dich ins Bett legen und dich ausruhen.",
          "start": 127.19,
          "end": 131.09
        },
        {
          "text": "Das neue Doppelbett ist ungeeignet und das Ehepaar wollte es zurückgeben.",
          "start": 133.88,
          "end": 139.46
        },
        {
          "text": "Er erwacht auf einem Einzelbett in einem leeren Raum.",
          "start": 142.32,
          "end": 146.3
        },
        {
          "text": "Meine Freunde haben mir eine Kommode geschenkt.",
          "start": 149.5,
          "end": 152.78
        },
        {
          "text": "Auf dem Nachtisch liegt eine Bettlampe.",
          "start": 155.56,
          "end": 158.3
        },
        {
          "text": "Im Winter brauche ich eine dicke Bettdecke.",
          "start": 161.31,
          "end": 164.23
        },
        {
          "text": "Feichenblätter waren ihre Matratze und ein Rosenblatt ihr Deckblatt.",
          "start": 167.52,
          "end": 172.56
        },
        {
          "text": "Däumelinchen Mein Vater deckt meine junge Schwester sorgsam mit einer Zudecke zu.",
          "start": 172.98,
          "end": 181.79
        },
        {
          "text": "Sie kämmt ihre langen schwarzen Haare mit diesem Kamm.",
          "start": 184.67,
          "end": 188.55
        },
        {
          "text": "Diese Frau trägt so viel Parfüm auf, dass es stark und herb riecht.",
          "start": 191.72,
          "end": 197.22
        },
        {
          "text": "Der Mann hilft seiner Frau, den Mantel auf den Kleiderbügel zu hängen.",
          "start": 199.81,
          "end": 204.89
        },
        {
          "text": "Auf dem Kleiderständer im Flur trappierte der Designer verschiedene Kopfdeckungen.",
          "start": 207.69,
          "end": 213.41
        },
        {
          "text": "Wenn uns Alpträume jede Nacht quälen, kann es zu Schlafstörungen kommen.",
          "start": 216.46,
          "end": 221.78
        },
        {
          "text": "Er leidet schwer unter Schlaflosigkeit.",
          "start": 224.57,
          "end": 227.71
        },
        {
          "text": "Der Traum ist ausgeträumt.",
          "start": 230.81,
          "end": 232.91
        }
      ]
    }
