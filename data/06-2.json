    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Federer ist ein sehr berühmter Tennisspieler und hat in seiner Karriere über 1200 Matches gewonnen.",
          "start": 141.85,
          "end": 150.21
        },
        {
          "text": "Die 30-jährige Tennisspielerin aus Deutschland beendete das Match mit einem Ass.",
          "start": 152.89,
          "end": 158.59
        },
        {
          "text": "Dieser Wildcardinhaber gab sich erst nach dem fünften Matchball geschlagen.",
          "start": 161.52,
          "end": 166.92
        },
        {
          "text": "Er nahm 40% aller Bälle noch vor der Grundlinie an.",
          "start": 166.92,
          "end": 173.74
        },
        {
          "text": "Novak Djokovic hat ohne Satzverlust das ATP Masters in Madrid gewonnen.",
          "start": 173.74,
          "end": 182.88
        },
        {
          "text": "Bei einem Spielstand von 40-40 spricht man vom Einstand.",
          "start": 182.88,
          "end": 190.54
        },
        {
          "text": "Er währte im Tiebreak des dritten Satzes zwei Matchbälle ab.",
          "start": 190.54,
          "end": 198.28
        },
        {
          "text": "Das Recht auf den Aufschlag wechselt im folgenden Spiel.",
          "start": 198.28,
          "end": 205.15
        },
        {
          "text": "Dem Kontrahenten unterlief ein Doppelfehler.",
          "start": 205.15,
          "end": 210.83
        },
        {
          "text": "Sekunden später hat er mit einer weiteren Vorhand diesen zweiten Satz gewonnen.",
          "start": 210.83,
          "end": 219.74
        },
        {
          "text": "Sie hat drei der vergangenen 16 Turniere auf Hartplatz verletzt aufgeben müssen.",
          "start": 219.74,
          "end": 228.57
        },
        {
          "text": "Der erste Teilnehmer an einem Grand Slam Turnier folgt seinem Landsmann in die zweite Runde.",
          "start": 228.57,
          "end": 237.87
        },
        {
          "text": "Sie hat wieder ein Halbfinale auf der WTA Tour erreicht.",
          "start": 237.87,
          "end": 244.68
        },
        {
          "text": "Heute Abend trifft der deutsche Spieler auf den serbischen Weltrangliste ersten Novak Djokovic.",
          "start": 244.68,
          "end": 254.46
        }
      ]
    }
