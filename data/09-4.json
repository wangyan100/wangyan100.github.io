    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Man kann keinem ins Herz sehen.",
          "start": 114.77,
          "end": 120.4
        },
        {
          "text": "Die untere Seite des Herzbeutels ist mit dem Zwerchfell verwachsen.",
          "start": 123.52,
          "end": 128.06
        },
        {
          "text": "Ist eine Herzklappe von Geburt an missgebildet, kann sie durch eine künstliche Herzklappe ersetzt werden.",
          "start": 131.05,
          "end": 138.39
        },
        {
          "text": "Diese Krankheit kann zu einer Herzbeutelentzündung kommen, bei der sich Flüssigkeit zwischen Herzmuskel und Herzbeutel ansammelt.",
          "start": 141.44,
          "end": 150.06
        },
        {
          "text": "Er zieht die frische Luft tief in die Lungen.",
          "start": 152.24,
          "end": 156.0
        },
        {
          "text": "Die Lunge gleicht einem Baum.",
          "start": 159.02,
          "end": 160.84
        },
        {
          "text": "Der Stamm, die Luftröhre, verzweigt sich in die Äste, Bronchien genannt.",
          "start": 161.5,
          "end": 166.72
        },
        {
          "text": "Bronchitis ist eine häufige Erkrankung im Bereich der Bronchien.",
          "start": 169.76,
          "end": 174.12
        },
        {
          "text": "Der rechte Lungenflügel ist in zehn, der linke in neun Lungensegmente unterteilt.",
          "start": 177.2,
          "end": 183.12
        },
        {
          "text": "Die in der Leber produzierte Flüssigkeit, also Galle, hilft bei der Verdauung von Nahrungsfetten.",
          "start": 185.32,
          "end": 192.86
        },
        {
          "text": "Bauchschmerzen um den Bauchnabel herum oder in der Magengegend können die ersten Anzeichen einer Blinddarmentzündung sein.",
          "start": 195.93,
          "end": 204.61
        },
        {
          "text": "Der Mastdarm ist der letzte Abschnitt des Dickdarms.",
          "start": 207.66,
          "end": 211.38
        },
        {
          "text": "Die Hauptfunktion von Wurmfortsatz liegt in der frühen Kindheit in der Immunabwehr.",
          "start": 214.45,
          "end": 221.03
        },
        {
          "text": "Das Lymphsystem ist Teil des Immunsystems und damit wichtig für die Abwehr von Krankheitserregern.",
          "start": 223.24,
          "end": 231.12
        }
      ]
    }
