    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "streitet immer mit ihrem älteren Bruder um das Spielzeug.",
          "start": 128.84,
          "end": 132.52
        },
        {
          "text": "Es gibt stetig Knatsch in dieser Familie.",
          "start": 135.57,
          "end": 138.57
        },
        {
          "text": "Ihr Mann schimpft den ganzen Tag.",
          "start": 141.82,
          "end": 144.26
        },
        {
          "text": "Die Geschwister in dieser Familie haben sich in dieser Diskussion sind die Geschäftspartner noch uneinig.",
          "start": 147.21,
          "end": 158.06
        },
        {
          "text": "Sie ist neidisch auf ihren Freund.",
          "start": 161.06,
          "end": 163.22
        },
        {
          "text": "In der Vergangenheit hatte der Kaiser Gewalt über Leben und Tod.",
          "start": 166.31,
          "end": 170.97
        },
        {
          "text": "Der starke Mann hielt dem Gegenüber die Faust unter die Nase.",
          "start": 174.0,
          "end": 178.42
        },
        {
          "text": "Die Tochter bekommt eine saftige Ohrfeige von ihrer Mutter.",
          "start": 181.48,
          "end": 185.12
        },
        {
          "text": "Ich bin enttäuscht davon, meine Eltern können mich nicht abholen.",
          "start": 188.13,
          "end": 192.25
        },
        {
          "text": "Es gelang ihm nicht, den Streit zu schlichten.",
          "start": 194.62,
          "end": 198.14
        },
        {
          "text": "Ich habe schon verstanden, was du meinst.",
          "start": 200.97,
          "end": 203.71
        },
        {
          "text": "Die Mutter hat ihrem Sohn die Schuld längst vergeben.",
          "start": 206.63,
          "end": 209.91
        },
        {
          "text": "Nach einer Abhandlung haben sich die beiden Geschäftspartner ausgesöhnt.",
          "start": 213.0,
          "end": 217.94
        },
        {
          "text": "Der Staatspräsident möchte die Konflikte zwischen den Einheimischen und den Ausländern vermitteln.",
          "start": 220.86,
          "end": 227.16
        },
        {
          "text": "Hast du schon wieder die ganze Nacht lang geweint?",
          "start": 230.11,
          "end": 232.73
        }
      ]
    }
