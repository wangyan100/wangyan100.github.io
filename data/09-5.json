    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das häufigste Problem, das die ableitenden Harnwege betrifft, ist die akute Blasenentzündung.",
          "start": 111.42,
          "end": 120.55
        },
        {
          "text": "In der Harnblase wird Harn gesammelt und zwischengespeichert, bis er über die Harnröhre entleert wird.",
          "start": 120.55,
          "end": 131.14
        },
        {
          "text": "Der Harnleiter verbindet die Nieren mit der Harnblase.",
          "start": 131.14,
          "end": 137.24
        },
        {
          "text": "Die Nebennieren befinden sich bei Menschen auf den oberen Polen beider Nieren.",
          "start": 137.24,
          "end": 145.89
        },
        {
          "text": "Der Kitzler ist ein Teil der Vulva.",
          "start": 145.89,
          "end": 151.37
        },
        {
          "text": "Das Jungfernhäutchen bildet die Grenze zur Scheide, die zu den inneren Geschlechtsorganen zählt.",
          "start": 151.37,
          "end": 161.03
        },
        {
          "text": "Die kleinen Schamlippen werden außen von den großen Schamlippen umschlossen.",
          "start": 161.03,
          "end": 168.43
        },
        {
          "text": "Zu den inneren weiblichen Geschlechtsorganen gehören Eierstöcke, Gebärmutter, Eileiter und Scheide.",
          "start": 168.43,
          "end": 178.55
        },
        {
          "text": "Die Gebärmutter ist bei der geschlechtsreifen Frau etwa sieben bis neun Zentimeter lang.",
          "start": 178.55,
          "end": 187.24
        },
        {
          "text": "Der Gebärmutterhals sollte sich erst am Ende der Schwangerschaft verkürzen.",
          "start": 187.24,
          "end": 194.78
        },
        {
          "text": "Als Befruchtung bezeichnet man den Moment, in dem eine Samenzelle durch die Eihülle in die Eizelle eindringt und die Erbanlagen von Mann und Frau verschmelzen.",
          "start": 194.78,
          "end": 209.18
        },
        {
          "text": "Männer ab 45 Jahren sollten jährlich zur Vorsorge von Vorsteherdrüse gehen, um mögliche Erkrankungen, zum Beispiel Prostata-Krebs, frühzeitig erkennen und behandeln zu können.",
          "start": 209.18,
          "end": 225.82
        }
      ]
    }
