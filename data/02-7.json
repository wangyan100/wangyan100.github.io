    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Eine Kaltschale wird vor allem im Sommer gegessen.",
          "start": 127.66,
          "end": 131.84
        },
        {
          "text": "Eine Kraftbrühe ist die Vollendung der Fleischbrühe, wodurch sie besonders reich und kräftig wird.",
          "start": 134.99,
          "end": 142.77
        },
        {
          "text": "Cremesuppen sind bester Begleiter an kalten Tagen.",
          "start": 145.62,
          "end": 149.22
        },
        {
          "text": "Badische Schneckensuppe ist ein traditionelles Gericht der badischen Küche.",
          "start": 152.4,
          "end": 157.96
        },
        {
          "text": "Eigentlich ist Borsch ein ukrainischer Eintopf.",
          "start": 160.78,
          "end": 164.56
        },
        {
          "text": "Für eine Hühnersuppe brauchen Sie ein küchenfertiges Suppenhuhn, Suppengemüse und Gewürze.",
          "start": 167.6,
          "end": 174.9
        },
        {
          "text": "Die ursprüngliche Gazpacho geht auf die Mauren zurück und war eine weiße Knoblauchsuppe aus Gurken, Brot, Knoblauch, Olivenöl, Essig, Salz und Wasser.",
          "start": 177.86,
          "end": 190.94
        },
        {
          "text": "Die Salmoreo ist eine kalte, dickflüssige Suppe aus der Region um Córdoba in Spanien.",
          "start": 193.97,
          "end": 202.01
        },
        {
          "text": "Fritatensuppe ist eine der beliebtesten Suppen in Österreich.",
          "start": 205.33,
          "end": 209.43
        },
        {
          "text": "Miso-Suppe wird in Japan meistens mit Stäbchen gegessen.",
          "start": 211.7,
          "end": 216.68
        }
      ]
    }
