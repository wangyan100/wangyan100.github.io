    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Bei den Flöten unterscheidet man Quer- und Schnabelflöten.",
          "start": 142.24,
          "end": 145.1
        },
        {
          "text": "Das Ehepaar bläst immer ins gleiche Horn.",
          "start": 145.1,
          "end": 151.67
        },
        {
          "text": "Das Programm enthält Kompositionen für die Kombination von Oboe und Orgel.",
          "start": 151.67,
          "end": 159.99
        },
        {
          "text": "Am Mittwoch wird Musik für Saxophon und Orgel im Dom dargeboten.",
          "start": 159.99,
          "end": 167.09
        },
        {
          "text": "Becken sind seit uralten Zeiten bekannt, ihr Ursprung liegt wahrscheinlich in Asien.",
          "start": 167.09,
          "end": 176.03
        },
        {
          "text": "Hackbretter sind Seiteninstrumente, die nach der Art der Tonerzeugung auch zu den Schlaginstrumenten gezählt werden.",
          "start": 176.03,
          "end": 186.76
        },
        {
          "text": "Der moderne Triangel hat die Form eines gleichseitigen Dreiecks.",
          "start": 186.76,
          "end": 193.97
        },
        {
          "text": "Scheinbar ist die Viola nur eine größere Violine, einfach eine Quint tiefer gestimmt.",
          "start": 193.97,
          "end": 203.36
        },
        {
          "text": "Die Gamben entstanden wahrscheinlich im 15.",
          "start": 203.36,
          "end": 209.18
        },
        {
          "text": "Jahrhundert in Spanien.",
          "start": 209.18,
          "end": 210.78
        },
        {
          "text": "Ukulelen sind gewöhnlich aus Holz gebaut.",
          "start": 210.78,
          "end": 216.7
        },
        {
          "text": "Ein Akkordeon besteht aus zwei Teilen, Diskant und Bass, die durch einen Balk miteinander verbunden sind.",
          "start": 216.7,
          "end": 227.71
        },
        {
          "text": "Im Gegensatz zum modernen Klavier oder Flügel besitzen Hammerklaviere als typisches Merkmal in der Regel keinen Metallrahmen, sondern Rahmenkonstruktionen aus Holz.",
          "start": 227.71,
          "end": 242.68
        },
        {
          "text": "Wer kann den Bund zweier Herzen lösen oder die Töne eines Akkords auseinanderreißen?",
          "start": 242.68,
          "end": 251.35
        }
      ]
    }
