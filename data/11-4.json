    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Seit 2002 hat die Waldfläche in Deutschland um ca. 50.000 Hektar zugenommen.",
          "start": 122.06,
          "end": 129.24
        },
        {
          "text": "Ein Morgen, MG, war noch ein bis etwa 1900 in Deutschland verwendetes Flächenmaß.",
          "start": 131.48,
          "end": 139.48
        },
        {
          "text": "Das Gewichtmaß Unze wird noch heute in einigen englischsprachigen Ländern bei Lebensmitteln benutzt.",
          "start": 142.78,
          "end": 149.99
        },
        {
          "text": "Im US-Bundesstaat Kalifornien ist ein Säugling mit gerade einmal 245 Gramm zur Welt gekommen.",
          "start": 153.2,
          "end": 161.2
        },
        {
          "text": "Der weltweit größte Diamant, der Cullinan, mit 3106 Karat wurde 1905 in Südafrika gefunden.",
          "start": 163.44,
          "end": 174.94
        },
        {
          "text": "Der Hamburger Zoll entdeckt 50 Kilogramm Kokain, der einen Verkaufswert von mindestens 12 Millionen Euro hat.",
          "start": 178.07,
          "end": 186.75
        },
        {
          "text": "Eine Reise von 1000 Meilen beginnt mit dem ersten Schritt.",
          "start": 189.86,
          "end": 193.68
        },
        {
          "text": "Um 22 Cent hat sich der Liter Superbenzin seit Jahresbeginn verteuert.",
          "start": 195.96,
          "end": 203.06
        },
        {
          "text": "Örtlich fielen bis zu 70 Liter Wasser pro Quadratmeter.",
          "start": 205.68,
          "end": 209.78
        },
        {
          "text": "Quad ist eine Einheit für das Volumen von Flüssigkeiten und Trockenstoffen, die vor allem im Angloamerikanischen Maßsystem Verwendung findet.",
          "start": 212.97,
          "end": 222.49
        },
        {
          "text": "Das Kelvin ist die Basiseinheit der thermodynamischen Temperatur und zugleich gesetzliche Temperatureinheit.",
          "start": 224.8,
          "end": 232.8
        }
      ]
    }
  ]
