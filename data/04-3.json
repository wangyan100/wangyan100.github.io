    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Möwen kreisen ein Segelschiff um und kreischen.",
          "start": 136.96,
          "end": 140.82
        },
        {
          "text": "Das Schiff ist auf ein Riff aufgelaufen.",
          "start": 143.71,
          "end": 146.83
        },
        {
          "text": "Der Skandal verläuft im Sande.",
          "start": 149.8,
          "end": 152.56
        },
        {
          "text": "Die Heirat der zwei Berühmten schlagen hohe Wellen.",
          "start": 154.8,
          "end": 159.3
        },
        {
          "text": "Die Titanic ist ein bekanntes Kreuzfahrtschiff, das auf ihrer Jungfernfahrt im Jahr 1912 untergegangen ist.",
          "start": 162.33,
          "end": 171.01
        },
        {
          "text": "Insgesamt hat das Passagierschiff 3.240 Seemeilen zurückgelegt.",
          "start": 174.19,
          "end": 180.91
        },
        {
          "text": "Abends machten die Jachten am Kai fest.",
          "start": 184.23,
          "end": 186.99
        },
        {
          "text": "Am Strand liegen die Eltern in der Sonne, während die Kinder Sandburgen errichten.",
          "start": 190.07,
          "end": 195.45
        },
        {
          "text": "Ihre Augen schwimmen.",
          "start": 198.77,
          "end": 200.15
        },
        {
          "text": "Heute können vollständige Blinde mithilfe einer Spezialsoftware im Internet surfen.",
          "start": 203.3,
          "end": 210.02
        },
        {
          "text": "Das Zimmer taucht in die Sonne.",
          "start": 213.19,
          "end": 215.87
        },
        {
          "text": "Alle Flüsse laufen ins Meer.",
          "start": 218.56,
          "end": 220.68
        },
        {
          "text": "Nach der Temperatur kann Meeresströmung in kalte und warme Strömung eingeteilt werden.",
          "start": 223.85,
          "end": 230.01
        }
      ]
    }
