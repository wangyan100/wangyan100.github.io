    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Alpakas werden in Europa wegen ihres ruhigen und friedlichen Charakters auch in der tiergeschützten Therapie eingesetzt.",
          "start": 121.92,
          "end": 130.94
        },
        {
          "text": "Es ist leichter, dass ein Kamel durch ein Nadelöhr gehe, dem das ein Reicher ins Reich Gottes komme.",
          "start": 134.01,
          "end": 141.49
        },
        {
          "text": "Lamas kommen nur in Südamerika vor.",
          "start": 144.76,
          "end": 147.58
        },
        {
          "text": "Jaks variieren ihre Atemfrequenz in Abhängigkeit von der Außentemperatur.",
          "start": 150.63,
          "end": 156.79
        },
        {
          "text": "Die Paarungszeit der Darmhirsche ist Mitte Oktober.",
          "start": 159.47,
          "end": 163.73
        },
        {
          "text": "Ursprünglich im östlichen Asien beheimatet, ist der Davidhirsch in freier Wildbahn seit mehreren hundert Jahren ausgerottet.",
          "start": 166.79,
          "end": 176.35
        },
        {
          "text": "Charakteristisch für den Körperbau des Elches ist der kurze massige Rumpf mit seinen relativ langen Gliedmaßen.",
          "start": 179.31,
          "end": 187.67
        },
        {
          "text": "Die Giraffe, glaubte er, hat deshalb einen langen Hals, weil sie in Generation um Generation nach immer höheren Blättern streckte.",
          "start": 190.45,
          "end": 200.27
        },
        {
          "text": "Das Reh wurde durch die Deutsche Wildtierstiftung als Tier des Jahres 2019 ausgewählt.",
          "start": 203.26,
          "end": 210.24
        },
        {
          "text": "Nashörner leben häufig als Einzelgänger.",
          "start": 213.44,
          "end": 216.42
        },
        {
          "text": "Man schlägt den Sack und meint den Esel.",
          "start": 219.5,
          "end": 222.42
        },
        {
          "text": "Portugiesische Seefahrer sahen Ende des 15.",
          "start": 225.32,
          "end": 229.08
        },
        {
          "text": "Jahrhunderts erstmals Zebras bei ihren Entdeckungsfahrten in Afrika.",
          "start": 229.3,
          "end": 234.08
        },
        {
          "text": "Der Igel stellt seine Stacheln auf.",
          "start": 237.08,
          "end": 239.5
        }
      ]
    }
