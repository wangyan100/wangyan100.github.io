    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Wenn du Krafttraining betreibst, dann braucht dein Körper Kohlenhydrate als Energielieferant.",
          "start": 133.26,
          "end": 139.62
        },
        {
          "text": "Muskeln bestehen zu einem großen Teil aus Eiweiß.",
          "start": 142.79,
          "end": 146.51
        },
        {
          "text": "Deshalb ist es wichtig, dass man ausreichend Proteine zu sich nimmt.",
          "start": 146.71,
          "end": 150.97
        },
        {
          "text": "Sie geht jeden Samstag ins Fitnessstudio, um abzunehmen.",
          "start": 154.09,
          "end": 158.45
        },
        {
          "text": "Wärmt man sich vor dem Sport nicht auf, kommt es zu Zerrungen und Gelenkverschleiß.",
          "start": 161.04,
          "end": 167.22
        },
        {
          "text": "Aquazumba heißt der Trend, der eine Mischung aus Aquaerobic und Zumba ist.",
          "start": 170.04,
          "end": 175.28
        },
        {
          "text": "Kardiotraining kann das Herz und die Lunge verstärken.",
          "start": 178.76,
          "end": 182.46
        },
        {
          "text": "Hot Hula ist ein echtes gute Laune-Workout, das den ganzen Körper trainiert.",
          "start": 185.06,
          "end": 190.86
        },
        {
          "text": "Hot Pilates wird sich nach und nach von großen Städten in die kleineren Städte vorarbeiten.",
          "start": 193.93,
          "end": 200.31
        },
        {
          "text": "Liegestütze trainieren nicht nur den Bauch, sondern auch Oberarme, Schultern und Brust.",
          "start": 203.46,
          "end": 209.56
        },
        {
          "text": "Viele Mädchen spielen gerne Seilspringen.",
          "start": 212.23,
          "end": 214.99
        },
        {
          "text": "Fast 90% der Deutschen finden Gartenarbeit entspannender als Yoga.",
          "start": 218.06,
          "end": 223.2
        },
        {
          "text": "Der Trainer hat dem Anfänger einen passenden Trainingskurs empfohlen.",
          "start": 223.2,
          "end": 230.42
        },
        {
          "text": "Mein privater Trainer inspiriert mich oft beim Training.",
          "start": 230.42,
          "end": 237.28
        },
        {
          "text": "Man kann Fitness-Tracker mit seinem Smartphone über Bluetooth verbinden.",
          "start": 237.28,
          "end": 245.67
        }
      ]
    }
