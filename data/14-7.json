    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Knebelbart war gegen Ende des 16.",
          "start": 144.22,
          "end": 146.92
        },
        {
          "text": "Jahrhunderts bis zur Mitte des 17.",
          "start": 147.14,
          "end": 149.38
        },
        {
          "text": "Jahrhunderts weit verbreitet.",
          "start": 149.74,
          "end": 151.66
        },
        {
          "text": "Mein Mann hat einen Vollbart, der die Hälfte des Gesichts verdeckt.",
          "start": 154.83,
          "end": 159.01
        },
        {
          "text": "Er leidet an extremem Haarausfall und hat sich deshalb eine Glatze rasieren lassen.",
          "start": 162.07,
          "end": 167.75
        },
        {
          "text": "Unsere Tochter hat hübsche Locken, während unser Sohn glattes Haar hat.",
          "start": 170.97,
          "end": 175.71
        },
        {
          "text": "Sie trägt den Scheitel in der linken Seite.",
          "start": 178.77,
          "end": 181.59
        },
        {
          "text": "Tina lässt sich einen Pony schneiden.",
          "start": 183.92,
          "end": 186.94
        },
        {
          "text": "Gehst du auch immer zum selben Friseur?",
          "start": 190.36,
          "end": 192.74
        },
        {
          "text": "Die Ausbildung zum Friseur in Deutschland dauert drei Jahre.",
          "start": 195.65,
          "end": 199.61
        },
        {
          "text": "In Deutschland war der Meisterbrief als zwingende Voraussetzung, einen Handwerksbetrieb führen zu dürfen.",
          "start": 202.72,
          "end": 209.64
        },
        {
          "text": "Brennschere findet in der Friseurtechnik keine Anwendung mehr.",
          "start": 212.95,
          "end": 217.19
        },
        {
          "text": "Lockenwickler dienen dazu, glatte oder schwach gelockte Haare aufzuwickeln.",
          "start": 220.32,
          "end": 225.86
        },
        {
          "text": "Da meine Haare schwer strapaziert werden, benutze ich einmal in der Woche eine Haarkur.",
          "start": 228.42,
          "end": 234.3
        },
        {
          "text": "Für die Haarpflege gibt es im Supermarkt wohl so viele Produkte.",
          "start": 237.48,
          "end": 241.96
        },
        {
          "text": "Shampoos, Haarkuren, Gel, Wachs und Haarwasser.",
          "start": 242.64,
          "end": 246.94
        },
        {
          "text": "Eine trockene Kopfhaut, die juckt, bringt häufig weiße Schuppen mit sich.",
          "start": 250.22,
          "end": 255.02
        }
      ]
    }
