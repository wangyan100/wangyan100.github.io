    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das Ehepaar hat sich wieder ausgesöhnt.",
          "start": 164.85,
          "end": 168.43
        },
        {
          "text": "Wir haben uns verkracht.",
          "start": 171.28,
          "end": 172.94
        },
        {
          "text": "Sie zanken sich den ganzen Tag um nichts und wieder nichts.",
          "start": 176.08,
          "end": 179.94
        },
        {
          "text": "Die zwei Brüder haben sich über das Erbe ihres Vaters zerstritten.",
          "start": 183.42,
          "end": 188.02
        },
        {
          "text": "Der Mann ging uns mit einem missmutigen Zischeln aus dem Weg.",
          "start": 190.39,
          "end": 195.07
        },
        {
          "text": "Er ist während der langen Wartezeit ganz nervös geworden.",
          "start": 198.13,
          "end": 201.83
        },
        {
          "text": "Der Misserfolg bei der Fußballweltmeisterschaft hat die deutschen Spieler niedergedrückt.",
          "start": 204.99,
          "end": 210.67
        },
        {
          "text": "Der Misserfolg drückt ihn nieder.",
          "start": 212.91,
          "end": 216.43
        },
        {
          "text": "Das gibt nur unnötige Schärereien.",
          "start": 218.99,
          "end": 221.65
        },
        {
          "text": "Warum sehen sie so verdrieslich aus?",
          "start": 224.64,
          "end": 227.1
        },
        {
          "text": "Er findet an allem etwas zu tadeln.",
          "start": 230.11,
          "end": 232.73
        },
        {
          "text": "Er regt sich über seinen Chef fürchterlich auf.",
          "start": 235.7,
          "end": 238.78
        },
        {
          "text": "Seine Ablehnung verstimmt uns aufs Tiefste.",
          "start": 242.0,
          "end": 244.96
        },
        {
          "text": "Er war rot vor Zorn.",
          "start": 247.93,
          "end": 249.49
        }
      ]
    }
