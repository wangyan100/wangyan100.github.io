    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Muttertag geht auf eine Initiative der amerikanischen Frauenrechtlerin Anna Jarvis zurück.",
          "start": 122.72,
          "end": 130.32
        },
        {
          "text": "Am Muttertag wäre es das beste Geschenk, die Mutterschaft von Übermüdung und Geldsorgen zu befreien.",
          "start": 133.42,
          "end": 141.28
        },
        {
          "text": "Man will auf humorvolle Art und Weise allen Müttern anlässlich des Muttertags Dankeschön sagen.",
          "start": 143.64,
          "end": 150.56
        },
        {
          "text": "Die Lehrerin behandelte ihre Schüler mütterlich.",
          "start": 150.56,
          "end": 157.05
        },
        {
          "text": "Das Mutterbild ist stark an die Idee von Aufopferung geknüpft.",
          "start": 160.03,
          "end": 164.57
        },
        {
          "text": "Die Idee, dass nur Mütter fürsorglich, liebevoll und aufmerksam sein können, ist so alt wie überholt.",
          "start": 167.61,
          "end": 174.67
        },
        {
          "text": "Ich verliebte mich sofort in sie, weil sie so lieblich lächelte.",
          "start": 178.02,
          "end": 183.0
        },
        {
          "text": "Er kraulte ihr sanft den Nacken.",
          "start": 185.48,
          "end": 187.88
        },
        {
          "text": "Eine schöne schlichte Würdigung der Väter, die so viel sind, Beschützer und Ernährer, Autoritäten und Vorbilder.",
          "start": 190.16,
          "end": 199.16
        },
        {
          "text": "Christi Himmelfahrt wird jedes Jahr im Mai gefeiert.",
          "start": 202.64,
          "end": 205.64
        },
        {
          "text": "Männer sehnen sich stärker nach Familie als Frauen.",
          "start": 209.17,
          "end": 212.73
        }
      ]
    }
