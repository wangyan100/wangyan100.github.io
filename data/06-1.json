    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Viele Faktoren führen heute dazu, dass immer mehr deutsche Kinder nicht schwimmen können.",
          "start": 118.93,
          "end": 125.17
        },
        {
          "text": "Der Beruf des Bademeisters scheint längst nicht attraktiv zu sein.",
          "start": 127.96,
          "end": 132.92
        },
        {
          "text": "Die Rettungsschwimmer sind 10 Meter in die Tiefe getaucht.",
          "start": 135.96,
          "end": 139.7
        },
        {
          "text": "Ein deutscher Schwimmer hat bei der WM in Budapest eine Silbermedaille geholt.",
          "start": 142.77,
          "end": 147.85
        },
        {
          "text": "Er ist keine Wasserratte und scheut vor Wasser.",
          "start": 150.93,
          "end": 153.91
        },
        {
          "text": "Bei den Olympischen Spielen gibt es 10 Schwimmbahnen im Schwimmbäcken.",
          "start": 156.89,
          "end": 161.27
        },
        {
          "text": "Im Leben herrscht immer Höhen und Tiefen.",
          "start": 164.3,
          "end": 167.08
        },
        {
          "text": "Die heutigen bekanntesten Schwimmstile im Schwimmsport sind Brustschwimmen, Kraulschwimmen, Rückenkraulen und Schmetterlingsschwimmen.",
          "start": 169.65,
          "end": 179.27
        },
        {
          "text": "Er holt sich seine Goldmedaille über 1500 Meter Freistil ab.",
          "start": 182.22,
          "end": 187.34
        },
        {
          "text": "Sie hat das Finale über 200 Meter Schmetterling als sechster seines Halbfinales verpasst.",
          "start": 190.4,
          "end": 197.2
        },
        {
          "text": "Eine Schwimmbrile kann verhindern, dass Wasser die Augen erreicht.",
          "start": 199.67,
          "end": 203.39
        },
        {
          "text": "Der Schwimmring kann beim Schwimmen helfen.",
          "start": 206.31,
          "end": 208.83
        },
        {
          "text": "Das Tauchen an Riffen ist bedenklich.",
          "start": 212.16,
          "end": 214.58
        },
        {
          "text": "Nur unter Aufsicht und mit Schwimmwesten.",
          "start": 215.0,
          "end": 217.7
        }
      ]
    }
