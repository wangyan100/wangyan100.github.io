    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das Frühlingsfest ist in China und vielen anderen asiatischen Ländern das wichtigste Familienfest des Jahres.",
          "start": 140.68,
          "end": 149.32
        },
        {
          "text": "Der Lärm soll Glück bringen und einem alten Aberglauben zufolge böse Geister vertreiben.",
          "start": 152.38,
          "end": 159.2
        },
        {
          "text": "China ist weltweit der größte Exporteur von Feuerwerkskörpern.",
          "start": 161.54,
          "end": 166.54
        },
        {
          "text": "Das gefährliche Fabeltier Nian hatte Angst vor drei Dingen.",
          "start": 169.87,
          "end": 174.35
        },
        {
          "text": "Vor roter Farbe, vor Feuer und vor lautem Krach.",
          "start": 174.81,
          "end": 178.81
        },
        {
          "text": "Die chinesischen Tierkreiszeichen bestehen aus zwölf Tieren, wobei jedem Jahr ein Tier zugeordnet ist.",
          "start": 181.76,
          "end": 189.62
        },
        {
          "text": "Die zwölf Erdzweige mit den zehn Himmelsstemmen ergeben sie den 60-Jahreszyklus des chinesischen Kalenders.",
          "start": 191.82,
          "end": 201.08
        },
        {
          "text": "Die Ankunft des neuen Mondjahres wird auch in den Chinatowns chinesischer Einwanderer in vielen Städten der Erde gefeiert.",
          "start": 204.17,
          "end": 213.19
        },
        {
          "text": "Jedes Jahr findet die chinesische Frühlingsfestgala um 20 Uhr am Silvesterabend statt.",
          "start": 216.31,
          "end": 222.71
        },
        {
          "text": "Die Tempel des Erdparks wurden mit roten Laternen dekoriert.",
          "start": 224.95,
          "end": 230.11
        },
        {
          "text": "Auf den Straßen wurden Tänze mit Drachen oder Löwenmasken dargeboten.",
          "start": 233.63,
          "end": 238.19
        },
        {
          "text": "Schwein gilt in Deutschland als Glücksbringer.",
          "start": 241.79,
          "end": 244.79
        },
        {
          "text": "Zum Jahreswechsel um Mitternacht wird meist mit Feuerwerk und Böllern gefeiert.",
          "start": 248.0,
          "end": 253.2
        }
      ]
    }
