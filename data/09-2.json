    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Frau wirft den Kopf in den Nacken.",
          "start": 93.84,
          "end": 96.44
        },
        {
          "text": "Mir brennt der Schlund.",
          "start": 99.57,
          "end": 101.15
        },
        {
          "text": "Die Speiseröhre ist ein hohler Schlauch, der vom Rachen bis zum Magen führt.",
          "start": 104.12,
          "end": 109.22
        },
        {
          "text": "Er drückt seine weinende Frau an die Brust.",
          "start": 112.27,
          "end": 115.25
        },
        {
          "text": "Die weibliche Brust besteht zum größten Teil aus Fett- und Drüsengewebe.",
          "start": 117.42,
          "end": 122.22
        },
        {
          "text": "Schläfst du auf dem Bauch oder auf dem Rücken?",
          "start": 122.22,
          "end": 128.41
        },
        {
          "text": "Als Bauchhöhle wird der Raum unterhalb des Zwerchfels bezeichnet.",
          "start": 128.41,
          "end": 135.51
        },
        {
          "text": "In diesem Fall ist es nötig, eine Ultraschalluntersuchung des Abdomens vorzunehmen.",
          "start": 135.51,
          "end": 144.4
        },
        {
          "text": "Nabel ist ein Überbleibsel der Nabelschnur, die mit der Plazenta unserer Mutter verbunden hat, um Föten mit lebenswichtigen Nährstoffen zu versorgen.",
          "start": 144.4,
          "end": 158.13
        },
        {
          "text": "Der Schweiß ran dem Sklaven den Rücken hinunter.",
          "start": 158.13,
          "end": 164.16
        },
        {
          "text": "Er zuckte die Schulter und sagte, er habe keine Ahnung.",
          "start": 164.16,
          "end": 170.7
        },
        {
          "text": "Wegen eines Muskelrisses im Schultergelenk ihres linken Arms musste die 21 Jahre alte Amerikanerin das Turnier in der kommenden Woche absagen.",
          "start": 170.7,
          "end": 183.68
        },
        {
          "text": "Heute streben Frauen wieder nach weiblicheren Figuren mit schönen, aber straffen Kurven, wie eine schmale Talje.",
          "start": 183.68,
          "end": 194.52
        },
        {
          "text": "Die Form des Beckens ist zwischen Frauen und Männern sehr unterschiedlich.",
          "start": 194.52,
          "end": 201.92
        }
      ]
    }
