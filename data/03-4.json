    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Drucker funktioniert jetzt nicht mehr.",
          "start": 136.0,
          "end": 139.04
        },
        {
          "text": "Herr Müller, Telefon für Sie.",
          "start": 141.88,
          "end": 144.48
        },
        {
          "text": "Die Arbeit von Softwareentwicklern ist, Software zu entwickeln.",
          "start": 147.53,
          "end": 152.13
        },
        {
          "text": "Heute lesen wir nicht nur vom Papier, sondern auch vom Bildschirm.",
          "start": 155.1,
          "end": 160.06
        },
        {
          "text": "Man kann das Programm kostenlos herunterladen.",
          "start": 163.16,
          "end": 167.16
        },
        {
          "text": "Alle Bücherregale sind ausgeräumt.",
          "start": 169.71,
          "end": 172.95
        },
        {
          "text": "Dieser Computerstuhl passt sehr gut zu diesem Computertisch.",
          "start": 175.53,
          "end": 179.99
        },
        {
          "text": "Sie stand vom Stuhl auf und rauschte wütend aus dem Zimmer.",
          "start": 182.98,
          "end": 187.3
        },
        {
          "text": "Diese Schublade klemmt.",
          "start": 190.46,
          "end": 192.16
        },
        {
          "text": "Ich kann sie nicht herausziehen.",
          "start": 192.3,
          "end": 194.2
        },
        {
          "text": "Stell bitte den Tisch wieder an seinen Platz zurück.",
          "start": 197.28,
          "end": 201.0
        },
        {
          "text": "Das Handbuch enthält viele gute Tipps zum Umgang mit den Fremden.",
          "start": 204.24,
          "end": 209.32
        },
        {
          "text": "Diese Hausarbeit erzählt einen ganzen Roman.",
          "start": 212.56,
          "end": 215.98
        },
        {
          "text": "Er ist ein lebendes Wörterbuch.",
          "start": 219.14,
          "end": 221.6
        },
        {
          "text": "Kannst du mir dabei helfen, den Bleistift anzuspitzen?",
          "start": 224.66,
          "end": 228.22
        },
        {
          "text": "Der Füller schreibt schlecht.",
          "start": 231.25,
          "end": 233.17
        },
        {
          "text": "Reich mir mal den Kulli.",
          "start": 236.38,
          "end": 238.44
        },
        {
          "text": "Auf dem Tisch liegen zwei Bücher, ein Notizbuch und ein Radiogummi.",
          "start": 240.84,
          "end": 246.38
        },
        {
          "text": "Das Loch im Fenster wird mit einem Papier zugeklebt.",
          "start": 249.53,
          "end": 253.63
        }
      ]
    }
