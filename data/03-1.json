    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Backofen und Herd sind in Deutschland wichtige Bestandteile jeder Küche.",
          "start": 126.76,
          "end": 132.68
        },
        {
          "text": "Man kann Eier in der Pfanne braten.",
          "start": 135.33,
          "end": 138.55
        },
        {
          "text": "Jeder Topf findet seinen Deckel.",
          "start": 141.15,
          "end": 143.83
        },
        {
          "text": "Wenn man Essstäbchen gekreuzt ablegt, wird es Unglück bringen.",
          "start": 146.56,
          "end": 151.56
        },
        {
          "text": "Wenn ein Deutscher Besteck sagt, meint er Gabel, Löffel und Messer.",
          "start": 153.86,
          "end": 159.94
        },
        {
          "text": "Er hat die Suppe mit dem Löffel gegessen.",
          "start": 162.96,
          "end": 165.64
        },
        {
          "text": "Das Messer schneidet sehr scharf.",
          "start": 168.82,
          "end": 170.97
        },
        {
          "text": "Bereite bitte das Blech für den Kuchen vor.",
          "start": 174.35,
          "end": 177.11
        },
        {
          "text": "In diese Kanne passen 1,8 Liter.",
          "start": 180.2,
          "end": 183.1
        },
        {
          "text": "Der Krug geht so lange zum Wasser, bis er bricht.",
          "start": 186.31,
          "end": 190.25
        },
        {
          "text": "Marie schabte den Reis aus der Schüssel.",
          "start": 193.03,
          "end": 195.65
        },
        {
          "text": "Könnten Sie mir bitte einen der Becher da rüberreichen?",
          "start": 198.02,
          "end": 201.82
        },
        {
          "text": "Mein Kollege hat ein Glas über den Durst getrunken und ist in den Tiefschlaf geraten.",
          "start": 204.98,
          "end": 210.84
        }
      ]
    }
