    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Ich finde diesen Mann charmant und intelligent.",
          "start": 140.52,
          "end": 143.62
        },
        {
          "text": "Gut aussehende Männer sind leider oft schlechte Liebhaber.",
          "start": 146.86,
          "end": 150.7
        },
        {
          "text": "Das ist nicht hübsch von Ihnen.",
          "start": 153.42,
          "end": 155.32
        },
        {
          "text": "Er geht mit seiner Frau durch dick und dünn.",
          "start": 158.3,
          "end": 161.64
        },
        {
          "text": "Ich habe heute fleischige Kirschen gekauft.",
          "start": 164.02,
          "end": 166.94
        },
        {
          "text": "Im Barock galten mollige Frauen als besonders schön.",
          "start": 169.96,
          "end": 173.68
        },
        {
          "text": "Das ist ein kleiner, stämmiger Kerl.",
          "start": 176.49,
          "end": 179.7
        },
        {
          "text": "Durch die lange Krankheit ist sie sehr knochig geworden.",
          "start": 182.16,
          "end": 185.68
        },
        {
          "text": "Mein Freund hat eine sportliche Figur.",
          "start": 188.82,
          "end": 191.52
        },
        {
          "text": "Mein Vater wird allmählich kahl.",
          "start": 194.46,
          "end": 197.22
        },
        {
          "text": "Meine Mutter hilft mir dabei, meine Haare in den Zopf zu flechten.",
          "start": 200.05,
          "end": 204.11
        },
        {
          "text": "Das milde Gesichtswasser ist geeignet für die empfindliche Haut.",
          "start": 207.35,
          "end": 211.51
        },
        {
          "text": "Tausend Falten durchziehen das Gesicht dieser alten Frau.",
          "start": 214.74,
          "end": 218.54
        },
        {
          "text": "Mein Bruder hat einen Tiger in seinem Arm tätowiert.",
          "start": 221.61,
          "end": 225.04
        },
        {
          "text": "Das ist so hässlich wie die Sünde.",
          "start": 228.14,
          "end": 230.18
        }
