    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Blitz hat in den Baum eingeschlagen.",
          "start": 136.63,
          "end": 139.23
        },
        {
          "text": "Es blitzt und donnert.",
          "start": 142.33,
          "end": 144.67
        },
        {
          "text": "Der Donner rollt.",
          "start": 147.12,
          "end": 148.68
        },
        {
          "text": "Der Regenbogen ist allmählich verschwunden.",
          "start": 151.46,
          "end": 154.86
        },
        {
          "text": "Wolken stehen am Himmel.",
          "start": 157.64,
          "end": 159.48
        },
        {
          "text": "Der Wetterbericht hat gewittrige Schauer vorhergesagt.",
          "start": 162.28,
          "end": 166.1
        },
        {
          "text": "Im Wetterbericht stand, es bleibe jetzt eine ganze Weile sonnig und warm.",
          "start": 169.1,
          "end": 174.04
        },
        {
          "text": "Nach dem Gewitter war die Luft erquickend.",
          "start": 176.28,
          "end": 179.59
        },
        {
          "text": "Ein leichter Nebel lagert über dem See.",
          "start": 183.17,
          "end": 185.97
        },
        {
          "text": "Es hat gestern nur getröpfelt.",
          "start": 188.99,
          "end": 191.05
        },
        {
          "text": "Es regnet in Strömen.",
          "start": 194.07,
          "end": 196.19
        },
        {
          "text": "Sprühregen kommt vor allem in den Subtropen, in den Tropen und in den gemäßigten Breiten vor.",
          "start": 199.39,
          "end": 206.13
        },
        {
          "text": "Es friert Stein und Bein.",
          "start": 209.04,
          "end": 211.21
        },
        {
          "text": "Der Frost steckt noch im Boden.",
          "start": 214.2,
          "end": 216.42
        },
        {
          "text": "Einer der schwersten Schneestürme seit vielen Jahren hat die US-Ostküste getroffen.",
          "start": 218.75,
          "end": 225.57
        },
        {
          "text": "Es hat aufgehört zu schneien.",
          "start": 228.69,
          "end": 230.73
        },
        {
          "text": "Der Himmel bedeckte sich mit Wolken.",
          "start": 233.64,
          "end": 236.4
        },
        {
          "text": "Vom Meer her wehte eine Brise.",
          "start": 239.14,
          "end": 241.42
        },
        {
          "text": "Ein Hurikan ist ein tropischer Wirbelsturm.",
          "start": 244.47,
          "end": 247.89
        },
        {
          "text": "Monsune ändern alle halben Jahre ihre Richtung.",
          "start": 250.68,
          "end": 253.84
        },
        {
          "text": "Vor allem im Herbst und Winter brausen Orkane über West- und Mitteleuropa.",
          "start": 256.21,
          "end": 261.21
        },
        {
          "text": "Am Nordpol gibt es keinen Typhoon.",
          "start": 261.21,
          "end": 267.02
        }
      ]
    }
