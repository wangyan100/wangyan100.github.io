    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das Ticket kann nach Einlasszeit nicht mehr umgetauscht werden.",
          "start": 128.71,
          "end": 132.91
        },
        {
          "text": "Alle Eintrittskarten sind weg und die Kassen bleiben am Abend geschlossen.",
          "start": 136.02,
          "end": 140.68
        },
        {
          "text": "Der reguläre Eintrittspreis gilt für Erwachsene.",
          "start": 143.72,
          "end": 147.24
        },
        {
          "text": "So etwas kommt in den besten Familien vor.",
          "start": 150.26,
          "end": 153.34
        },
        {
          "text": "Das Unternehmen geht vom Senior auf den Junior über.",
          "start": 156.3,
          "end": 160.28
        },
        {
          "text": "Gegen Vorlage des Ausweises erhalten die Gäste mit Behinderung einen reduzierten Eintrittspreis.",
          "start": 162.49,
          "end": 170.29
        },
        {
          "text": "Die Gedanken fahren in ihrem Kopf Karussell.",
          "start": 173.2,
          "end": 176.22
        },
        {
          "text": "Die Natur findet keinen Ausweg aus dem Labyrinthe der verworrenen und widersprechenden Kräfte.",
          "start": 179.17,
          "end": 186.07
        },
        {
          "text": "Und der Menschen muss sterben.",
          "start": 186.63,
          "end": 188.51
        },
        {
          "text": "Die Leiden des jungen Werther.",
          "start": 188.97,
          "end": 191.25
        },
        {
          "text": "Riesenrad ist mir zu langweilig.",
          "start": 193.89,
          "end": 196.23
        },
        {
          "text": "Das Grillen im Freizeitpark ist untersagt.",
          "start": 198.47,
          "end": 202.41
        },
        {
          "text": "Die Armee bringt sich in Sicherheit.",
          "start": 205.54,
          "end": 207.6
        },
        {
          "text": "Vorsicht Stufe!",
          "start": 210.79,
          "end": 212.25
        },
        {
          "text": "Gibt es in dem Shop Souvenirs zu kaufen?",
          "start": 215.03,
          "end": 217.37
        }
      ]
    }
