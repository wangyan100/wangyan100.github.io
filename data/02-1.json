    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Wenn Oscar zum Dessert den Brandy aus dem Schrank holt, sind die Gäste glücklich.",
          "start": 124.2,
          "end": 130.08
        },
        {
          "text": "Der Mindestalkoholgehalt von deutscher Weinbrand ist 38%.",
          "start": 132.36,
          "end": 139.64
        },
        {
          "text": "Cognac darf seinen Namen nur tragen, wenn er aus der gleichnamigen Region im Südwesten Frankreichs stammt.",
          "start": 142.1,
          "end": 150.24
        },
        {
          "text": "Grappa ist ein Tristerbrand, der aus Italien oder der italienischen Schweiz stammt.",
          "start": 153.02,
          "end": 159.28
        },
        {
          "text": "Einen alkoholischen Brand kann man in Kornbrand oder Obstbrand unterscheiden.",
          "start": 161.97,
          "end": 167.53
        },
        {
          "text": "Vogelbärbrand haben einen fruchtigen Geschmack.",
          "start": 169.9,
          "end": 174.8
        },
        {
          "text": "Im Gegensatz zum Obstbrand werden für den Obstgeist Früchte mit geringem Zuckeranteil verwendet.",
          "start": 177.47,
          "end": 185.31
        },
        {
          "text": "Sake enthält 15 oder mehr Volumenprozent Alkohol und wird heiß oder kalt serviert.",
          "start": 188.07,
          "end": 195.33
        },
        {
          "text": "Es ist alles andere als einfach, in Deutschland eine Erlaubnis zum Brennen von hochprozentigen Obstlern oder Likören zu erhalten.",
          "start": 197.63,
          "end": 207.35
        },
        {
          "text": "Vermut wird normalerweise als Aperitif getrunken.",
          "start": 210.69,
          "end": 214.05
        },
        {
          "text": "Enzian wird aus der Wurzel des gelben Enzians gebrannt.",
          "start": 217.39,
          "end": 221.89
        },
        {
          "text": "Raki ist ein türkischer Brandwein und wird in der Regel beim Genuss mit Wasser verdünnt.",
          "start": 225.09,
          "end": 231.03
        }
      ]
    }
