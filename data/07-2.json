    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Sportler war heute mächtig aufgedreht.",
          "start": 115.12,
          "end": 118.68
        },
        {
          "text": "Das Publikum hat dem Künstler begeistert Beifall gespendet.",
          "start": 121.26,
          "end": 125.46
        },
        {
          "text": "Aperitiv regt den Appetit an.",
          "start": 128.6,
          "end": 131.44
        },
        {
          "text": "Er konnte seine Erregung nicht mehr verbergen.",
          "start": 134.32,
          "end": 137.36
        },
        {
          "text": "Ihre Art zu reden hat uns alle schockiert.",
          "start": 140.49,
          "end": 143.47
        },
        {
          "text": "Der tödliche Unfall löste große Bestürzung aus.",
          "start": 146.46,
          "end": 150.46
        },
        {
          "text": "Sie war so verblüfft, dass sie nichts zu sagen wusste.",
          "start": 153.5,
          "end": 157.1
        },
        {
          "text": "Ich staunte über den Reichtum seiner Kenntnisse.",
          "start": 159.9,
          "end": 163.28
        },
        {
          "text": "Der Krieg in Syrien hat die ganze Welt erschüttert.",
          "start": 166.4,
          "end": 169.58
        },
        {
          "text": "Er erstaunte mich durch seine Leistungen.",
          "start": 172.49,
          "end": 174.91
        },
        {
          "text": "Sein schlechtes Benehmen wundert seine Eltern sehr.",
          "start": 178.02,
          "end": 181.06
        },
        {
          "text": "Auf wunderbare Weise wurde er wieder gesund.",
          "start": 184.06,
          "end": 186.92
        },
        {
          "text": "Das ist aber eine Überraschung.",
          "start": 189.95,
          "end": 191.69
        },
        {
          "text": "Das Problem wurde auf überraschende Weise gelöst.",
          "start": 194.77,
          "end": 197.85
        },
        {
          "text": "Der Urlaub war unglaublich schnell vorbei.",
          "start": 200.87,
          "end": 203.41
        },
        {
          "text": "Heute verhält er sich merkwürdig.",
          "start": 205.75,
          "end": 208.71
        },
        {
          "text": "Was ist daran so sonderbar?",
          "start": 211.66,
          "end": 213.32
        }
      ]
    }
