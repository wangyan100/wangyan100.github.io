    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Bereits seit vorgeschichtlichen Zeiten wird Bernstein als Schmuck und für Kunstgegenstände genutzt.",
          "start": 125.93,
          "end": 134.05
        },
        {
          "text": "Rubine sind auf allen Kontinenten außer der Antarktis gefunden worden.",
          "start": 136.89,
          "end": 141.89
        },
        {
          "text": "Iran ist schon seit Jahrhunderten eines der Hauptabbau- und Handelsgebiete von Türkis.",
          "start": 145.06,
          "end": 150.26
        },
        {
          "text": "Nach Angaben des Statistischen Jahrbuchs 2014, der OECD, lag der Anteil der Atomenergie weltweit bei etwa 12 Prozent.",
          "start": 150.26,
          "end": 164.14
        },
        {
          "text": "In Deutschland gibt es etwa 160 touristische Ziele, die mit sogenannten erneuerbaren Energien möglich sind.",
          "start": 164.14,
          "end": 175.47
        },
        {
          "text": "In Atomkraftwerken wird die Energie der Kernspaltung benutzt, um Wärmeenergie zu erzeugen.",
          "start": 175.47,
          "end": 185.4
        },
        {
          "text": "Aluminium reagiert an frischen angeschnittenen Stellen bei Raumtemperatur mit Luft und Wasser zu Aluminiumoxid.",
          "start": 185.4,
          "end": 195.39
        },
        {
          "text": "Man muss das Eisen schmieden, solange es heiß ist.",
          "start": 195.39,
          "end": 202.99
        },
        {
          "text": "Magnesium brennt mit blendend weißer Flamme.",
          "start": 202.99,
          "end": 209.24
        },
        {
          "text": "Die 10-, 20- und 50-Euro-Cent-Münzen bestehen aus einer Legierung aus Kupfer, Aluminium, Zink und Zinn.",
          "start": 209.24,
          "end": 220.98
        },
        {
          "text": "Sonnenflecken sind dunkle Stellen auf der sichtbaren Sonnenoberfläche, die kühler sind.",
          "start": 220.98,
          "end": 229.78
        },
        {
          "text": "Basalt ist für gewöhnlich dunkelgrau oder schwarz.",
          "start": 229.78,
          "end": 236.44
        }
      ]
    }
