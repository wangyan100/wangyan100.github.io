    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Bienen saugen den Honig aus den Blüten.",
          "start": 128.56,
          "end": 132.04
        },
        {
          "text": "Puderzucker wird durch Mahlen von raffiniertem weißem Zucker gewonnen.",
          "start": 134.35,
          "end": 140.69
        },
        {
          "text": "Ich trinke meinen Kaffee immer mit Zucker.",
          "start": 143.32,
          "end": 146.12
        },
        {
          "text": "Salz lässt unsere Speisen weniger fadisch schmecken und wird als das weiße Gold bezeichnet.",
          "start": 149.32,
          "end": 156.18
        },
        {
          "text": "Sojasoße ist eine asiatische Würzsoße.",
          "start": 159.39,
          "end": 163.07
        },
        {
          "text": "Sie richtet Salat mit Essig und Olivenöl an.",
          "start": 166.04,
          "end": 170.04
        },
        {
          "text": "Pfeffer schmeckt scharf.",
          "start": 172.89,
          "end": 174.81
        },
        {
          "text": "Viele italienische Gerichte, wie zum Beispiel Tomatensauce, Pasta, Pesto oder Pizza, sind ohne Basilikum kaum vorstellbar.",
          "start": 177.43,
          "end": 189.49
        },
        {
          "text": "Minzen sind aromatische und ausdauernde krautige Pflanzen.",
          "start": 192.65,
          "end": 197.07
        },
        {
          "text": "Die Petersilie ist eine gebräuchliche Zutat.",
          "start": 200.3,
          "end": 203.86
        },
        {
          "text": "Der Salbei ist eines der ältesten Heilkräuter.",
          "start": 206.74,
          "end": 210.28
        },
        {
          "text": "Im Europa des 16. bis 18.",
          "start": 213.14,
          "end": 216.22
        },
        {
          "text": "Jahrhunderts galt Zimt als eines der besonders teuren Gewürze.",
          "start": 216.72,
          "end": 221.26
        },
        {
          "text": "Béchamelsoße ist eine helle Soße aus Milch, Butter und Mehl, die bei der Zubereitung vieler Gerichte verwendet wird.",
          "start": 224.94,
          "end": 233.1
        }
      ]
    }
