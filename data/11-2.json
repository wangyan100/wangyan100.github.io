    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Monat Februar umfasst in Gemeinjahren 28 Tage und in Schaltjahren 29 Tage.",
          "start": 100.52,
          "end": 108.04
        },
        {
          "text": "Zwischen Januar 2016 und März 2019 seien in der EU mehr als 44.000 Fälle der hoch ansteckenden Infektionskrankheit gemeldet worden, teilte die Behörde mit.",
          "start": 110.44,
          "end": 126.18
        },
        {
          "text": "Die Europäische Union will möglichst bis Ende Juni einen neuen Kommissionspräsidenten auswählen.",
          "start": 129.18,
          "end": 136.2
        },
        {
          "text": "Das letzte schwere Erdbeben wurde in Peru am 15.",
          "start": 138.44,
          "end": 143.68
        },
        {
          "text": "August 2007 registriert.",
          "start": 143.9,
          "end": 146.64
        },
        {
          "text": "Die Legislaturperiode hat am 24.",
          "start": 149.68,
          "end": 152.84
        },
        {
          "text": "September 2017 begonnen und wird bis zum Herbst 2021 dauern.",
          "start": 153.08,
          "end": 159.6
        },
        {
          "text": "Der 22.",
          "start": 162.5,
          "end": 163.66
        },
        {
          "text": "Dezember ist auf der Nordhalbkugel der kürzeste Tag im Jahr, die Nacht ist die längste.",
          "start": 163.92,
          "end": 170.02
        },
        {
          "text": "Am kommenden Montag wird sie ihren Rücktritt als Vorsitzende der SPD erklären.",
          "start": 172.26,
          "end": 178.32
        },
        {
          "text": "Der Dienstag gilt in der griechischen Kultur als Unglückstag.",
          "start": 181.4,
          "end": 185.72
        },
        {
          "text": "Am Sonntag klettern die Temperaturen laut deutschem Wetterdienst gar auf bis zu 32 Grad.",
          "start": 188.84,
          "end": 195.42
        },
        {
          "text": "China ist die aufstrebende Großmacht des 21.",
          "start": 198.56,
          "end": 202.34
        },
        {
          "text": "Jahrhunderts.",
          "start": 202.8,
          "end": 203.25
        },
        {
          "text": "Im kolonialen Zeitalter wurde das Reich der Mitte vom Westen ausgebeutet und gedemütigt.",
          "start": 206.28,
          "end": 213.38
        },
        {
          "text": "Diese Familie ist gestern gekommen, bleibt heute und morgen und fährt übermorgen weiter.",
          "start": 216.35,
          "end": 222.31
        }
      ]
    }
