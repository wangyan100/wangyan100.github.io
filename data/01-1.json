    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Apfel fällt nicht weit vom Stamm.",
          "start": 142.76,
          "end": 147.52
        },
        {
          "text": "Mit 200 Gramm Erdbeeren ist der Tagesbedarf eines Erwachsenen an Vitamin C abgedeckt.",
          "start": 149.98,
          "end": 158.32
        },
        {
          "text": "Die ursprüngliche Heimat des Pfirsichs ist China.",
          "start": 160.65,
          "end": 165.33
        },
        {
          "text": "Die Ananas ist das ganze Jahr über erhältlich, aber von Mai bis August ist das Angebot geringer.",
          "start": 168.47,
          "end": 177.05
        },
        {
          "text": "Angeblich brachte Alexander der Große die Aprikose in den Mittelmeerraum.",
          "start": 180.02,
          "end": 186.04
        },
        {
          "text": "Der Durchschnittsbürger verzehrt in Deutschland pro Jahr ca. 12 kg Bananen.",
          "start": 189.14,
          "end": 196.62
        },
        {
          "text": "Die Stinkfrucht ist sowohl in China als auch in Deutschland ziemlich teuer.",
          "start": 198.96,
          "end": 206.38
        },
        {
          "text": "Die Schale der Zitrone ist gelb, kann grünlich oder orangen-gelb sein.",
          "start": 209.18,
          "end": 215.12
        },
        {
          "text": "Die Orange ist eine der beliebtesten Obstsorten der Deutschen.",
          "start": 218.3,
          "end": 222.8
        },
        {
          "text": "Avocados sind Hauptbestandteil des mexikanischen Guacamole-Dips.",
          "start": 225.11,
          "end": 232.25
        },
        {
          "text": "Wassermelonen eignen sich als Durstlöscher.",
          "start": 235.17,
          "end": 239.05
        },
        {
          "text": "Heute kann die Kirsche in allen gemäßigten Klimazonen der Welt angebaut werden.",
          "start": 241.77,
          "end": 247.79
        },
        {
          "text": "Trauben haben relativ viel Fruchtzucker und Fruchtsäuren.",
          "start": 250.94,
          "end": 255.64
        },
        {
          "text": "Die Kiwi hat viele Inhaltsstoffe, die dem menschlichen Körper helfen können.",
          "start": 257.88,
          "end": 263.96
        },
        {
          "text": "Die Passionsfrüchte sind im reifen Zustand gelb und glatt schalig.",
          "start": 267.12,
          "end": 272.58
        }
      ]
    }
