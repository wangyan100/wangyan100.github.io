    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Schwester.",
          "start": 152.6,
          "end": 153.38
        },
        {
          "text": "Diese rasche Minute war die glücklichste meiner Kindheit.",
          "start": 156.41,
          "end": 159.99
        },
        {
          "text": "In Deutschland gibt es rund 52.000 Kindergartenstätten. 1919 wurde Schulpflicht in der Weimarer Verfassung einheitlich für ganz Deutschland festgeschrieben.",
          "start": 162.99,
          "end": 178.51
        },
        {
          "text": "In den 80er Jahren ging sie zur Fortbildung nach Schweden.",
          "start": 181.5,
          "end": 185.54
        },
        {
          "text": "Die Weltgesundheitsorganisation definiert die Adoleszenz als die Periode des Lebens zwischen 10 und 20 Jahren.",
          "start": 188.52,
          "end": 197.48
        },
        {
          "text": "Eine Midlife-Krise bezeichnet ein persönliches Unwohlbefinden im mittleren Lebensabschnitt des Menschen.",
          "start": 200.6,
          "end": 208.06
        },
        {
          "text": "Wechseljahre entwickelt sich über längere Zeit hinweg und ist mit einem Rückgang der Hormonbildung verbunden.",
          "start": 211.24,
          "end": 218.36
        },
        {
          "text": "Viele soziale Faktoren wie schwierige Lebensumstände, Arbeitslosigkeit, all das seien Risikofaktoren, die zu Selbstmord führen können.",
          "start": 221.44,
          "end": 234.23
        },
        {
          "text": "Ich spazierte zum Friedhof und verbrachte die Zeit damit, die Inschriften auf den Grabsteinen zu lesen.",
          "start": 237.33,
          "end": 244.55
        },
        {
          "text": "Die Zahl der Alleinerziehenden in Deutschland steigt.",
          "start": 247.19,
          "end": 250.87
        },
        {
          "text": "Regenbogenfamilien werden Familien genannt, bei denen Kinder bei zwei gleichgeschlechtlichen Partnern als eine Familie leben.",
          "start": 254.54,
          "end": 262.2
        }
      ]
    }
