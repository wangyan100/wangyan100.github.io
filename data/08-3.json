    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "1940 fuhr kaum jemand Auto und der CO2-Ausstoß war minimal.",
          "start": 138.66,
          "end": 143.98
        },
        {
          "text": "Künftig sollen dort die Geländewagen gebaut werden.",
          "start": 147.01,
          "end": 150.33
        },
        {
          "text": "Der junge aus dem Armenviertel fuhr nun in Limousinen durch die Stadt.",
          "start": 153.39,
          "end": 158.05
        },
        {
          "text": "Auf dem Weg nach Italien ist ein deutscher Reisebus verunglückt.",
          "start": 161.02,
          "end": 165.1
        },
        {
          "text": "Ein 85-jähriger Autofahrer ist mit seinem Sportwagen in ein Hamburger Kaufhaus gekracht.",
          "start": 167.37,
          "end": 174.47
        },
        {
          "text": "In der Ferienzeit kontrolliert die Polizei in Hessen gezielt Wohnwagen auf der Autobahn.",
          "start": 177.5,
          "end": 183.58
        },
        {
          "text": "Der Lagerarbeiter stiehlt vor den Augen seiner Chefin einen Lieferwagen.",
          "start": 185.79,
          "end": 191.35
        },
        {
          "text": "Ein Kran hebt die Container auf das Schiff.",
          "start": 194.52,
          "end": 197.88
        },
        {
          "text": "Das Bremspedal kann zum schnellen Abbremsen und zur Feststellbremse benutzt werden.",
          "start": 200.31,
          "end": 206.21
        },
        {
          "text": "Das Gaspedal ist rechts und die Bremse links.",
          "start": 208.45,
          "end": 212.39
        },
        {
          "text": "Außenspiegel auf beiden Seiten bieten beim Rückwärtsfahren gute Sicht.",
          "start": 215.67,
          "end": 220.07
        },
        {
          "text": "Der Druck der Reifen muss regelmäßig überprüft werden.",
          "start": 223.16,
          "end": 226.86
        },
        {
          "text": "Warnleuchte blinkt auf dem Armaturenbrett des Autos.",
          "start": 230.22,
          "end": 234.06
        },
        {
          "text": "Der Drehzahlmesser zeigt die Motordrehzahl in Umdrehungen pro Minute an.",
          "start": 237.06,
          "end": 242.68
        }
      ]
    }
