    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Seine Eltern und eine Tante starben in Konzentrationslagern.",
          "start": 143.6,
          "end": 148.2
        },
        {
          "text": "Die Kinder hängen der Mutter immer am Rockzipfel.",
          "start": 151.18,
          "end": 154.32
        },
        {
          "text": "Tag der Väter wird als Pendant zum Muttertag gesehen und hat sich erst später etabliert.",
          "start": 157.31,
          "end": 164.15
        },
        {
          "text": "Das Motiv der Stiefmutter wird in Märchen häufig verwendet.",
          "start": 167.12,
          "end": 171.68
        },
        {
          "text": "Die Großmütter verbringen fast ihre gesamte Zeit mit den Enkeln.",
          "start": 173.98,
          "end": 179.02
        },
        {
          "text": "Sie hatte den Großvater sehr gerne und war stolz auf ihn.",
          "start": 182.1,
          "end": 185.84
        },
        {
          "text": "Wie hat sich die sportliche Mode seit der Zeit unserer Urgroßeltern bis in die Gegenwart entwickelt?",
          "start": 188.86,
          "end": 195.28
        },
        {
          "text": "Zuvor spielte er gern Fußball wie sein älterer Bruder.",
          "start": 198.52,
          "end": 202.2
        },
        {
          "text": "Sehr herzlich grüße ich alle Brüder und Schwestern aus dem deutschen Sprachraum.",
          "start": 205.31,
          "end": 210.31
        },
        {
          "text": "Die Polizei fahndet nach einem Mann, der seinen achtjährigen Stiefsohn schwer misshandelt haben soll.",
          "start": 213.13,
          "end": 220.27
        },
        {
          "text": "Busches Tochter heiratet Anfang Mai.",
          "start": 223.44,
          "end": 226.14
        },
        {
          "text": "Die Neffen sind Söhne von eigenen Geschwisterteilen.",
          "start": 229.22,
          "end": 232.86
        },
        {
          "text": "Nach den eigenen Zwillingen möchte die Schauspielerin weder einen Sohn oder ein Töchterchen adoptieren.",
          "start": 235.9,
          "end": 242.4
        },
        {
          "text": "Ich bin bei Pflegeeltern aufgewachsen.",
          "start": 245.44,
          "end": 248.12
        }
      ]
    }
  ]
