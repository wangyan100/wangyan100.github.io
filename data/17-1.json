    },
    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Sein anmaßendes Verhalten bringt ihm keine Freunde.",
          "start": 134.04,
          "end": 137.78
        },
        {
          "text": "Der Bürgermeister wird als egoistisch kritisiert.",
          "start": 140.91,
          "end": 144.25
        },
        {
          "text": "In ganz Europa erleben immer mehr Wähler die traditionellen politischen Parteien als eignützig und machthungrig.",
          "start": 147.3,
          "end": 155.68
        },
        {
          "text": "Meine Tante war ein böser Mensch und sie war sehr geizig.",
          "start": 158.73,
          "end": 162.69
        },
        {
          "text": "Heute war meine Lehrerin wieder launisch.",
          "start": 165.69,
          "end": 168.21
        },
        {
          "text": "Er war sehr professionell bei der Verwaltung der Firma und auch sehr humorvoll.",
          "start": 171.18,
          "end": 176.28
        },
        {
          "text": "Meine jüngere Schwester hat ein lebhaftes Wesen.",
          "start": 179.27,
          "end": 182.41
        },
        {
          "text": "Wenn jemand schlau, listig und zugleich ein bisschen hinterhältig ist, wird er oft Schlitzohr genannt.",
          "start": 185.48,
          "end": 192.76
        },
        {
          "text": "So ein raffiniertes Aas!",
          "start": 195.7,
          "end": 198.06
        },
        {
          "text": "Er nahm den roten Bogen, brachte die weißen Pfeile und schoss nach den arroganten Sonnen.",
          "start": 200.76,
          "end": 207.1
        },
        {
          "text": "Er war ein störrischer, eigensinniger Junge.",
          "start": 209.84,
          "end": 212.82
        },
        {
          "text": "Du fliegst gleich raus, wenn du dich nicht anständig benimmst.",
          "start": 215.6,
          "end": 219.79
        },
        {
          "text": "Ihm kannst du vertrauen, er ist ein ehrlicher Mann.",
          "start": 222.68,
          "end": 225.56
        },
        {
          "text": "Er führt jeden Auftrag gewissenhaft aus.",
          "start": 228.65,
          "end": 231.49
        },
        {
          "text": "Man kann gar nicht vorsichtig genug sein.",
          "start": 234.58,
          "end": 236.96
        }
      ]
    }
  ]
}
