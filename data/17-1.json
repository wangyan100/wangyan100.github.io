          "end": 26.33
        },
        {
          "text": "unempfindlich gescheit",
          "start": 26.33,
          "end": 31.42
        },
        {
          "text": "humorvoll klug",
          "start": 32.76,
          "end": 37.11
        },
        {
          "text": "lebhaft munter",
          "start": 38.36,
          "end": 42.83
        },
        {
          "text": "positiv selbstbewusst",
          "start": 44.17,
          "end": 49.12
        },
        {
          "text": "witzig heuchlerisch hinterlistig",
          "start": 50.37,
          "end": 59.33
        },
        {
          "text": "listig raffiniert",
          "start": 59.33,
          "end": 63.79
        },
        {
          "text": "schamlos unbeständig",
          "start": 65.17,
          "end": 70.07
        },
        {
          "text": "unehrlich verschlagen",
