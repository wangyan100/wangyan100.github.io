    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die weiße Bluse muss unbedingt schnell gebügelt werden.",
          "start": 119.54,
          "end": 123.92
        },
        {
          "text": "Deine Polobluse ist schick und sehr modern.",
          "start": 126.28,
          "end": 130.16
        },
        {
          "text": "Heute trägt die Lehrerin eine kurzärmlige Reversebluse.",
          "start": 133.39,
          "end": 136.84
        },
        {
          "text": "Die Sommerbluse ist schon ganz ausgewaschen.",
          "start": 140.59,
          "end": 143.08
        },
        {
          "text": "Wer seinen Bauch verbergen will, greift zur Tunika.",
          "start": 146.66,
          "end": 150.28
        },
        {
          "text": "Im schlichten hellblauen Businesshemd steht er in einer Ecke des Konferenzraums.",
          "start": 153.4,
          "end": 159.0
        },
        {
          "text": "Trainer lockerte seinen Krawattenknoten.",
          "start": 162.09,
          "end": 164.02
        },
        {
          "text": "Der Blazer wird sowohl zu Hose als auch Rock passen.",
          "start": 167.42,
          "end": 172.26
        },
        {
          "text": "Bekleidet ist Tatverdächtiger mit einem schwarzen Mantel mit einer Kapuze, wie die Polizei mitteilte.",
          "start": 174.78,
          "end": 180.96
        },
        {
          "text": "Es hat begonnen zu regnen.",
          "start": 184.51,
          "end": 186.29
        },
        {
          "text": "Die ältere Frau zieht ihren blauen Trenchcoat enger.",
          "start": 186.67,
          "end": 190.59
        },
        {
          "text": "Genau wie seine Mama trägt der Junge auch ein Ringelshirt.",
          "start": 193.11,
          "end": 196.79
        },
        {
          "text": "Er zieht seinen Anorak an und bringt mich zum Bahnhof zurück.",
          "start": 199.76,
          "end": 203.6
        },
        {
          "text": "Die Hände versteckt er in den Taschen seiner schwarzen Lederjacke.",
          "start": 205.87,
          "end": 210.09
        },
        {
          "text": "Wer den Polarkreis im Juni besucht, braucht eine spezielle Garderobe, bestehend aus Wollmütze, Daunenjacke und langer Unterwäsche.",
          "start": 213.67,
          "end": 222.83
        }
      ]
    }
