    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Sonne scheint, der Himmel ist blau, der Wald ist grün.",
          "start": 130.53,
          "end": 135.47
        },
        {
          "text": "Das Wasser glasklar in allen Schattierungen von blau und türkis ist ruhig.",
          "start": 138.58,
          "end": 144.58
        },
        {
          "text": "Das blaue Haus ist inzwischen weiß und beige gestrichen.",
          "start": 147.24,
          "end": 150.74
        },
        {
          "text": "Hast du ein azurblaues Näpfchen in deinem Farbkasten?",
          "start": 154.17,
          "end": 157.85
        },
        {
          "text": "Hinter dem Baum liegen rosa und lila Ostereier.",
          "start": 160.28,
          "end": 164.28
        },
        {
          "text": "Die stark duftenden Blüten sind außen hellgelb, im Inneren purpuren gestreift.",
          "start": 167.9,
          "end": 173.72
        },
        {
          "text": "Das Fett ist strahlend weiß bis leicht gelblich.",
          "start": 176.69,
          "end": 180.21
        },
        {
          "text": "Das waren goldene Tage.",
          "start": 183.18,
          "end": 184.96
        },
        {
          "text": "Später wurden die Uniformen khakifarbig mit etwas grün gewechselt.",
          "start": 188.34,
          "end": 192.74
        },
        {
          "text": "Sie sollten auch gleich noch dieses pinke Kleid anprobieren.",
          "start": 196.21,
          "end": 200.05
        },
        {
          "text": "Die Farbe wechselt von grau bis silbern, über graugrün bis dunkelweinrot.",
          "start": 202.32,
          "end": 208.58
        },
        {
          "text": "Der Sand ist fein und fasst schneeweiß.",
          "start": 211.73,
          "end": 214.71
        },
        {
          "text": "Er hat schon silberne Fäden im Haar.",
          "start": 217.66,
          "end": 219.91
        },
        {
          "text": "Die Blätter des Bärlauchs sind lindgrün, langgestielt.",
          "start": 222.96,
          "end": 227.12
        },
        {
          "text": "Ein wunderschöner, olivschimmernder Anzug für den Herrn sticht ins Auge.",
          "start": 230.28,
          "end": 234.88
        }
      ]
    }
