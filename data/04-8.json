    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Um die Semesterarbeit zu schreiben, muss ich in der Bibliothek recherchieren.",
          "start": 118.76,
          "end": 126.89
        },
        {
          "text": "Es ist verboten, Flugblätter auf der Straße zu verteilen.",
          "start": 129.88,
          "end": 134.16
        },
        {
          "text": "Das ist das letzte Heft dieser Zeitschrift.",
          "start": 137.06,
          "end": 139.94
        },
        {
          "text": "Kann ich die bestellten Bücher nach Hause mitnehmen?",
          "start": 142.91,
          "end": 145.93
        },
        {
          "text": "Beachten Sie, dass für vorgemerkte Medien keine Verlängerungen möglich sind.",
          "start": 149.07,
          "end": 154.35
        },
        {
          "text": "Jeder will jeden kopieren.",
          "start": 157.39,
          "end": 159.15
        },
        {
          "text": "Sie dürfen maximal dreimal die Leihfrist verlängern.",
          "start": 161.92,
          "end": 166.32
        },
        {
          "text": "Heute muss ich die geliehenen Bücher zurückgeben.",
          "start": 168.95,
          "end": 171.87
        },
        {
          "text": "Der Bestand unserer Bibliothek beträgt 100.000 Bände.",
          "start": 174.93,
          "end": 179.23
        },
        {
          "text": "Das ist ein alphabetischer Katalog einer Bibliothek.",
          "start": 182.2,
          "end": 186.44
        },
        {
          "text": "Mithilfe des Bibliothekskatalogs kann der Benutzer die Signatur des gesuchten Buches herausfinden.",
          "start": 188.95,
          "end": 195.71
        },
        {
          "text": "Es wurde verlangt, den Ausweis zu zeigen.",
          "start": 198.72,
          "end": 201.64
        },
        {
          "text": "Loggen Sie sich bitte mit der Nummer des Benutzungsausweises und folgendem Passwort ein.",
          "start": 204.59,
          "end": 210.47
        },
        {
          "text": "Das regnerische Wetter macht mich schläfrig.",
          "start": 213.55,
          "end": 216.39
        },
        {
          "text": "Ich interessiere mich für das Buch überhaupt nicht.",
          "start": 219.23,
          "end": 222.35
        }
      ]
    }
