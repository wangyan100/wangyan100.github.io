    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Bach rauscht, schlängelt sich durch das Tal.",
          "start": 134.83,
          "end": 138.25
        },
        {
          "text": "Das Wasser des Bächleins ist kristallklar und man kann kleine Fischchen im Wasser erkennen.",
          "start": 141.34,
          "end": 147.48
        },
        {
          "text": "Hier befindet sich der längste von Menschen geschaffene Kanal der Welt.",
          "start": 150.63,
          "end": 154.93
        },
        {
          "text": "Die Gezeiten werden von Erde, Mond und der Sonne bestimmt.",
          "start": 157.2,
          "end": 162.16
        },
        {
          "text": "Im Gegensatz zu einem natürlichen See kann der Wasserstand in einem Stausee stark schwanken.",
          "start": 165.26,
          "end": 171.44
        },
        {
          "text": "Landschaften mit sehr starken Ablagerungen nennt man Sedimentbecken.",
          "start": 174.9,
          "end": 179.7
        },
        {
          "text": "Das Wasser hat die Erde vom Ufer geschwemmt.",
          "start": 182.78,
          "end": 186.08
        },
        {
          "text": "Feuchtgebiete haben eine hohe Bedeutung für Ökologie, Klimaschutz und Hochwasserschutz.",
          "start": 189.18,
          "end": 194.42
        },
        {
          "text": "Mose haben sich vor etwa 400 bis 450 Millionen Jahren aus Grünalgen der Gezeitenzone entwickelt.",
          "start": 194.42,
          "end": 206.95
        },
        {
          "text": "Erdbeben können auch entstehen, wenn zwei kontinentale Platten frontal aufeinander prallen.",
          "start": 210.2,
          "end": 216.58
        },
        {
          "text": "Das heftigste bisher auf der Erde gemessene Erdbeben hatte eine Erdbebenstärke von 9,5 und ereignete sich 1960 in Chile.",
          "start": 219.64,
          "end": 230.18
        },
        {
          "text": "Im Sommer ist die Saison der Schlammlawinen.",
          "start": 232.42,
          "end": 236.22
        },
        {
          "text": "Im Jahr 2004 löste ein Seebeben vor Sumatra im Indischen Ozean einen gewaltigen Tsunami aus.",
          "start": 239.3,
          "end": 247.36
        }
      ]
    }
