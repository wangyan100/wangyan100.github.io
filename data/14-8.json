    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Elektrische Gesichtsbürsten können nicht nur die Haut gut reinigen, sondern den Teint zum Strahlen bringen und auch noch kleine Falten bekämpfen.",
          "start": 133.61,
          "end": 144.95
        },
        {
          "text": "Ursprünglich wurden Puderquasten in Form eines starken Pinsels aus Naturhaar gefertigt.",
          "start": 147.22,
          "end": 155.06
        },
        {
          "text": "Ein paar Tropfen auf ein Wattepad genügen, um auch wasserfesten Mascara sanft von den Wimpern reiben zu können.",
          "start": 158.17,
          "end": 166.45
        },
        {
          "text": "Bei empfindlicher Haut ist zur Pflege eine milde Reinigungsmilch oder ein alkoholfreies Gesichtswasser zu empfehlen.",
          "start": 169.48,
          "end": 178.14
        },
        {
          "text": "Die Reinigungsmilch wurde speziell für die besonderen Bedürfnisse der sensiblen Haut entwickelt.",
          "start": 180.35,
          "end": 187.73
        },
        {
          "text": "Du sollst deine Kinder daher auf jeden Fall auch mit Sonnencreme schützen, damit es zu keinem Sonnenbrand kommt.",
          "start": 190.86,
          "end": 198.1
        },
        {
          "text": "Abdeckstift zum Kaschieren von Hautunreinheiten und Rötungen gehört mittlerweile zum Standardrepertoire.",
          "start": 201.39,
          "end": 209.09
        },
        {
          "text": "Der Täter, der das Handy geraubt hatte, soll auffällig schwarzen Lidschatten getragen haben.",
          "start": 211.33,
          "end": 218.67
        },
        {
          "text": "Der Lippenstift hat sich sehr gut verkauft.",
          "start": 221.73,
          "end": 224.55
        },
        {
          "text": "Bei unproblematischer Haut reicht dazu eine normale Körperlotion.",
          "start": 227.6,
          "end": 232.72
        },
        {
          "text": "Nach jedem Waschen soll man die Hände mit einer dicken Schicht Handcreme versorgen und gut einmassieren.",
          "start": 235.85,
          "end": 242.99
        }
      ]
    }
