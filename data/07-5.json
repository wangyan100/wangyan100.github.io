    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das Kind war ihr lästig.",
          "start": 151.82,
          "end": 154.4
        },
        {
          "text": "Sein Benehmen missfällt seiner Frau.",
          "start": 157.12,
          "end": 159.6
        },
        {
          "text": "Das widerliche Klima macht mich unangenehm.",
          "start": 162.54,
          "end": 165.6
        },
        {
          "text": "Der ständige Lärm ist eine Zumutung für alle Mitbewohner.",
          "start": 168.47,
          "end": 172.27
        },
        {
          "text": "Der lange, beschäftigte Tag ohne Pause geht mir auf die Nerven.",
          "start": 174.51,
          "end": 179.61
        },
        {
          "text": "Das erregt meine Abneigung.",
          "start": 182.56,
          "end": 184.64
        },
        {
          "text": "Ich habe besonders ekel vor Ratten.",
          "start": 187.71,
          "end": 190.45
        },
        {
          "text": "Das Wetter ist wirklich ekelhaft.",
          "start": 193.37,
          "end": 195.65
        },
        {
          "text": "Dieser Geruch weckt widerwille.",
          "start": 198.72,
          "end": 200.82
        },
        {
          "text": "Der Lehrer sagte immer, dass der böse Junge ihm ein Dorn im Auge war.",
          "start": 203.94,
          "end": 208.5
        },
        {
          "text": "Er hat sich die Ungunst seines Leiters zugezogen.",
          "start": 211.57,
          "end": 214.93
        },
        {
          "text": "Krankheit verbittert die letzten Jahre seines Lebens.",
          "start": 218.1,
          "end": 221.6
        },
        {
          "text": "Die schweren Schicksalsschläge haben ihn verbittert.",
          "start": 224.64,
          "end": 228.4
        },
        {
          "text": "Sie macht ein unzufriedenes Gesicht.",
          "start": 231.14,
          "end": 233.42
        },
        {
          "text": "Heute klagen viele Leute über die hohen Preise.",
          "start": 236.62,
          "end": 239.86
        },
        {
          "text": "Die Schüler meckern mal wieder über die schwere Prüfung.",
          "start": 242.85,
          "end": 246.17
        },
        {
          "text": "Der Lehrer beschimpft den Schüler als dummkopf.",
          "start": 249.08,
          "end": 252.12
        },
        {
          "text": "Er kam mir sehr ungeschickt vor.",
          "start": 255.12,
          "end": 257.34
        }
      ]
