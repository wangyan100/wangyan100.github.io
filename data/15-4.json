    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Junge ist schlau wie ein Fuchs.",
          "start": 137.14,
          "end": 139.62
        },
        {
          "text": "Der Polarfuchs ist der einzige Wildhund, der die Farbe seines Pelzes den Jahreszeiten entsprechend wechselt.",
          "start": 142.64,
          "end": 150.68
        },
        {
          "text": "Die Bengalkatze wird wegen ihres Fels gejagt.",
          "start": 153.37,
          "end": 156.91
        },
        {
          "text": "Nach dem Mahl bedeckt Leopard seine Beutereste mit Gras, Zweigen oder Laub.",
          "start": 160.01,
          "end": 165.95
        },
        {
          "text": "Pumas sind sehr beweglich und kräftig.",
          "start": 168.32,
          "end": 172.12
        },
        {
          "text": "In Malaysia, Indonesien und Thailand werden Makaken zur Kokosnussernte eingesetzt.",
          "start": 174.94,
          "end": 181.56
        },
        {
          "text": "Beuteldax sind Allesfresser.",
          "start": 184.82,
          "end": 186.92
        },
        {
          "text": "Ihr Speiseplan reicht von Insekten über kleine Wirbeltiere bis zu pflanzlichem Material.",
          "start": 187.4,
          "end": 194.4
        },
        {
          "text": "Weibliche Beutelwölfe hatten einen geöffneten Beutel, der vier Zitzen enthielt.",
          "start": 197.63,
          "end": 203.41
        },
        {
          "text": "Kängurus springen mit den Hinterbeinen.",
          "start": 205.78,
          "end": 209.04
        },
        {
          "text": "Der Schwanz bleibt in der Luft und dient der Balance.",
          "start": 209.16,
          "end": 212.34
        },
        {
          "text": "Als nachtaktive Tiere besitzen Koalas ein gutes Hörvermögen.",
          "start": 215.72,
          "end": 220.14
        },
        {
          "text": "Erwachsene Wombats haben wenige natürliche Gegner.",
          "start": 223.58,
          "end": 227.54
        },
        {
          "text": "Ihr größter Fressfeind ist der Dingo.",
          "start": 228.0,
          "end": 230.72
        },
        {
          "text": "Natürliche Feinde der Fledermäuse sind vor allem Katzen und Greifvögel.",
          "start": 233.92,
          "end": 238.66
        },
        {
          "text": "Die Touristin setzte sich auf den Elefanten.",
          "start": 241.9,
          "end": 245.12
        },
        {
          "text": "Der Rüssel ist ein Multifunktionsorgan.",
          "start": 248.16,
          "end": 250.14
        }
      ]
    }
