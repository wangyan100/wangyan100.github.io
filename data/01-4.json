    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Er ist glatt wie ein Aal.",
          "start": 118.6,
          "end": 124.93
        },
        {
          "text": "In Australien ist das Züchten und Aussetzen von Karpfen gesetzlich verboten.",
          "start": 127.86,
          "end": 133.36
        },
        {
          "text": "In den letzten Jahrzehnten war der Stint kommerziell kaum von Bedeutung.",
          "start": 136.33,
          "end": 141.81
        },
        {
          "text": "Der Lachs kommt zum Leichen zurück in die Süßgewässer.",
          "start": 144.05,
          "end": 149.15
        },
        {
          "text": "Sardinen erstrecken sich vom nordöstlichen Atlantik und der Nordsee bis zum Senegal.",
          "start": 151.75,
          "end": 158.49
        },
        {
          "text": "Thunfische gehören wegen ihres roten, fetten Fleisches zu den wichtigsten Speisefischen.",
          "start": 161.23,
          "end": 167.75
        },
        {
          "text": "Garnelen sind durch eine Schale geschützt.",
          "start": 170.88,
          "end": 173.74
        },
        {
          "text": "Ein Tintenfisch hat drei Herzen.",
          "start": 176.04,
          "end": 179.54
        },
        {
          "text": "Zwei versorgen seine Arme, das dritte versorgt seinen Körper.",
          "start": 179.74,
          "end": 184.14
        },
        {
          "text": "In Meerestiefen von acht bis neun Kilometern bilden Seegurken rund 90 Prozent der Biomasse.",
          "start": 187.3,
          "end": 195.86
        },
        {
          "text": "Die Auster filtert große Wassermengen, um sich von dem darin enthaltenen Plankton zu ernähren.",
          "start": 198.62,
          "end": 205.64
        },
        {
          "text": "Die Muscheln sind eine Klasse der Weichtiere.",
          "start": 208.45,
          "end": 211.51
        },
        {
          "text": "Kaviar sollte mit Kunststoff oder Perlmuttlöffeln gegessen werden, um den Geschmack nicht zu beeinflussen.",
          "start": 214.04,
          "end": 222.18
        },
        {
          "text": "Der Seegel ist getrenntgeschlechtig.",
          "start": 225.79,
          "end": 228.63
        }
      ]
    }
