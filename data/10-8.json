    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das Oktoberfest zieht in den letzten Jahrzehnten alljährlich Millionen Besucher an.",
          "start": 145.04,
          "end": 152.26
        },
        {
          "text": "Münchens Oberbürgermeister hat das erste Fass Bier angezapft und damit das 185.",
          "start": 155.06,
          "end": 162.26
        },
        {
          "text": "Oktoberfest eröffnet.",
          "start": 162.52,
          "end": 164.18
        },
        {
          "text": "Das Oktoberfest heißt auch Wiesen, weil es auf der Theresienwiese gefeiert wird.",
          "start": 167.2,
          "end": 172.92
        },
        {
          "text": "Der Karneval in Venedig ist weltberühmt für seine Maskenbälle, Gondelparaden und Feuerwerke.",
          "start": 175.93,
          "end": 183.07
        },
        {
          "text": "Der Rosenmontag ist der größte Tag für Karnevalfans.",
          "start": 186.07,
          "end": 189.51
        },
        {
          "text": "Die Bohle ist ein erfrischendes Sommergetränk aus Wein und Sekt mit Früchten oder Kräutern.",
          "start": 193.18,
          "end": 200.18
        },
        {
          "text": "Bundeskanzlerin Angela Merkel hat in ihrer Neujahrsansprache für ihre Asylpolitik geworben.",
          "start": 202.9,
          "end": 210.24
        },
        {
          "text": "Guten Rutsch ins neue Jahr!",
          "start": 212.8,
          "end": 214.58
        },
        {
          "text": "Am 1.",
          "start": 217.57,
          "end": 218.19
        },
        {
          "text": "Oktober dem Nationalfeiertag Chinas beginnt im Reich der Mitte die Goldene Woche.",
          "start": 218.33,
          "end": 224.33
        },
        {
          "text": "Während des Drachenboot-Fests säubert man das Haus und hängt Beifußblätter an die Türen.",
          "start": 227.49,
          "end": 233.65
        },
        {
          "text": "Das Drachenboot-Fest findet zu Ehren des Dichters Tüjön statt, der 278 v.",
          "start": 235.92,
          "end": 244.32
        },
        {
          "text": "Chr. im Milorfluss ertrunken sein soll.",
          "start": 244.44,
          "end": 247.94
        },
        {
          "text": "Die Zungse sind Klöße aus Klebreis eingewickelt in Bambusblätter mit verschiedenen Füllungen.",
          "start": 251.0,
          "end": 257.8
        }
      ]
    }
