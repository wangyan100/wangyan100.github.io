    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Nachdem Ying Zheng die chinesischen Staaten zu einem Reich vereint hatte, ließ er sich seit 221 vor Christus erster Kaiser nennen.",
          "start": 121.15,
          "end": 131.93
        },
        {
          "text": "Unter Blinden ist der einäugige König.",
          "start": 135.09,
          "end": 138.71
        },
        {
          "text": "Prinz küsst Prinzessin und beide sind glücklich bis an ihr Lebensende.",
          "start": 141.39,
          "end": 146.17
        },
        {
          "text": "Die größte Bestie auf unserem Planeten ist der Mensch.",
          "start": 149.03,
          "end": 152.87
        },
        {
          "text": "Mit Horn soll das Einhorn gegen seine Feinde kämpfen, heilen und sogar Tote wiederbeleben können.",
          "start": 155.95,
          "end": 162.77
        },
        {
          "text": "Sünden und böse Geister scheuen das Licht.",
          "start": 166.0,
          "end": 168.96
        },
        {
          "text": "Faust verkaufte dem Teufel seine Seele.",
          "start": 172.18,
          "end": 175.6
        },
        {
          "text": "Feen werden überwiegend als heiter, besonders schön und niemals alternd beschrieben und darüber hinaus als glückbringend.",
          "start": 178.04,
          "end": 187.28
        },
        {
          "text": "Die böse Hexe hat den Prinzen verzaubert.",
          "start": 190.25,
          "end": 193.33
        },
        {
          "text": "Nach dem Aberglauben beschützen Meerjungfrauen das Schiff vor Unglück.",
          "start": 196.37,
          "end": 201.45
        },
        {
          "text": "Die Mutter erzählte ihrem Kind das Märchen von Schneewittchen und sieben Zwergen.",
          "start": 204.41,
          "end": 209.33
        },
        {
          "text": "Die Mühle liegt im Tal.",
          "start": 212.17,
          "end": 214.15
        },
        {
          "text": "Wer die toskanische Stadt Luka besucht, sollte sich einen Spaziergang auf der noch fast vollständig erhaltenen Stadtmauer nicht entgehen lassen.",
          "start": 216.42,
          "end": 226.38
        },
        {
          "text": "Den Vogel erkennt man an den Federn.",
          "start": 229.5,
          "end": 231.9
        }
      ]
    }
