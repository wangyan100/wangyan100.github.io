    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "An vielen Hafen wurden spezielle Container-Terminals zum Be- und Entladen gebaut.",
          "start": 140.56,
          "end": 146.46
        },
        {
          "text": "Nach der Ankunft am Kai der Insel musste man zu Fuß weiter zum Leuchtturm laufen.",
          "start": 146.46,
          "end": 155.73
        },
        {
          "text": "Der Container wird vom Absender beladen.",
          "start": 155.73,
          "end": 161.33
        },
        {
          "text": "Das einzige Fahrzeug, das wir noch benutzen können, ist die Fähre.",
          "start": 161.33,
          "end": 169.37
        },
        {
          "text": "Das Schiff liegt auf der Rede.",
          "start": 169.37,
          "end": 174.62
        },
        {
          "text": "Dort ist der Speicher für unsere Ernte.",
          "start": 174.62,
          "end": 180.13
        },
        {
          "text": "Der Kapitän muss die Disziplin seines Schiffes aufrechterhalten.",
          "start": 180.13,
          "end": 187.06
        },
        {
          "text": "Wir lichteten den Anker und segelten mit unserem Boot los.",
          "start": 187.06,
          "end": 194.62
        },
        {
          "text": "Der Mann verfolgt durch das Fernglas das Fußballspiel.",
          "start": 194.62,
          "end": 200.9
        },
        {
          "text": "Wenn Sie schnell seekrank werden, sollten Sie auf gute Ernährung und ausreichend Schlaf achten.",
          "start": 200.9,
          "end": 210.71
        },
        {
          "text": "Das Kreuzfahrtschiff läuft heute Nachmittag aus dem Hafen aus.",
          "start": 210.71,
          "end": 217.96
        },
        {
          "text": "Ich interessiere mich für diesen Wagen.",
          "start": 217.96,
          "end": 223.02
        },
        {
          "text": "Kann ich bitte eine Probefahrt unternehmen?",
          "start": 223.02,
          "end": 225.96
        },
        {
          "text": "Die Fahrrinne ist mit Bojen markiert.",
          "start": 225.96,
          "end": 231.58
        }
      ]
    }
