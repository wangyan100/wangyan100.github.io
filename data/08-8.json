    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Ich habe auf einer dunklen Straße versehentlich ein Kaninchen überfahren.",
          "start": 132.12,
          "end": 137.4
        },
        {
          "text": "Bei dem Unfall kam ein Mensch ums Leben.",
          "start": 140.42,
          "end": 142.92
        },
        {
          "text": "Sieben weitere wurden schwer verletzt.",
          "start": 143.44,
          "end": 146.26
        },
        {
          "text": "Beim Zusammenstoß wurde sein Auto schwer beschädigt.",
          "start": 148.82,
          "end": 152.62
        },
        {
          "text": "Anfang Mai teilte die Staatsanwaltschaft Stuttgart mit, dass die VW-Tochter Porsche mehr als 500 Millionen Euro Bußgeld akzeptierte.",
          "start": 155.31,
          "end": 165.31
        },
        {
          "text": "Die Kosten für die Einschaltung eines Sachverständigen hat die Versicherung des Verkehrsunfallverursachers zu erstatten.",
          "start": 168.42,
          "end": 175.62
        },
        {
          "text": "Es stehen den geschädigten Ansprüche auf Ersatz der Heilbehandlungskosten, ein angemessenes Schmerzensgeld und Ersatz des Verdienstausfalls zu.",
          "start": 178.68,
          "end": 188.78
        },
        {
          "text": "Während des Zweiten Weltkriegs wurde Berlin durch die Bomben zerstört.",
          "start": 191.06,
          "end": 195.82
        },
        {
          "text": "Es steht mir nicht zu, mich darüber zu entscheiden.",
          "start": 198.76,
          "end": 201.56
        },
        {
          "text": "Die beiden Spieler stießen zusammen, als sie beide zum Ball liefen.",
          "start": 204.7,
          "end": 208.84
        },
        {
          "text": "An der nächsten Kreuzung musst du links abbiegen.",
          "start": 211.96,
          "end": 214.94
        },
        {
          "text": "Der Verbrecher hat keine Spuren hinterlassen.",
          "start": 217.95,
          "end": 220.61
        },
        {
          "text": "Im Jahr 2006 verunglückten rund 16.000 Personen im Alter von 15 bis 24 Jahren im Straßenverkehr.",
          "start": 220.61,
          "end": 232.14
        }
      ]
    }
