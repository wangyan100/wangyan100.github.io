    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Jupiter ist der massereichste Planet im Sonnensystem.",
          "start": 124.61,
          "end": 129.19
        },
        {
          "text": "Der Merkur hat keine natürlichen Satelliten.",
          "start": 131.56,
          "end": 135.66
        },
        {
          "text": "In der chinesischen und japanischen Kultur nach der Fünf-Elemente-Lehre steht der Saturn für die Erde.",
          "start": 138.77,
          "end": 146.35
        },
        {
          "text": "Nach dem Mond ist die Venus das hellste Gestirn am nächtlichen Himmel.",
          "start": 149.44,
          "end": 154.3
        },
        {
          "text": "Mit bloßem Auge können am Himmel etwa 3000 bis 6000 Fixsterne wahrgenommen werden.",
          "start": 157.08,
          "end": 163.96
        },
        {
          "text": "Die meisten Meteoriten sind Bruchstücke von Asteroiden und stammen aus dem Asteroidengürtel zwischen Mars und Jupiter. 160 Lichtjahre von der Erde entfernt, im Sternbild Wasserschlange, gibt es eine Ansammlung glitzernder Sterne.",
          "start": 166.23,
          "end": 187.62
        },
        {
          "text": "Ich bin Wider und meine Frau ist Schütze.",
          "start": 190.74,
          "end": 193.82
        },
        {
          "text": "Der beste Beobachtungszeitraum für das Sternbild Zwilling ist im Winter.",
          "start": 196.77,
          "end": 201.59
        },
        {
          "text": "Vom 10.",
          "start": 203.92,
          "end": 205.42
        },
        {
          "text": "August bis zum 16.",
          "start": 205.62,
          "end": 207.24
        },
        {
          "text": "September wandert die Sonne durch das Sternbild Löwe.",
          "start": 207.44,
          "end": 211.24
        },
        {
          "text": "Das Sternbild Vage ist ein kleines und eher unscheinbares Sternbild.",
          "start": 214.26,
          "end": 219.26
        },
        {
          "text": "In der Astronomie bezeichnet Galaxie eine Ansammlung von einigen hundert Milliarden Sternen.",
          "start": 222.34,
          "end": 228.64
        }
      ]
    }
