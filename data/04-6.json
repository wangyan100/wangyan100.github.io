    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "An der Rezeption wartet der Kellner auf uns ab.",
          "start": 134.94,
          "end": 138.2
        },
        {
          "text": "Du kommst mir wie gerufen.",
          "start": 140.98,
          "end": 142.97
        },
        {
          "text": "Sie stellt den Beamer an.",
          "start": 146.09,
          "end": 147.97
        },
        {
          "text": "Die Entwicklung des Lautsprechers ist direkt mit der Erfindung des Telefons verknüpft.",
          "start": 150.82,
          "end": 156.3
        },
        {
          "text": "Du sollst ins Mikrofon singen, sonst hören wir dich nicht.",
          "start": 159.29,
          "end": 163.13
        },
        {
          "text": "Davon kann ich ein Lied singen.",
          "start": 166.2,
          "end": 168.26
        },
        {
          "text": "Könntest du die Note lesen?",
          "start": 171.05,
          "end": 172.87
        },
        {
          "text": "Es gerät aus dem Rhythmus.",
          "start": 175.63,
          "end": 178.01
        },
        {
          "text": "Der Butler behandelt diese Angelegenheit mit Takt.",
          "start": 180.76,
          "end": 184.48
        },
        {
          "text": "Der Text stimmt mit der Melodie des Liedes überein.",
          "start": 186.72,
          "end": 191.84
        },
        {
          "text": "Reden Sie doch einen Ton.",
          "start": 194.58,
          "end": 196.2
        },
        {
          "text": "Hip-Hop ist sehr beliebt bei den Jugendlichen.",
          "start": 199.39,
          "end": 202.55
        },
        {
          "text": "Cui Jian ist der Vater des chinesischen Rocks.",
          "start": 205.55,
          "end": 209.15
        },
        {
          "text": "Der 57-jährige Sänger sagt, dass sein Wunsch schon in Erfüllung gegangen ist.",
          "start": 211.73,
          "end": 217.25
        },
        {
          "text": "Sein Lied ist der Schlager des Jahres und steht hoch auf der Hitliste.",
          "start": 220.38,
          "end": 224.64
        }
      ]
    }
