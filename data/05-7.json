    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Wenn diese Wohnung brannte, kam die Feuerwehr.",
          "start": 123.45,
          "end": 126.96
        },
        {
          "text": "Seit dem Großbrand melden sich immer mehr freiwillige Feuerwehren.",
          "start": 129.26,
          "end": 134.38
        },
        {
          "text": "Der Detektiv hängt sich an den Verbrecher.",
          "start": 136.98,
          "end": 139.8
        },
        {
          "text": "Der Polizist führt den Verbrecher mit Handschellen ab.",
          "start": 142.86,
          "end": 146.34
        },
        {
          "text": "Da liegt der Knüppel beim Hund.",
          "start": 149.3,
          "end": 151.42
        },
        {
          "text": "Er schlägt seinen Kollegen nur seine eigenen Waffen.",
          "start": 154.5,
          "end": 157.94
        },
        {
          "text": "Eine Kugel hat ihn getroffen.",
          "start": 161.01,
          "end": 162.97
        },
        {
          "text": "Der Räuber bedrohte die Kassiererin mit einer Pistole.",
          "start": 166.05,
          "end": 170.29
        },
        {
          "text": "Nach der Explosion einer Tränengasgranate in einem Nachtclub in Venezuela sind mindestens 17 Menschen ums Leben gekommen.",
          "start": 172.46,
          "end": 182.38
        },
        {
          "text": "Wenn das Feuer ausgebrochen ist, muss man möglichst schnell Fluchtwege finden.",
          "start": 185.54,
          "end": 190.74
        },
        {
          "text": "Das Haus war völlig niedergebrannt.",
          "start": 193.87,
          "end": 196.57
        },
        {
          "text": "Kein Rauch ohne Flamme.",
          "start": 199.19,
          "end": 201.41
        },
        {
          "text": "Wasser ist eine Verbindung aus Wasserstoff und Sauerstoff.",
          "start": 204.3,
          "end": 208.56
        },
        {
          "text": "Ohne Sauerstoff kann kein Feuer brennen.",
          "start": 210.96,
          "end": 214.12
        }
      ]
    }
