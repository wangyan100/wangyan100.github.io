    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Gummibärchen sind Gummibongbongs in Form von etwa zwei Zentimeter großen stilisierten Beeren.",
          "start": 127.6,
          "end": 136.12
        },
        {
          "text": "Halspastillen lindern und behandeln die schmerzhaften Symptome leicht entzündeter Schleimhäute.",
          "start": 138.99,
          "end": 146.37
        },
        {
          "text": "Jeder Deutsche kaut Schätzungen zufolge 100 Kaugummis im Jahr.",
          "start": 149.01,
          "end": 153.81
        },
        {
          "text": "Milchschokolade ist hitzeempfindlicher und weniger lange haltbar als Bitterschokolade.",
          "start": 157.13,
          "end": 163.31
        },
        {
          "text": "Das Leben ist wie eine Schachtel Pralinen.",
          "start": 166.32,
          "end": 169.1
        },
        {
          "text": "Man weiß nie, was man kriegt.",
          "start": 169.54,
          "end": 171.8
        },
        {
          "text": "Mozartkugeln sind Pralinen aus Pistazien, Marzipan und Nougat.",
          "start": 176.5,
          "end": 182.46
        },
        {
          "text": "Häufig kostet eine Eiskugel der handwerklichen Eisdealer ein Euro.",
          "start": 185.05,
          "end": 190.09
        },
        {
          "text": "Erdnüsse wachsen unterirdisch.",
          "start": 193.32,
          "end": 195.84
        },
        {
          "text": "Es gilt für die Pistazie, je grüner, desto höher die Qualität.",
          "start": 198.76,
          "end": 204.14
        },
        {
          "text": "Studentenfutter ist eine bekannte Bezeichnung für einen Snack, der aus getrockneten Früchten und Nüssen besteht.",
          "start": 207.49,
          "end": 214.93
        },
        {
          "text": "Cracker werden oft als kleine Beilage zu Wein, Bier, Käse und ähnlichem gegessen.",
          "start": 218.27,
          "end": 225.19
        }
      ]
    }
