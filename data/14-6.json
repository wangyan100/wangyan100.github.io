    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "hohe Absätze.",
          "start": 129.32,
          "end": 130.54
        },
        {
          "text": "Die Einlage schmiegt sich weich in den Schuh.",
          "start": 132.75,
          "end": 136.89
        },
        {
          "text": "Wann die ersten Schuhbänder aufkamen, ist nicht genau bekannt.",
          "start": 139.84,
          "end": 143.94
        },
        {
          "text": "Schuhwichse erhält Leder geschmeidig und wasserdicht.",
          "start": 147.18,
          "end": 151.04
        },
        {
          "text": "Clocks stammen ursprünglich aus England und haben über Schweden allgemeine Verbreitung gefunden.",
          "start": 154.05,
          "end": 161.03
        },
        {
          "text": "Schleppchen umschließen den Fuß wie eine zweite Haut.",
          "start": 164.33,
          "end": 168.03
        },
        {
          "text": "Adidas hat eine limitierte Serie Sneakers entworfen.",
          "start": 171.27,
          "end": 175.93
        },
        {
          "text": "Seine Füße stecken in Pantoffeln.",
          "start": 178.61,
          "end": 181.03
        },
        {
          "text": "Ich trage im Sommer Sandalen und keine Socken, weil es angenehm und gesund ist.",
          "start": 184.17,
          "end": 189.79
        },
        {
          "text": "Ich kann leider in Pumps nicht richtig gehen.",
          "start": 192.82,
          "end": 195.52
        },
        {
          "text": "Pumps aus Velourleder mit Schleife werden hier zur Zeit gerne gekauft.",
          "start": 198.72,
          "end": 203.58
        },
        {
          "text": "Die Wunschzettel wurden bereits am Nikolaustag geschrieben und in die Stiefel gesteckt.",
          "start": 206.68,
          "end": 212.72
        },
        {
          "text": "Von Hochgebirgen sind in Mittel- und Nordeuropa Gummistiefel aus Naturkautschuk häufiges Schuhwerk für Jäger.",
          "start": 215.6,
          "end": 223.0
        }
      ]
