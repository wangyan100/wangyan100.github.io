    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Mutter nimmt ihr Kind auf den Arm.",
          "start": 113.28,
          "end": 116.44
        },
        {
          "text": "In der Achselhöhle wird häufig die Körpertemperatur mit einem Fieberthermometer gemessen.",
          "start": 119.4,
          "end": 125.56
        },
        {
          "text": "Ich habe mir beim Sturz von der Leiter den Ellbogen gebrochen.",
          "start": 128.61,
          "end": 133.07
        },
        {
          "text": "Bei der Untersuchung des Opfers entdecken Rechtsmediziner einen Bluterguss am Oberarm.",
          "start": 135.74,
          "end": 141.6
        },
        {
          "text": "Das Zeichnen fiel ihm schwer, denn seine rechte Hand war gelähmt.",
          "start": 144.62,
          "end": 148.92
        },
        {
          "text": "Dieser Casanova wickelt jede Frau um den kleinen Finger.",
          "start": 151.72,
          "end": 155.74
        },
        {
          "text": "Wenn du zum ersten Mal Klavier spielst, musst du dich noch sehr anstrengen, damit deine Finger auf den richtigen Tasten landen.",
          "start": 158.8,
          "end": 166.86
        },
        {
          "text": "Der Stempel auf meinem Handrücken bezeugte, dass ich bereits Eintritt gezahlt hatte.",
          "start": 169.65,
          "end": 174.95
        },
        {
          "text": "Beim Handlesen achtete man nicht nur auf die Position und die Ausrichtung der Handlinien, sondern auch auf deren Tiefe und Abzweigungen.",
          "start": 177.76,
          "end": 187.7
        },
        {
          "text": "Ich drücke dir die Daumen.",
          "start": 190.58,
          "end": 192.46
        },
        {
          "text": "Die gekreuzten Zeigefinger und Mittelfinger sind eine Handgeste, die verwendet wird, um ein Versprechen oder einen Eid aufzuheben.",
          "start": 195.34,
          "end": 204.48
        },
        {
          "text": "Die bedeutungsträchtigen Ringe müssen am Ringfinger getragen werden.",
          "start": 207.5,
          "end": 212.08
        },
        {
          "text": "Die Knie der Fußballer sind verletzungsanfällig.",
          "start": 214.26,
          "end": 218.72
        },
        {
          "text": "Die Wunde an meinem großen Zeh hat sich geschlossen.",
          "start": 221.58,
          "end": 224.74
        }
      ]
    }
