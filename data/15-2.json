    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Beim Baden im Roten Meer ist eine deutsche Touristin von einem Hai angegriffen und getötet worden.",
          "start": 134.83,
          "end": 142.57
        },
        {
          "text": "Katzenhaie ernähren sich von größeren Wirbellosen und kleinen Fischen.",
          "start": 145.96,
          "end": 150.88
        },
        {
          "text": "Der Hecht wird von der Weltnaturschutzunion in der Roten Liste gefährdeter Arten geführt.",
          "start": 154.11,
          "end": 160.83
        },
        {
          "text": "Die Eingeweide vieler Kugelfische sind giftig.",
          "start": 163.88,
          "end": 168.2
        },
        {
          "text": "Vor allem in China und Südostasien kommt der Glaube, dass zerstoßene Seepferdchen heilende Wirkung haben.",
          "start": 170.53,
          "end": 178.23
        },
        {
          "text": "Delfine haben einen sehr guten Gehör- und Gesichtssinn.",
          "start": 181.3,
          "end": 184.54
        },
        {
          "text": "Seehunde sind sehr gute Schwimmer, die bis zu 200 Meter tief und 30 Minuten lang tauchen können.",
          "start": 184.54,
          "end": 196.06
        },
        {
          "text": "Die meisten Wale sind vom Aussterben bedroht.",
          "start": 196.06,
          "end": 202.29
        },
        {
          "text": "In China werden einige nicht giftige Quallen als Speise gegessen.",
          "start": 202.29,
          "end": 210.15
        },
        {
          "text": "Die meisten Fische verfügen über sieben Flossen.",
          "start": 210.15,
          "end": 216.49
        },
        {
          "text": "Die Gräte blieb ihm im Hals stecken.",
          "start": 216.49,
          "end": 222.01
        },
        {
          "text": "Die Hauer sind das auffälligste Merkmal des Walrosses.",
          "start": 222.01,
          "end": 228.95
        },
        {
          "text": "Die Schwimmblase ist ein Organ der Knochenfische.",
          "start": 228.95,
          "end": 235.4
        },
        {
          "text": "Viele Haiarten sind Ovovivipar.",
          "start": 235.4,
          "end": 241.15
        }
      ]
    }
