    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Zu heißes Föhnen von Haartrockner kann die Haare schädigen.",
          "start": 139.66,
          "end": 144.42
        },
        {
          "text": "Die Badewanne läuft über.",
          "start": 147.4,
          "end": 149.28
        },
        {
          "text": "Er möchte unter die Brause gehen.",
          "start": 152.53,
          "end": 154.83
        },
        {
          "text": "Der Misserfolg bei der Prüfung ist für mich wie eine kalte Dusche.",
          "start": 158.02,
          "end": 163.24
        },
        {
          "text": "Handtuchhalter dienen zum Hängen der Handtücher.",
          "start": 166.5,
          "end": 169.76
        },
        {
          "text": "Sie erhebt sich vom Klosett.",
          "start": 172.88,
          "end": 175.08
        },
        {
          "text": "Sie bestreicht die Bodylotion auf ihrem Körper.",
          "start": 178.02,
          "end": 181.44
        },
        {
          "text": "Die Seife reinigt.",
          "start": 184.54,
          "end": 186.88
        },
        {
          "text": "Nachdem das Shampoo ausgewaschen wurde, kann die Haarspülung auf die Haare aufgetragen werden.",
          "start": 189.34,
          "end": 195.94
        },
        {
          "text": "Er nimmt ein Badetuch, um seinen Körper abzutrocknen.",
          "start": 199.06,
          "end": 203.48
        },
        {
          "text": "Reinigungsöl lässt sich nicht leicht abwaschen.",
          "start": 206.74,
          "end": 210.2
        },
        {
          "text": "Bevor man seine Zähne putzt, presst man die Zahncreme auf die Zahnbürste.",
          "start": 213.12,
          "end": 218.46
        },
        {
          "text": "Ich möchte mich nicht mehr rasieren, sondern meinen Bart wachsen lassen.",
          "start": 220.89,
          "end": 226.17
        }
      ]
    }
