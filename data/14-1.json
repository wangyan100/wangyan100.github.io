    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Wer sich gegen die Sonne schützen möchte, sollte dunkle Kleidung aus Polyester anziehen.",
          "start": 139.02,
          "end": 145.29
        },
        {
          "text": "Die neue Kollektion der Babykleidung hat bei den Kunden gute Resonanz gezeigt.",
          "start": 148.46,
          "end": 153.84
        },
        {
          "text": "Im Süden Chinas konnte man fast das ganze Jahr mit Sommerkleidung aus.",
          "start": 153.84,
          "end": 161.33
        },
        {
          "text": "Die junge Frau hat viel Geld für Winterkleidung ausgegeben.",
          "start": 164.3,
          "end": 168.24
        },
        {
          "text": "Ich trug eine blaue kurze Hose und ein weiß-rot kariertes Hemd.",
          "start": 171.42,
          "end": 176.84
        },
        {
          "text": "Wir haben Teppiche gewebt und Stoffdruck gemacht.",
          "start": 179.24,
          "end": 182.68
        },
        {
          "text": "Sie hat ein Kleid mit dezentem Streifenmuster getragen.",
          "start": 185.86,
          "end": 189.76
        },
        {
          "text": "Der Anbau der Baumwolle ist nur in tropischen und subtropischen Gebieten möglich.",
          "start": 192.62,
          "end": 198.1
        },
        {
          "text": "Meine Mutter hat einen dünnen Stoff geschnitten, um für mich ein Kleid zu machen.",
          "start": 201.3,
          "end": 206.06
        },
        {
          "text": "Das Collar ist der weiße, ringförmige Stehkragen, der von Klerikern verschiedener christlicher Konversionen getragen wird.",
          "start": 209.12,
          "end": 217.54
        },
        {
          "text": "Er war mit einer schwarzen Stoffhose und einem schwarzen Strickpulli mit Rollkragen bekleidet.",
          "start": 220.56,
          "end": 226.84
        },
        {
          "text": "Puffärmel gibt es in der Bekleidung von Frauen und Männern seit der Renaissance.",
          "start": 230.25,
          "end": 235.25
        },
        {
          "text": "An deinem Hemd ist ein Knopf offen.",
          "start": 238.44,
          "end": 240.8
        },
        {
          "text": "An seiner grünen Hose ist der Reißverschluss offen.",
          "start": 243.88,
          "end": 247.16
        }
      ]
    }
