    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Sie ist fleißig wie eine Ameise.",
          "start": 125.07,
          "end": 128.01
        },
        {
          "text": "Bienen ernähren sich rein vegetarisch.",
          "start": 130.28,
          "end": 133.86
        },
        {
          "text": "Je näher er dem Bienenstock kam, desto deutlicher konnte er die Bienensummen hören.",
          "start": 136.69,
          "end": 142.59
        },
        {
          "text": "Die Lebensdauer der adulten Libellen beträgt durchschnittlich etwa 6 bis 8 Wochen.",
          "start": 145.74,
          "end": 152.14
        },
        {
          "text": "Libellen haben bis zu 30.000 Omatidien pro Facettenauge.",
          "start": 155.22,
          "end": 160.42
        },
        {
          "text": "In der Wiese saßen so viele Grashüpfer, dass die Geräuschkulisse ohrenbetäubend war.",
          "start": 163.46,
          "end": 169.52
        },
        {
          "text": "Heuschrecken werden in Teilen Afrikas, Asiens und Südamerikas als eiweißreiche Nahrung gegessen.",
          "start": 172.65,
          "end": 180.25
        },
        {
          "text": "Das Leben eines Moskitos gliedert sich in vier verschiedene Stadien.",
          "start": 183.39,
          "end": 188.65
        },
        {
          "text": "Ei, Larve, Puppe und Imago.",
          "start": 191.34,
          "end": 194.54
        },
        {
          "text": "Diese Larve verpuppt sich und aus der Puppe schlüpft der Schmetterling.",
          "start": 197.54,
          "end": 202.0
        },
        {
          "text": "Die Larven der meisten Bockkäferarten ernähren sich von Holz.",
          "start": 204.2,
          "end": 209.9
        },
        {
          "text": "Leuchtkäfer sind auf allen Kontinenten mit Ausnahme der Antarktis zu finden.",
          "start": 213.39,
          "end": 218.91
        },
        {
          "text": "Einige Spinnen sind Schädlinge, andere sind Nutztiere.",
          "start": 222.13,
          "end": 226.45
        },
        {
          "text": "Das Mädchen wurde am Donnerstag im Kindergarten von einer Wespe in den Finger gestochen.",
          "start": 229.57,
          "end": 235.39
        },
        {
          "text": "Die Fühler vom Bockkäfer sind länger als sein Körper.",
          "start": 238.33,
          "end": 242.51
        }
      ]
    }
