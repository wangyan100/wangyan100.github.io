    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Gletscher speichern 70 Prozent des Süßwassers der Erde.",
          "start": 135.79,
          "end": 140.69
        },
        {
          "text": "Die vier Schichten des Gletschers pressen sich stetig zu Eis zusammen.",
          "start": 143.49,
          "end": 148.77
        },
        {
          "text": "Beinahe jedes Jahr fallen Skitouristen einer Lawine zum Opfer.",
          "start": 151.8,
          "end": 156.62
        },
        {
          "text": "Als lebendes Cliff wird ein Abschnitt einer Cliffküste bezeichnet, der durch das Meer erodiert und rückversetzt wird.",
          "start": 159.5,
          "end": 167.42
        },
        {
          "text": "Wegen Lawinengefahr mussten mehrere Pässe gesperrt werden.",
          "start": 170.52,
          "end": 174.74
        },
        {
          "text": "Natürliche Höhlen galten in der Antike als Aufenthaltsort von Nymphen und anderen Wesen.",
          "start": 178.0,
          "end": 184.66
        },
        {
          "text": "Grundsätzlich befinden sich in allen Höhlen weltweit, die in Karst- und Kalkgesteinsregionen liegen, Tropfsteine.",
          "start": 187.36,
          "end": 194.14
        },
        {
          "text": "Die größte Konzentration an Vulkanen kann man am sogenannten Pazifischen Feuerring finden.",
          "start": 194.44,
          "end": 204.04
        },
        {
          "text": "Ein Vulkan, der seit 10.000 Jahren nicht mehr tätig ist, wird zu den erloschenen Vulkanen gerechnet.",
          "start": 204.04,
          "end": 214.59
        },
        {
          "text": "In dem Erdmantel existieren Magmen.",
          "start": 214.59,
          "end": 220.83
        },
        {
          "text": "Bei manchen Vulkanausbrüchen wird das Oberflächengestein kilometerweit in die Luft gestoßen.",
          "start": 220.83,
          "end": 230.47
        },
        {
          "text": "Die Oasenwirtschaft ist eine sehr intensive Wirtschaftsform innerhalb der Oasen in den Trockengebieten.",
          "start": 230.47,
          "end": 240.51
        }
      ]
    }
