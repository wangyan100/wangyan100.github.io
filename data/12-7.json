    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Mutterkuchen besteht aus Gewebe in der Gebärmutter.",
          "start": 133.65,
          "end": 137.67
        },
        {
          "text": "In der dritten Woche nach der Befruchtung beginnt der Herzschlag des Fötuses.",
          "start": 140.81,
          "end": 145.83
        },
        {
          "text": "Die Kinder werden nach der Geburt ausführlich untersucht und der Papa darf die Nabelschnur durchschneiden.",
          "start": 148.98,
          "end": 155.42
        },
        {
          "text": "Der Arzt möchte den Blutdruck messen oder Blut abnehmen und es im Labor untersuchen.",
          "start": 158.39,
          "end": 164.29
        },
        {
          "text": "Bei der Ultraschalluntersuchung können der Arzt und die schwangere Frau das ungeborene Kind beobachten.",
          "start": 167.35,
          "end": 174.37
        },
        {
          "text": "Eine Anämie ist entweder erworben oder angeboren.",
          "start": 177.52,
          "end": 181.18
        },
        {
          "text": "Etwa in der 22.",
          "start": 184.27,
          "end": 185.73
        },
        {
          "text": "Schwangerschaftswoche haben die meisten Schwangeren schon die Kindsbewegungen gespürt.",
          "start": 186.81,
          "end": 192.15
        },
        {
          "text": "Schwangerschaftserbrechen tritt oft am Morgen auf und kann von Unwohlsein und Übelkeit begleitet sein.",
          "start": 194.8,
          "end": 200.68
        },
        {
          "text": "Von einer Frühgeburt wird gesprochen, wenn das Baby vor Vollendung der 37.",
          "start": 204.44,
          "end": 209.98
        },
        {
          "text": "Schwangerschaftswoche geboren wird oder weniger als 2500 Gramm wiegt.",
          "start": 210.8,
          "end": 216.88
        },
        {
          "text": "Hebamme berät und hilft ihnen während der Schwangerschaft und auch nach der Geburt von ihrem Kind.",
          "start": 219.86,
          "end": 225.7
        },
        {
          "text": "Eine angeborene Missbildung der linken Hand machte ihm das Leben schwer.",
          "start": 228.86,
          "end": 233.64
        },
        {
          "text": "Während des Wochenbets seiner Frau hat er eine Krankenpflegerin beschäftigt.",
          "start": 236.85,
          "end": 241.27
        }
      ]
    }
