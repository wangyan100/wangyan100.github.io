    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Diese beiden Strümpfe gehören nicht zusammen.",
          "start": 126.91,
          "end": 129.71
        },
        {
          "text": "An Ihrem Knie-Strumpf läuft eine Masche.",
          "start": 132.79,
          "end": 135.79
        },
        {
          "text": "Die Polizei fand in ihrer Nähe eine Socke, die der Täter ihr in den Mund gesteckt hatte.",
          "start": 138.71,
          "end": 144.35
        },
        {
          "text": "Die Weiber haben dünne Strumpfhosen und müssen frieren, aber es sieht hübsch aus.",
          "start": 147.24,
          "end": 153.13
        },
        {
          "text": "Ein schwarzer Filzhut des verstorbenen Popgiganten Michael Jackson kommt Ende September in Paris unter den Hammer.",
          "start": 156.16,
          "end": 164.54
        },
        {
          "text": "Das Mädchen hatte einen roten Hut auf und eine weiße Jacke an.",
          "start": 167.63,
          "end": 171.85
        },
        {
          "text": "Man schwitzt mit dieser Kappe im Sommer weniger.",
          "start": 174.79,
          "end": 177.79
        },
        {
          "text": "Jedem Narren gefällt seine Kappe.",
          "start": 181.07,
          "end": 183.83
        },
        {
          "text": "Seit er in Mexico City lebt, trägt er immer diesen dämlichen Sombrero.",
          "start": 186.3,
          "end": 191.6
        },
        {
          "text": "Die schöne Frau hat ihr Haar unter einem schwarzen Turban verborgen.",
          "start": 194.66,
          "end": 199.34
        },
        {
          "text": "Ein Schleier verhüllt ihr Gesicht.",
          "start": 199.62,
          "end": 201.56
        },
        {
          "text": "Warum haben Schornsteinfeger ausgerechnet einen Zylinder auf dem Kopf?",
          "start": 204.68,
          "end": 209.44
        },
        {
          "text": "Sein Gesicht maskierte er mit einem dunklen Dreieckstuch.",
          "start": 212.62,
          "end": 216.46
        },
        {
          "text": "Die Farbe des Gürtels zeigt den Grad des Kämpfers an.",
          "start": 219.5,
          "end": 223.3
        },
        {
          "text": "Nur am Hals trägt er ein weißes Letzchen.",
          "start": 225.6,
          "end": 229.24
        }
      ]
    }
  ]
