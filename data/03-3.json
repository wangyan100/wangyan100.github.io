    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Klimaanlagen und Ventilatoren laufen bei den hochsommerlichen Temperaturen in vielen Büros und Wohnungen auf Hochtouren Staubsauger saugt Staub Der Kamin im Wohnzimmer qualmte heftig, da der Schornstein keinen rechten Zug hat.",
          "start": 127.0,
          "end": 152.11
        },
        {
          "text": "Vor Müdigkeit sinkt der Mann nach dem Essen in einen Sessel.",
          "start": 155.26,
          "end": 159.52
        },
        {
          "text": "Diese schöne Frau liegt ruhig auf dem Sofa.",
          "start": 162.68,
          "end": 166.14
        },
        {
          "text": "Ich schütte Wasser auf meinen neuen Teppich.",
          "start": 169.09,
          "end": 172.65
        },
        {
          "text": "Das zweite deutsche Fernsehen ZDF ist eine der größten öffentlich-rechtlichen Sendeanstalten in Deutschland.",
          "start": 175.3,
          "end": 184.58
        },
        {
          "text": "Die Studenten sollen im Unterricht nicht quatschen.",
          "start": 187.86,
          "end": 191.84
        },
        {
          "text": "Einmal sehen ist besser als hundertmal hören.",
          "start": 194.78,
          "end": 198.3
        },
        {
          "text": "Der Athlet ruht sich nach der Entlassung immer auf seinen Lorbeeren aus.",
          "start": 201.39,
          "end": 206.55
        },
        {
          "text": "Anna und ihre Freunde möchten sich heute Abend offen und aufrichtig unterhalten.",
          "start": 209.66,
          "end": 215.44
        },
        {
          "text": "Die Kinder spielen gerne mit Spielzeug.",
          "start": 218.3,
          "end": 221.18
        }
      ]
    }
