    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das geht auf mein Konto.",
          "start": 130.57,
          "end": 132.69
        },
        {
          "text": "Möchten Sie ein Girokonto oder ein Sparkonto eröffnen?",
          "start": 135.15,
          "end": 139.19
        },
        {
          "text": "Wenn Sie Ihr Geld sicher anlegen möchten und schnell darauf zugreifen können, ist ein Tagesgeldkonto eine gute Wahl.",
          "start": 142.09,
          "end": 150.15
        },
        {
          "text": "Du hast den Feuerbrand in mein junges, friedsames Herz geworfen und er wird nimmer nimmer gelöscht werden.",
          "start": 152.97,
          "end": 160.65
        },
        {
          "text": "Kabale und Liebe.",
          "start": 161.15,
          "end": 162.45
        },
        {
          "text": "Der Saldo beträgt nur 100 Euro.",
          "start": 165.45,
          "end": 168.01
        },
        {
          "text": "Schecks werden in Deutschland nur sehr selten von Privatpersonen verwendet.",
          "start": 171.12,
          "end": 176.46
        },
        {
          "text": "Mein Vater hat gestern 5000 Euro an mich überwiesen.",
          "start": 179.1,
          "end": 183.1
        },
        {
          "text": "Ich habe kein Bargeld und werde am Geldautomaten Geld abheben.",
          "start": 186.14,
          "end": 190.78
        },
        {
          "text": "Mit den Apps kann man den Kontostand einsehen.",
          "start": 193.84,
          "end": 196.78
        },
        {
          "text": "Er zahlt seine Wohnung in monatlichen Raten von 300 Euro ab.",
          "start": 199.05,
          "end": 204.83
        },
        {
          "text": "Füllen Sie das Antragsformular online aus.",
          "start": 207.64,
          "end": 210.72
        },
        {
          "text": "Meistens muss man für ein Konto Gebühr bezahlen.",
          "start": 213.81,
          "end": 216.97
        },
        {
          "text": "Diese Familie lebt von Zinsen Ihres Vermögens.",
          "start": 220.17,
          "end": 223.53
        }
      ]
