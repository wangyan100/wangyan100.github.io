    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Glückliche Menschen sind gesünder und haben eine längere Lebenserwartung.",
          "start": 132.94,
          "end": 138.16
        },
        {
          "text": "Bei der häuslichen Gewalt wird man sowohl körperlich als auch psychisch verletzt.",
          "start": 141.02,
          "end": 146.33
        },
        {
          "text": "Du siehst wohl aus.",
          "start": 149.64,
          "end": 151.18
        },
        {
          "text": "Lass dich von seiner Grippe nicht anstecken.",
          "start": 154.15,
          "end": 156.93
        },
        {
          "text": "Der Engländer Edward Jenner entdeckte im Jahr 1797, dass man den Pocken mit Kuhpocken impfen und immunisieren kann.",
          "start": 159.89,
          "end": 169.23
        },
        {
          "text": "Der Herzerkrankung wird durch regelmäßigen Sport vorgebeugt.",
          "start": 171.44,
          "end": 177.44
        },
        {
          "text": "Infektionskrankheiten können durch Bakterien oder Viren hervorgerufen werden.",
          "start": 181.13,
          "end": 185.63
        },
        {
          "text": "Wann steht ihr zu sehr unter Druck und wie geht ihr damit um?",
          "start": 188.67,
          "end": 192.71
        },
        {
          "text": "Darauf kannst du Gift nehmen.",
          "start": 195.78,
          "end": 197.64
        },
        {
          "text": "Max hat eine gesunde Lebensweise und läuft jeden Morgen.",
          "start": 200.73,
          "end": 204.55
        },
        {
          "text": "Ein Virus kann die gesamten Daten auf dem Computer verändern oder sogar löschen.",
          "start": 206.82,
          "end": 213.0
        },
        {
          "text": "Die radioaktive Strahlung ist für Menschen sehr gefährlich.",
          "start": 215.65,
          "end": 219.71
        },
        {
          "text": "Die Krankheit trat akut auf.",
          "start": 222.62,
          "end": 224.94
        },
        {
          "text": "Das infektiöse Material wird in besonderen Containern gesammelt und verbrannt.",
          "start": 227.96,
          "end": 233.46
        },
        {
          "text": "Die Krankheit Osteoporose betrifft zunächst ältere Menschen, vor allem Frauen nach der Menopause.",
          "start": 236.5,
          "end": 242.96
        }
      ]
    }
