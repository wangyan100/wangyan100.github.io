    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Seit 2008 ist das Mondfest ein dreitägiger gesetzlicher Feiertag auf dem chinesischen Festland.",
          "start": 133.87,
          "end": 142.31
        },
        {
          "text": "Unter allen Traditionen zum Mondfest gibt es drei besonders wichtige, nämlich den Mondschein zu genießen, Mondkuchen zu essen und die Mondfestlaternen anzufertigen.",
          "start": 144.55,
          "end": 157.67
        },
        {
          "text": "Am Mondfest jedes Jahres werden an verschiedenen Orten viele Veranstaltungen zur Bewunderung des Mondes organisiert.",
          "start": 160.72,
          "end": 169.06
        },
        {
          "text": "In der chinesischen Kultur ist der Vollmond ein Symbol des Friedens und des Wohlstands für die ganze Familie.",
          "start": 171.3,
          "end": 179.5
        },
        {
          "text": "Vor etwa 4000 Jahren haben 10 Sonnen das Land ausgebrannt und die Ernte der Menschen vernichtet.",
          "start": 182.69,
          "end": 190.01
        },
        {
          "text": "Ein Held mit Namen Hou Yi schoss 9 Sonnen ab und somit war die Welt gerettet.",
          "start": 193.1,
          "end": 199.34
        },
        {
          "text": "Die Familien kommen zusammen, um den Mond anzusehen und die Mondkekse zu essen.",
          "start": 201.55,
          "end": 207.89
        },
        {
          "text": "Die Hochzeit fand am Freitag im Familienkreis statt.",
          "start": 210.95,
          "end": 214.99
        },
        {
          "text": "Im Mittelpunkt der Feiern stehen die Löwentänze und natürlich die schmackhaften Mondkuchen.",
          "start": 218.1,
          "end": 224.2
        },
        {
          "text": "Die am häufigsten verwendeten Füllungen von Mondkuchen sind wie folgt Eigelb, Lotus-Samenpaste und süße Bohnenpaste.",
          "start": 227.25,
          "end": 238.13
        },
        {
          "text": "Die Menschen beschenken sich mit Mondkuchen einem Gebäck mit süßer oder salziger Füllung.",
          "start": 240.9,
          "end": 246.58
        }
      ]
    }
