    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Sahara in Afrika ist das größte Wüstengebiet der Welt und der höchste Berg Afrikas ist der Kilimanjaro mit 5892 Metern.",
          "start": 133.24,
          "end": 146.48
        },
        {
          "text": "China ist Deutschlands wichtigster Partner in Asien.",
          "start": 149.19,
          "end": 152.85
        },
        {
          "text": "Deutschland gehört zu den am dichtesten besiedelten Ländern Europas.",
          "start": 155.15,
          "end": 160.43
        },
        {
          "text": "Die in Südamerika beheimateten Tiere sind vom Aussterben bedroht.",
          "start": 163.43,
          "end": 168.61
        },
        {
          "text": "Zwischen Südamerika und Afrika liegt der Atlantik.",
          "start": 171.34,
          "end": 175.66
        },
        {
          "text": "Im Nordpolarmeer nimmt langfristig die Fläche und die Dicke des Eises ab.",
          "start": 178.51,
          "end": 184.17
        },
        {
          "text": "Der Pazifik hat zahlreiche Geheimnisse.",
          "start": 187.24,
          "end": 190.04
        },
        {
          "text": "Die Afrikaner sind viel lockerer.",
          "start": 193.12,
          "end": 195.52
        },
        {
          "text": "Der Eskimo lebt in einem Iglu.",
          "start": 197.86,
          "end": 201.12
        },
        {
          "text": "Der Urmensch hat mit seiner Intelligenz die Waffen erfunden, um sein Leben zu sichern.",
          "start": 204.16,
          "end": 210.02
        },
        {
          "text": "Die Beherrschung einer Fremdsprache gilt im Berufsleben als Schlüsselqualifikation.",
          "start": 212.88,
          "end": 218.8
        },
        {
          "text": "Dieser Professor spricht im Berliner Dialekt.",
          "start": 221.98,
          "end": 224.98
        },
        {
          "text": "Obama ist ein Mischling, die Mutter weiß und aus Kansas, der Vater schwarz, ein Kenianer.",
          "start": 228.01,
          "end": 235.01
        },
        {
          "text": "Forscher suchen nach einem gemeinsamen Vorfahren von Affen und Menschen.",
          "start": 237.47,
          "end": 242.91
        }
      ]
    }
