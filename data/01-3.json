    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die original bayerische Schweinehackse kann zur Brotzeit mit Bauernbrot gegessen werden.",
          "start": 119.67,
          "end": 129.64
        },
        {
          "text": "Traditionell wird Schinken aus der Hinterkeule des Schweins hergestellt.",
          "start": 132.93,
          "end": 137.46
        },
        {
          "text": "Ich schneide beim Schinken immer den Speck ab.",
          "start": 140.98,
          "end": 144.0
        },
        {
          "text": "Thüringer Mett ist ein gewürztes Hackfleisch vom Schwein.",
          "start": 147.04,
          "end": 151.03
        },
        {
          "text": "Kalbfleisch stammt von jungen Rindern, die bei der Schlachtung wenige Wochen bis wenige Monate alt sind.",
          "start": 154.59,
          "end": 161.67
        },
        {
          "text": "Putenfleisch enthält reichlich B-Vitamine.",
          "start": 165.16,
          "end": 168.28
        },
        {
          "text": "Blutwurst wird in der Regel kalt zum Wesper gegessen.",
          "start": 171.54,
          "end": 175.68
        },
        {
          "text": "Die Currywurst ist in der Zeit nach dem Zweiten Weltkrieg in Berlin entstanden.",
          "start": 178.85,
          "end": 184.05
        },
        {
          "text": "Die Pfälzer Leberwurst ist eine traditionell in der Kurpfalz hergestellte Kochwurst.",
          "start": 187.27,
          "end": 194.43
        },
        {
          "text": "Kaninchenfleisch versorgt den menschlichen Körper mit reichvollen ungesättigten Fettsäuren.",
          "start": 197.48,
          "end": 203.94
        },
        {
          "text": "Ursprünglich wurde für Döner nur Lammfleisch verwendet.",
          "start": 206.91,
          "end": 210.35
        },
        {
          "text": "Inzwischen sind auch Kalb- oder Rindfleisch und Geflügel üblich.",
          "start": 211.09,
          "end": 214.55
        }
      ]
    }
