    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Nacht vom Halloween gehört den Hexen, Geistern und Gruselmonstern.",
          "start": 119.89,
          "end": 125.67
        },
        {
          "text": "Zu Halloween sind die Gebäude oft mit Kürbisfratzen oder Spinnweben dekoriert.",
          "start": 125.67,
          "end": 135.54
        },
        {
          "text": "Zu Halloween darf der Gruselook nicht fehlen.",
          "start": 138.67,
          "end": 142.75
        },
        {
          "text": "Kürbisse stammen zwar ursprünglich aus Amerika.",
          "start": 145.29,
          "end": 148.69
        },
        {
          "text": "Die Idee, sie als Laternen zu verwenden, stammt aber aus Europa.",
          "start": 151.81,
          "end": 156.73
        },
        {
          "text": "Man schnitzte Kürbislaternen, um den Teufel fernzuhalten.",
          "start": 160.0,
          "end": 164.58
        },
        {
          "text": "Im Volksglauben übt Hexe mithilfe von magischen Kräften einen meist schädigenden Einfluss auf andere Menschen aus.",
          "start": 166.85,
          "end": 176.31
        },
        {
          "text": "Der Vampir ist unsterblich.",
          "start": 179.28,
          "end": 181.54
        },
        {
          "text": "Alle Heiligen ist ein christliches Fest, bei dem man der Heiligen gedenkt.",
          "start": 184.54,
          "end": 189.56
        },
        {
          "text": "Sie waren immer zu Streichen aufgelegt.",
          "start": 192.66,
          "end": 195.34
        },
        {
          "text": "Die Kinder ziehen von Haus zu Haus, verlangen nach Süßigkeiten, spielen Süßes oder Saures.",
          "start": 198.4,
          "end": 205.08
        },
        {
          "text": "Der Import von Feierkultur sei kein Einzelfenomen, sagt der Kulturwissenschaftler.",
          "start": 207.38,
          "end": 214.88
        }
      ]
    }
