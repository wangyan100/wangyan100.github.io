    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Zugspitze ist der höchste Berg Deutschlands.",
          "start": 146.3,
          "end": 149.88
        },
        {
          "text": "Der Felsen springt ins Meer vor.",
          "start": 152.77,
          "end": 155.53
        },
        {
          "text": "Der Mount Everest ist der allerhöchste Gipfel der Erde.",
          "start": 157.74,
          "end": 162.56
        },
        {
          "text": "Er lebte 20 Jahre lang in einer der Höhlen in der Bergwand.",
          "start": 165.67,
          "end": 170.27
        },
        {
          "text": "Der Jäger wagt sich in die Höhle des Löwen.",
          "start": 173.38,
          "end": 176.46
        },
        {
          "text": "Der Fluss fließt zu Tal.",
          "start": 179.45,
          "end": 181.71
        },
        {
          "text": "Bäche von Schweiß flossen an ihm herunter.",
          "start": 184.78,
          "end": 188.06
        },
        {
          "text": "Die Quelle sprudelt aus dem Felsen.",
          "start": 191.15,
          "end": 194.33
        },
        {
          "text": "Der junge Wissenschaftler redet wie ein Wasserfall.",
          "start": 197.01,
          "end": 200.63
        },
        {
          "text": "Um ihn herum sitzen Männer in Gummistiefeln, karierten Hemden und bunten Funktionsjacken.",
          "start": 202.93,
          "end": 210.73
        },
        {
          "text": "Die Nadel des Kompasses zeigt nach Norden.",
          "start": 213.64,
          "end": 216.96
        },
        {
          "text": "Der Aufstieg auf den Berg war sehr anstrengend.",
          "start": 219.76,
          "end": 223.12
        },
        {
          "text": "Sie hat einen steinigen Weg vor ihr.",
          "start": 226.07,
          "end": 228.77
        },
        {
          "text": "Mein Vater ist in seiner Jugend viel geklettert.",
          "start": 231.82,
          "end": 234.92
        },
        {
          "text": "Die Luft im Wald ist sehr erfrischend.",
          "start": 238.25,
          "end": 241.01
        },
        {
          "text": "In den österreichischen Alpen sind zwei deutsche Wanderer tot aufgefunden worden.",
          "start": 243.22,
          "end": 249.34
        }
      ]
    }
