    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die Erde dreht sich um die Sonne.",
          "start": 129.66,
          "end": 132.18
        },
        {
          "text": "Die Drehung der Erde erfolgt um diese Erdachse von West nach Ost.",
          "start": 136.05,
          "end": 140.81
        },
        {
          "text": "In der Troposphäre, in der wir leben, sind fast der gesamte Wasserdampf der Atmosphäre enthalten.",
          "start": 143.81,
          "end": 150.63
        },
        {
          "text": "In Stratosphäre, in 15 bis 50 Kilometern Höhe, liegt die Ozonschicht.",
          "start": 152.93,
          "end": 160.27
        },
        {
          "text": "In Thermosphäre steigt die Temperatur bis über 1700 Grad Celsius.",
          "start": 163.34,
          "end": 169.68
        },
        {
          "text": "Erdrotation ist verantwortlich für die Entstehung von Tag und Nacht.",
          "start": 172.87,
          "end": 177.45
        },
        {
          "text": "Für eine vollständige Drehung um die Erdachse benötigt die Erde 23 Stunden, 56 Minuten und 4 Sekunden.",
          "start": 180.52,
          "end": 191.72
        },
        {
          "text": "Dieser Zeitraum wird Sterntag genannt.",
          "start": 192.14,
          "end": 195.38
        },
        {
          "text": "Warme Meeresströmungen bewegen sich immer vom Äquator weg entlang der Ostküsten der Kontinente.",
          "start": 198.91,
          "end": 205.63
        },
        {
          "text": "Am Äquator dauert jeder Tag und jede Nacht stets 12 Stunden.",
          "start": 208.53,
          "end": 213.61
        },
        {
          "text": "Äquator ist auch ein Breitenkreis.",
          "start": 217.51,
          "end": 220.51
        },
        {
          "text": "Alle Längenkreise stehen senkrecht zu allen Breitenkreisen.",
          "start": 223.94,
          "end": 227.78
        },
        {
          "text": "Der Nullmeridian unterteilt die Erde in östliche und westliche geografische Länge.",
          "start": 231.32,
          "end": 237.5
        },
        {
          "text": "Der Wind kommt von Osten.",
          "start": 240.52,
          "end": 242.46
        },
        {
          "text": "Das Zimmer geht nach Westen.",
          "start": 245.52,
          "end": 247.84
        },
        {
          "text": "Das Gebirge setzt sich nach Süden fort.",
          "start": 250.56,
          "end": 253.32
        }
      ]
    }
