    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der alte Mann lebte in der Abgeschiedenheit.",
          "start": 122.82,
          "end": 126.66
        },
        {
          "text": "Nach dem Tod seiner Frau fühlte er sich sehr einsam.",
          "start": 129.63,
          "end": 133.43
        },
        {
          "text": "Er ist in seinem Alter in der großen Stadt völlig vereinsamt.",
          "start": 136.34,
          "end": 140.48
        },
        {
          "text": "Das Kind stand verlassen am Straßenrand.",
          "start": 143.57,
          "end": 146.31
        },
        {
          "text": "Was betrübt dich denn?",
          "start": 148.58,
          "end": 151.02
        },
        {
          "text": "Ist Lukas das verleugnete Kind, das aus Enttäuschung und Wut den eigenen Vater ermordet hat?",
          "start": 154.05,
          "end": 160.23
        },
        {
          "text": "Spinner am Morgen bringt Kummer und Sorgen, Spinner am Abend erquickend und labend.",
          "start": 163.56,
          "end": 169.72
        },
        {
          "text": "Er war so traurig, dass er weinte.",
          "start": 172.62,
          "end": 175.02
        },
        {
          "text": "Eine tiefe Verzweiflung packte ihn.",
          "start": 178.13,
          "end": 180.69
        },
        {
          "text": "Dieses nasskalte Wetter deprimiert mich.",
          "start": 182.99,
          "end": 186.59
        },
        {
          "text": "Sein schweres Schicksal hatte ihn abgestumpft.",
          "start": 189.71,
          "end": 193.31
        },
        {
          "text": "Seine Apathie führt dazu, dass seine Frau mit Kindern das Haus verlässt.",
          "start": 196.32,
          "end": 201.84
        },
        {
          "text": "Es ist mir völlig gleichgültig, ob du kommst oder nicht.",
          "start": 204.25,
          "end": 207.81
        },
        {
          "text": "Wegen Geschäft zeigt er stets seiner Frau die kalte Schulter.",
          "start": 210.87,
          "end": 214.97
        },
        {
          "text": "Wie kann ich dich wieder aufrichten?",
          "start": 217.85,
          "end": 219.91
        },
        {
          "text": "Ihre Worte trösteten mich.",
          "start": 223.09,
          "end": 225.11
        }
      ]
    }
