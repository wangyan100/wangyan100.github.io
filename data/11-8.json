    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die analytische Geometrie stellt algebraische Hilfsmittel zur Lösung geometrischer Probleme bereit.",
          "start": 135.73,
          "end": 143.43
        },
        {
          "text": "Das vorliegende Lehrbuch der Planimetrie ist für Bedürfnisse der Schüler höherer Klassen bestimmt.",
          "start": 146.55,
          "end": 153.19
        },
        {
          "text": "Die Stereometrie stellt im antiken Griechenland einen der Wissenschaftsbereiche dar, die von herausragender Bedeutung waren.",
          "start": 156.31,
          "end": 165.03
        },
        {
          "text": "Die Summe aller Winkel im Dreieck beträgt 180 Grad.",
          "start": 168.08,
          "end": 172.52
        },
        {
          "text": "Das unregelmäßige Dreieck ist das Dreieck, in der alle drei Seiten unterschiedlich lang sind.",
          "start": 175.55,
          "end": 182.23
        },
        {
          "text": "Ein gleichseitiges Dreieck kann in vierteilige, kleine gegliedert werden.",
          "start": 185.16,
          "end": 190.56
        },
        {
          "text": "Als Hypotenuse bezeichnet man die längste Seite eines rechtwinkligen Dreiecks und sie liegt dem rechten Winkel gegenüber.",
          "start": 193.66,
          "end": 202.28
        },
        {
          "text": "Winkel können ihrer Größe nach in verschiedene Winkelarten eingeteilt werden, wie der rechte Winkel, der spitze Winkel, der stumpfe Winkel.",
          "start": 205.61,
          "end": 215.27
        },
        {
          "text": "Man bezeichnet Peripherie als einen mathematischen Begriff für den Umfang des Kreises.",
          "start": 218.22,
          "end": 224.78
        },
        {
          "text": "Eine Raute oder ein Rombus ist ein ebenes Viereck mit vier gleich langen Seiten.",
          "start": 227.75,
          "end": 234.21
        },
        {
          "text": "Gegenüberliegende Seiten sind parallel und gegenüberliegende Winkel gleich groß.",
          "start": 235.01,
          "end": 240.77
        },
        {
          "text": "Ein Würfel besteht aus sechs quadratischen Flächen.",
          "start": 243.71,
          "end": 247.41
        }
      ]
    }
