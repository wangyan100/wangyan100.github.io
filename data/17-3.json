    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Er gewann 50 Euro beim Bingo.",
          "start": 124.6,
          "end": 127.32
        },
        {
          "text": "Das Spiel Go besaß in China im Lauf der Geschichte verschiedene Bezeichnungen.",
          "start": 130.34,
          "end": 135.68
        },
        {
          "text": "Das Puzzle ist ein altes Spiel.",
          "start": 137.92,
          "end": 140.9
        },
        {
          "text": "Seit 1953 gilt Schach in Deutschland als Sportart.",
          "start": 143.99,
          "end": 148.81
        },
        {
          "text": "Bridge ist ein Kartenspiel für vier Personen.",
          "start": 152.01,
          "end": 154.69
        },
        {
          "text": "Der Joker wird meist als wilde Karte eingesetzt, also als Ersatz für eine beliebige Karte.",
          "start": 157.77,
          "end": 165.13
        },
        {
          "text": "Poker wird weit übergehend zu den Glücksspielen gezählt.",
          "start": 167.79,
          "end": 171.57
        },
        {
          "text": "Meine Schwester kann sehr gut kochen und backen.",
          "start": 174.73,
          "end": 178.05
        },
        {
          "text": "Grillst du das Gemüse auf diesem Grill?",
          "start": 179.9,
          "end": 182.64
        },
        {
          "text": "Je länger das Fleisch schmort, desto zarter wird es.",
          "start": 183.8,
          "end": 188.1
        },
        {
          "text": "Manche Brotsorten sind stark gewürzt, zum Beispiel mit Kümmel.",
          "start": 190.94,
          "end": 195.72
        },
        {
          "text": "Heute wird Holzkohle meist nur noch zum Grillen im Garten gebraucht.",
          "start": 199.08,
          "end": 203.36
        },
        {
          "text": "Die Sonne ist bereits untergegangen, nur das Lagerfeuer flackert vor sich hin.",
          "start": 206.38,
          "end": 211.42
        },
        {
          "text": "Fallschirmspringen ist in Deutschland nur mit einer gültigen Lizenz oder in der Ausbildung erlaubt.",
          "start": 215.04,
          "end": 221.02
        },
        {
          "text": "Bist du schon mal auf einem Pony geritten?",
          "start": 223.52,
          "end": 225.56
        }
      ]
    }
