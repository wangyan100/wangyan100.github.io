    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Nach der Heirat hat er die Mitgiften seiner Frau in die Börse gesetzt.",
          "start": 131.14,
          "end": 136.88
        },
        {
          "text": "Ein Heiratsantrag sollte kreativ und romantisch sein.",
          "start": 139.15,
          "end": 143.87
        },
        {
          "text": "Diese schöne Frau nimmt die Werbung dieses Mannes an.",
          "start": 147.19,
          "end": 150.63
        },
        {
          "text": "Das Geheimnis liegt nun bloß.",
          "start": 153.55,
          "end": 156.13
        },
        {
          "text": "Mit dem Ja-Wort der Angebeteten in einem Heiratsantrag versprechen sich beide Seiten, den Bund der Ehe einzugehen.",
          "start": 158.99,
          "end": 167.53
        },
        {
          "text": "Bevor sie ins Bett geht, hat sie alles Schmuck abgestreift.",
          "start": 170.14,
          "end": 174.14
        },
        {
          "text": "Der klassische Verlobungsring ist ein mit einem Diamanten besetzter Ring.",
          "start": 176.35,
          "end": 181.97
        },
        {
          "text": "Das alte Ehepaar führt ein zurückgezogenes Leben.",
          "start": 185.09,
          "end": 188.69
        },
        {
          "text": "In der Vergangenheit in China soll die Braut ihr Gesicht mit einem roten Schleier in der Hochzeit verhüllen.",
          "start": 191.76,
          "end": 198.14
        },
        {
          "text": "Die Brautjungfern waren ursprünglich dazu da, böse Geister von der Braut abzulenken.",
          "start": 201.3,
          "end": 207.56
        },
        {
          "text": "Die traditionelle Farbe für Brautkleider in den westlichen Ländern ist weiß, da diese Farbe für Reinheit steht.",
          "start": 209.83,
          "end": 218.27
        },
        {
          "text": "Geldgeschenke sind bei einer Hochzeit äußerst beliebt.",
          "start": 221.48,
          "end": 224.98
        },
        {
          "text": "Sie haben sich auf dem Standesamt trauen lassen.",
          "start": 227.87,
          "end": 231.03
        }
      ]
    }
