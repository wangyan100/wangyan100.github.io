    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Bei welchem Verlag erscheint das Werk?",
          "start": 122.18,
          "end": 125.32
        },
        {
          "text": "Helmut Schmidt ist einer der Herausgeber Er wird als Kolumnist für eine Schweizer Tageszeitung arbeiten.",
          "start": 128.44,
          "end": 139.1
        },
        {
          "text": "Die Regierung wirft einigen Programmen vor, Propaganda zu betreiben.",
          "start": 142.25,
          "end": 146.65
        },
        {
          "text": "Das ist eine Zeitschrift mit einer hohen Auflage.",
          "start": 149.74,
          "end": 152.9
        },
        {
          "text": "Dieses Buch ist schon rund 50.000 Exemplare gedruckt worden.",
          "start": 156.04,
          "end": 160.4
        },
        {
          "text": "Seine Aufsätze wurden in Buchform herausgegeben.",
          "start": 163.66,
          "end": 167.02
        },
        {
          "text": "Der Redakteur empfiehlt den Lesern von einem lesenswerten Roman.",
          "start": 170.09,
          "end": 174.17
        },
        {
          "text": "Der erste Verleger lehnte das Buch ab.",
          "start": 177.24,
          "end": 179.9
        },
        {
          "text": "Dem zweiten gefiel dieses Buch.",
          "start": 180.3,
          "end": 182.22
        },
        {
          "text": "Der neue Ministerpräsident wurde mit der Kabinettsbildung beauftragt.",
          "start": 185.31,
          "end": 189.93
        },
        {
          "text": "Bitte korrigieren Sie mich, wenn ich etwas Falsches sage.",
          "start": 192.99,
          "end": 196.21
        },
        {
          "text": "Er schickt das Manuskript an einen Redakteur.",
          "start": 199.32,
          "end": 202.44
        },
        {
          "text": "Ich habe den Vertrag in der letzten Woche unterschrieben.",
          "start": 205.25,
          "end": 208.73
        },
        {
          "text": "Das geschützte Objekt des Urheberrechts ist in allen Rechtsordnungen ein Werk der Kunst.",
          "start": 211.71,
          "end": 217.69
        },
        {
          "text": "Wer als Arzt mitmacht, kann pro Behandlung 20 bis 30 Euro als Honorar erhalten.",
          "start": 220.92,
          "end": 227.18
        }
      ]
    }
