    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Spieler geht als Sieger aus einem Wettkampf hervor.",
          "start": 122.12,
          "end": 126.22
        },
        {
          "text": "Tischtennis wurde erstmals Ende des 19.",
          "start": 129.25,
          "end": 132.31
        },
        {
          "text": "Jahrhunderts in England gespielt.",
          "start": 132.49,
          "end": 134.31
        },
        {
          "text": "Der Aufschläger stößt sich an der Kante des Tischtennistischs.",
          "start": 137.43,
          "end": 142.05
        },
        {
          "text": "Der Verlierer des Finales bekommt noch 2 Millionen Euro als Trostpreis.",
          "start": 144.43,
          "end": 150.25
        },
        {
          "text": "Der Weltmeister unterliegt seinem ehemaligen Gegner.",
          "start": 152.49,
          "end": 157.17
        },
        {
          "text": "Der Einsatz der Ballroboter als Mittel zum Ausdauertraining ist unproblematisch.",
          "start": 160.17,
          "end": 166.09
        },
        {
          "text": "Wenn der Ball die Netzgarnitur berührt und in das Spielfeld des Aufschlägers zurückfällt, erhält der Gegner einen Punkt.",
          "start": 169.03,
          "end": 177.11
        },
        {
          "text": "Sie wechselten ihre Plätze.",
          "start": 180.29,
          "end": 182.19
        },
        {
          "text": "Zieh bitte die Rollläden am Fenster hoch und lass Licht herein.",
          "start": 185.31,
          "end": 189.07
        },
        {
          "text": "Der Spieler schmettert den Ball und endet den letzten Satz.",
          "start": 191.34,
          "end": 196.56
        },
        {
          "text": "Der Topspin ist einer der wichtigsten Angriffsschläge im Tischtennis.",
          "start": 198.98,
          "end": 203.84
        },
        {
          "text": "Die Winkel im Dreieck ergeben zusammen 180 Grad.",
          "start": 206.86,
          "end": 211.02
        },
        {
          "text": "Das Doppel im Tischtennis kann als Herrendoppel, Damendoppel und gemischtes Doppel gespielt werden.",
          "start": 214.12,
          "end": 221.2
        },
        {
          "text": "Die chinesische Nationalmannschaft bleibt im Einzel immer die Oberhand.",
          "start": 224.3,
          "end": 229.12
        }
      ]
    }
