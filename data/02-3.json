    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Unterhalb einer Stammwürze von 7% spricht man vom Einfachbier.",
          "start": 112.22,
          "end": 117.14
        },
        {
          "text": "Fassbier enthält etwas mehr Kohlensäure als Flaschenbier.",
          "start": 117.14,
          "end": 124.81
        },
        {
          "text": "Die Berliner Weiße ist ein Weißbier, das aus der deutschen Hauptstadt stammt.",
          "start": 124.81,
          "end": 133.35
        },
        {
          "text": "Leicht salzig und säuerlich im Geschmack gehört die Gose zur Familie der Sauerbiere.",
          "start": 133.35,
          "end": 142.17
        },
        {
          "text": "Der Ursprung des Kölsches geht zurück auf die Zeit des Hochmittelalters bis in die Renaissance.",
          "start": 142.17,
          "end": 152.17
        },
        {
          "text": "Der Hopfen spielt bei den meisten Stauts eine nur sehr untergeordnete Rolle, um die Malzsüße mit einer leichten Hopfenbittere etwas auszubalancieren.",
          "start": 152.17,
          "end": 166.21
        },
        {
          "text": "Das Walzenbier hat eine Stammwürze von 11% und einen Alkoholgehalt von 5,4%.",
          "start": 166.21,
          "end": 177.13
        },
        {
          "text": "Lagerbiere schmecken malzig, weich und ein wenig süß.",
          "start": 177.13,
          "end": 185.4
        },
        {
          "text": "Die Rotfärbung des Rotbiers wird durch Lagerung oder die Zugabe von Farbmalzen erreicht.",
          "start": 185.4,
          "end": 195.01
        },
        {
          "text": "Durch die Verwendung von dunklen Röstmalzen erhält Schwarzbier seine Farbe.",
          "start": 195.01,
          "end": 204.26
        },
        {
          "text": "Der Geschmack des Bockbeeres lässt sich als vollmundig beschreiben.",
          "start": 204.26,
          "end": 211.23
        }
      ]
    }
  ]
