    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Dieser Wein ist um eine Nuance herber.",
          "start": 111.71,
          "end": 114.57
        },
        {
          "text": "Das Gericht ist mild gewürzt.",
          "start": 117.7,
          "end": 120.16
        },
        {
          "text": "Die Speise schmeckt süß.",
          "start": 123.2,
          "end": 125.8
        },
        {
          "text": "Nachdem Sie die Stoffe vermischt haben, erhitzen Sie sie auf 70 Grad und warten die chemische Reaktion ab.",
          "start": 128.3,
          "end": 136.62
        },
        {
          "text": "Weinbrand soll in alten Holzfässern lagern.",
          "start": 139.18,
          "end": 143.52
        },
        {
          "text": "Der Koch gibt Milch, Eier und Mehl in eine Schüssel und rührt sie kräftig.",
          "start": 146.2,
          "end": 151.58
        },
        {
          "text": "Der Saft ist zu Most vergoren.",
          "start": 154.65,
          "end": 157.15
        },
        {
          "text": "Er hilft seiner Mutter, den Wein auszuschenken.",
          "start": 160.22,
          "end": 163.84
        },
        {
          "text": "Darf ich Ihnen noch eine Tasse Tee einschenken?",
          "start": 166.77,
          "end": 169.65
        },
        {
          "text": "Er trinkt mit kleinen Schlucken das heiße Wasser.",
          "start": 172.5,
          "end": 175.68
        },
        {
          "text": "Er hat ein Glas Wein in großen Zügen ausgetrunken.",
          "start": 175.68,
          "end": 183.18
        },
        {
          "text": "Weißt du was?",
          "start": 185.98,
          "end": 186.7
        },
        {
          "text": "Der alte Schmidt säuft.",
          "start": 187.12,
          "end": 188.96
        },
        {
          "text": "Gestern habe ich zu viel getrunken.",
          "start": 191.88,
          "end": 194.54
        },
        {
          "text": "Die ganze Nacht hindurch zechten wir in der Bar.",
          "start": 197.29,
          "end": 200.25
        }
      ]
