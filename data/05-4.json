    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Beklagte wird verurteilt, an den Kläger 1000 Euro zu bezahlen.",
          "start": 135.36,
          "end": 141.03
        },
        {
          "text": "Er ist ein gerechter Richter.",
          "start": 143.87,
          "end": 146.19
        },
        {
          "text": "War der Täter alleine oder hatte er geholfen?",
          "start": 149.0,
          "end": 152.36
        },
        {
          "text": "Haben Sie Zeugen, die diese Aussage bestätigen können?",
          "start": 155.19,
          "end": 158.87
        },
        {
          "text": "Das Landgericht Frankfurt am Main hat zu Unrecht die Klage abgewiesen.",
          "start": 161.88,
          "end": 166.8
        },
        {
          "text": "Die Klägerin hat den Rechtsstreit zurückgezogen.",
          "start": 169.8,
          "end": 173.4
        },
        {
          "text": "Der alte Mann prozessierte gegen jeden in der Nachbarschaft.",
          "start": 176.44,
          "end": 180.66
        },
        {
          "text": "Der Verteidiger will Rücksprache mit seinem Mandanten nehmen.",
          "start": 183.68,
          "end": 187.4
        },
        {
          "text": "Die Verhandlung fand unter Ausschluss der Öffentlichkeit statt.",
          "start": 190.5,
          "end": 194.14
        },
        {
          "text": "Der Verteidiger plädierte auf Freispruch.",
          "start": 196.92,
          "end": 200.04
        },
        {
          "text": "Das Gericht hat den Beschuldigten mangels Beweises freigesprochen.",
          "start": 203.02,
          "end": 207.26
        },
        {
          "text": "Er wurde zu drei Jahren Haft verurteilt.",
          "start": 210.35,
          "end": 213.39
        },
        {
          "text": "Es ist noch umstritten, ob die Todesstrafe abgeschafft werden soll.",
          "start": 216.37,
          "end": 220.77
        },
        {
          "text": "Die junge Frau weigerte sich, das Urteil zu vollstrecken.",
          "start": 223.84,
          "end": 227.74
        },
        {
          "text": "Eine Verbrecherbande hat seinen Sohn gekidnappt und verlangt ein Lösegeld.",
          "start": 230.74,
          "end": 235.8
        },
        {
          "text": "Der Tatort ist die beliebte Krimireihe der ARD.",
          "start": 238.08,
          "end": 242.74
        }
      ]
    }
