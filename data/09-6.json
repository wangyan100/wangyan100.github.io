    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Chromosomen enthalten Erbinformationen.",
          "start": 138.18,
          "end": 142.52
        },
        {
          "text": "Genau wie der Mensch besitzen auch Tiere oder Pflanzen bestimmte Gene.",
          "start": 144.73,
          "end": 149.19
        },
        {
          "text": "Diese Krankheit hat sich vom Vater auf den Sohn vererbt.",
          "start": 152.28,
          "end": 155.68
        },
        {
          "text": "Die Mediziner isolierten aus dem Knochenmark die Stammzellen.",
          "start": 158.7,
          "end": 162.68
        },
        {
          "text": "Meistens sind die Zellkerne kugelförmig oder oval.",
          "start": 165.75,
          "end": 169.33
        },
        {
          "text": "Denn in der Nahrung stecken Fett, Eiweiß und Zucker.",
          "start": 172.36,
          "end": 175.62
        },
        {
          "text": "Und die sind wichtige Energiequellen für Muskeln, Organe und vor allem unser Gehirn.",
          "start": 176.08,
          "end": 181.56
        },
        {
          "text": "Zusammen mit den Knochen, Muskeln und Gelenken bilden Sehnen und Bänder den Stütz- und Bewegungsapparat des Menschen.",
          "start": 183.83,
          "end": 192.13
        },
        {
          "text": "Während die Sehnen Knochen mit Muskeln verbinden, benötigen wir Bänder um unsere Gelenke zu sichern.",
          "start": 192.13,
          "end": 202.42
        },
        {
          "text": "Das Jochbein im Gesicht ist eine Schwachstelle und bricht sehr häufig nach Unfällen.",
          "start": 202.42,
          "end": 210.8
        },
        {
          "text": "Mit Hilfe eines MRTs bekommt er ein Bild von seinem Schädel.",
          "start": 210.8,
          "end": 218.66
        },
        {
          "text": "Die Blutplättchen spielen eine wichtige Rolle bei der Blutstillung.",
          "start": 218.66,
          "end": 225.54
        },
        {
          "text": "An den großen Arterien ist der Herzschlag gut tastbar, deshalb werden sie auch als Schlagadern bezeichnet.",
          "start": 225.54,
          "end": 235.82
        },
        {
          "text": "Hinten im Schädel, unterhalb des Großhirns und hinter dem Hirnstamm liegt das Kleinhirn.",
          "start": 235.82,
          "end": 245.35
        }
      ]
    }
