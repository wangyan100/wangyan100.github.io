    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "An den Wänden hängt ein Familienfoto neben dem anderen.",
          "start": 110.28,
          "end": 114.08
        },
        {
          "text": "Die Polizei sucht per Lichtbild nach einem der beiden Räuber.",
          "start": 117.1,
          "end": 121.16
        },
        {
          "text": "Der elektronische Personalausweis besitzt einen integrierten Chip, der unter anderem ein digitales Passfoto enthält.",
          "start": 124.21,
          "end": 132.27
        },
        {
          "text": "Auf einem Satellitenfoto entdeckte der US-amerikanische Geheimdienst in der Sowjetunion eine Langstreckenrakete.",
          "start": 135.34,
          "end": 143.9
        },
        {
          "text": "Selfie gehört zu den Begriffen des 21.",
          "start": 146.71,
          "end": 149.79
        },
        {
          "text": "Jahrhunderts, die man kennen sollte.",
          "start": 150.25,
          "end": 152.11
        },
        {
          "text": "In der Hand beginnt der Selfie-Stick schnell zu wackeln.",
          "start": 155.21,
          "end": 158.69
        },
        {
          "text": "Im Zeitraffer erkennen wir, dass das Leben ein Wettlauf gegen die Uhr ist.",
          "start": 161.76,
          "end": 166.38
        },
        {
          "text": "Die Batterie ist erschöpft.",
          "start": 169.38,
          "end": 171.2
        },
        {
          "text": "Er hat einen neuen Film in die Kamera eingelegt.",
          "start": 174.18,
          "end": 177.18
        },
        {
          "text": "In einem bestimmten Abstand hinter dem Objektiv befindet sich das Okular.",
          "start": 180.2,
          "end": 185.16
        },
        {
          "text": "Mit der Spiegelreflexkamera habe ich viele Urlaubsfotos gemacht.",
          "start": 188.26,
          "end": 192.86
        },
        {
          "text": "Wenn die Sonne scheint, versuche lieber im Schatten zu fotografieren und eventuell mit einem Blitzlicht das Gesicht aufzuhellen.",
          "start": 195.9,
          "end": 204.04
        },
        {
          "text": "Während der Reise knipste sie viele Bilder.",
          "start": 207.19,
          "end": 210.09
        },
        {
          "text": "Wenn die Lichtverhältnisse gut sind, überzeugt auch die Qualität der Fotos.",
          "start": 213.22,
          "end": 218.4
        }
      ]
    }
