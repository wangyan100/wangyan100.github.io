    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das Gymnasium ist die höchste Schulart in Deutschland und zielt für die Schüler ab, die in der Zukunft an der Universität studieren möchten.",
          "start": 150.01,
          "end": 159.23
        },
        {
          "text": "In manchen Bundesländern gibt es Gesamtschulen, in denen Hauptschule, Realschule und Gymnasium zusammen sind.",
          "start": 162.04,
          "end": 169.9
        },
        {
          "text": "Im Studienkolleg können sich die ausländischen Studenten auf das Fachstudium an der Universität vorbereiten.",
          "start": 172.95,
          "end": 181.13
        },
        {
          "text": "Sein Vater ist Professor für Maschinenbau.",
          "start": 183.85,
          "end": 186.79
        },
        {
          "text": "Der Lehrer setzt sich zwischen Pult und Tafel.",
          "start": 189.74,
          "end": 193.6
        },
        {
          "text": "Unter der Leitung von dem Lehrer unternehmen alle Teilnehmenden des Seminars eine Exkursion.",
          "start": 195.84,
          "end": 202.88
        },
        {
          "text": "Im Gegensatz zu einem Seminar bedeutet Kolloquium einen fachlichen Gedankenaustausch ohne feste Form.",
          "start": 205.45,
          "end": 213.21
        },
        {
          "text": "Man macht normalerweise am Ende der zwölften Klasse Abitur am Gymnasium.",
          "start": 216.32,
          "end": 221.74
        },
        {
          "text": "Nach dem zehnten Semester hat Hans sein Examen gemacht.",
          "start": 224.7,
          "end": 228.86
        },
        {
          "text": "Sie hat bei der mündlichen Prüfung gut abgeschnitten.",
          "start": 231.13,
          "end": 235.55
        },
        {
          "text": "Ich habe die schriftliche Prüfung bestanden.",
          "start": 238.38,
          "end": 241.16
        }
      ]
    }
