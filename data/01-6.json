    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Gerste wird überwiegend als Tierfutter verwendet.",
          "start": 127.91,
          "end": 132.03
        },
        {
          "text": "Die Haferpflanzen sind einjährige Gräser.",
          "start": 134.27,
          "end": 138.95
        },
        {
          "text": "Der Herbst ist die beste Jahreszeit für Menschen, Mais zu essen.",
          "start": 141.65,
          "end": 146.13
        },
        {
          "text": "Mit Stärke speichern Pflanzen ihre überschüssige Energie als Reserve.",
          "start": 149.13,
          "end": 154.23
        },
        {
          "text": "In China isst man gern Zunzi aus Klebreis, eingewickelt in Bambus oder Schilfblätter mit verschiedenen Füllungen.",
          "start": 157.44,
          "end": 166.68
        },
        {
          "text": "Glasnudeln sind eine Nudelartige Beilage in den ostasiatischen Gerichten.",
          "start": 169.02,
          "end": 175.9
        },
        {
          "text": "Kaiserschmarrn zählt zu den bekanntesten Süßspeisen der österreichischen Küche.",
          "start": 179.07,
          "end": 184.83
        },
        {
          "text": "Der Name leitet sich von Kaiser Franz Josef I. ab.",
          "start": 185.03,
          "end": 189.49
        },
        {
          "text": "Gewürzgurken gelten als besonders während der Schwangerschaft geeignetes Nahrungsmittel.",
          "start": 192.37,
          "end": 198.31
        },
        {
          "text": "Am Abend habe ich den Rest vom Gulasch aufgewärmt.",
          "start": 201.36,
          "end": 204.84
        },
        {
          "text": "Als spanisches Nationalgericht ist Tortilla ein Omelett aus Eiern mit Kartoffeln und Zwiebeln.",
          "start": 207.12,
          "end": 215.12
        },
        {
          "text": "Bereits im siebten Jahrhundert entstand die koreanische Variante des Sauerkrauts, das Kimchi.",
          "start": 218.29,
          "end": 224.71
        }
      ]
    }
