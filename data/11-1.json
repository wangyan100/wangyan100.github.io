    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Das lässt sich nicht mit zwei, drei Worten erklären.",
          "start": 130.01,
          "end": 133.39
        },
        {
          "text": "Aller guten Dinge sind drei.",
          "start": 136.56,
          "end": 138.7
        },
        {
          "text": "Die vier Brunnen ist eine 1588 errichtete barocke Brunnenanlage in Rom.",
          "start": 141.63,
          "end": 148.87
        },
        {
          "text": "Die sechs ist an deutschen Schulen die geringstwertige Leistungsnote.",
          "start": 151.9,
          "end": 156.72
        },
        {
          "text": "Katzen werden im Volksmund neun Leben nachgesagt.",
          "start": 159.86,
          "end": 163.52
        },
        {
          "text": "Im amerikanischen Virginia Beach hat ein Schütze zwölf Menschen getötet und vier verletzt. 13 gilt in vielen Kulturen als Unglückszahl.",
          "start": 165.72,
          "end": 180.03
        },
        {
          "text": "In der DDR war das Alter von 60 Jahren das normale Renteneintrittsalter für Frauen. 100 Jahre Einsamkeit ist ein Roman des kolumbianischen Autors Gabriel Garcia Marquez, für den er 1982 den Nobelpreis für Literatur erhielt.",
          "start": 183.74,
          "end": 206.56
        },
        {
          "text": "Zur Ehrung von gefallenen und vermissten Soldaten haben sich zehntausende Motorradfahrer aus den USA zu einer traditionellen Gedenkfahrt in Washington versammelt.",
          "start": 209.75,
          "end": 221.47
        },
        {
          "text": "Die Polizei schätzt den Schaden auf mindestens 20 Millionen Euro.",
          "start": 224.42,
          "end": 229.42
        },
        {
          "text": "Insgesamt kauften die Deutschen 2018 rund 67 Milliarden Zigaretten, 2,5 Prozent weniger als 2017.",
          "start": 231.69,
          "end": 243.49
        }
      ]
    }
