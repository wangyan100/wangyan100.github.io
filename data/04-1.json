    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Der Computer ist nicht mehr zu bezahlen.",
          "start": 141.36,
          "end": 147.16
        },
        {
          "text": "Das Medikament ist nur gegen Rezept erhältlich.",
          "start": 147.16,
          "end": 153.97
        },
        {
          "text": "Darf ich mal fragen, gibt es Rabatt für Studenten?",
          "start": 153.97,
          "end": 160.96
        },
        {
          "text": "Gekaufte Tickets behalten ihre Gültigkeit.",
          "start": 160.96,
          "end": 166.92
        },
        {
          "text": "Der Vorverkauf läuft.",
          "start": 166.92,
          "end": 172.2
        },
        {
          "text": "Der Film ist für Jugendliche nicht freigegeben.",
          "start": 172.2,
          "end": 178.36
        },
        {
          "text": "Die Kinofilme, die von der FSK ab 12 Jahren freigegeben werden, sollen die Kinder ab 6 Jahren in Begleitung eines Elternteils sehen.",
          "start": 178.36,
          "end": 192.22
        },
        {
          "text": "Seine Frau spielt die Hauptrolle in seinem Leben.",
          "start": 192.22,
          "end": 198.32
        },
        {
          "text": "Der Regisseur Ang Li geht nach Berlin und stellt seinen neuen Film persönlich vor.",
          "start": 198.32,
          "end": 207.54
        },
        {
          "text": "Deutsche Komödien können nicht den Geschmack aller Zuschauer treffen.",
          "start": 207.54,
          "end": 214.87
        },
        {
          "text": "Dieser Film wird im nächsten Jahr über die Leinwand laufen.",
          "start": 214.87,
          "end": 221.67
        },
        {
          "text": "Das ist ein Film in chinesischer Originalfassung mit deutschen Untertiteln.",
          "start": 221.67,
          "end": 229.5
        },
        {
          "text": "Die Zuschauer strömen in die Kinos.",
          "start": 229.5,
          "end": 235.64
        }
      ]
    }
