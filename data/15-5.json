    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Die weibliche Amsel baut dreimal im Jahr ein Nest.",
          "start": 140.3,
          "end": 144.06
        },
        {
          "text": "Die Blauracke ist eine wärmeliebende Art, die während der Brutmonate Mai, Juni und Juli möglichst trockene und warme Witterungsverhältnisse benötigt.",
          "start": 147.28,
          "end": 158.6
        },
        {
          "text": "In der germanischen Mythologie war die Elster sowohl Götterbote als auch der Vogel der Todesgöttin Hel.",
          "start": 161.6,
          "end": 168.94
        },
        {
          "text": "Meisen brüten gerne in der Nähe von oder in Obstbäumen, wobei sie die dort anzutreffenden Insekten bzw. deren Larven als Nahrung für die Brut verwenden.",
          "start": 172.22,
          "end": 184.54
        },
        {
          "text": "Der Pyrol ruft im grünen Hag.",
          "start": 187.62,
          "end": 190.18
        },
        {
          "text": "Der Gesang von Rotkirchen beginnt etwa eine Stunde vor Sonnenaufgang.",
          "start": 193.33,
          "end": 198.41
        },
        {
          "text": "Früher traten die Spatzen in großen Schwärmen auf.",
          "start": 201.57,
          "end": 204.97
        },
        {
          "text": "Der Zaunkönig kann einen Stamm mit den langen Zehen und den kräftigen Krallen senkrecht hinaufklettern.",
          "start": 207.21,
          "end": 214.99
        },
        {
          "text": "Die Geier kreisen über dem Aas.",
          "start": 218.06,
          "end": 220.56
        },
        {
          "text": "Ein Habicht ist auf die Erde niedergestoßen und hat seine Beute gefasst.",
          "start": 223.51,
          "end": 228.35
        },
        {
          "text": "Die Eule gilt oft als Sinnbild der Weisheit.",
          "start": 231.41,
          "end": 234.77
        },
        {
          "text": "Die Schleiereule kommt als Brutvogel in vielen Regionen der Welt vor.",
          "start": 237.8,
          "end": 242.68
        },
        {
          "text": "Der Steinkauz galt im antiken Griechenland als Vogel der Weisheit und war Sinnbild der Götten Athene.",
          "start": 245.69,
          "end": 253.27
        }
      ]
    }
