    {
      "type": "sentences",
      "title": "Satzübung",
      "items": [
        {
          "text": "Nach der Ankunft in Deutschland muss man sich beim Einwohnermeldeamt anmelden.",
          "start": 134.85,
          "end": 142.95
        },
        {
          "text": "Entwerter können entweder stationär an Haltestellen oder Bahnhöfen oder mobil im Fahrzeug angebracht sein.",
          "start": 142.95,
          "end": 154.81
        },
        {
          "text": "Ich möchte an der nächsten Haltestelle aussteigen.",
          "start": 154.81,
          "end": 160.48
        },
        {
          "text": "Auch wenn wir ein Taxi nehmen, können wir den Zug nicht erreichen.",
          "start": 160.48,
          "end": 168.22
        },
        {
          "text": "Unser Mitgefühl gilt den betroffenen Fahrgästen und Busfahrern sowie deren Familien und Freunden.",
          "start": 168.22,
          "end": 178.42
        },
        {
          "text": "Alle Ausgänge waren versperrt.",
          "start": 178.42,
          "end": 183.56
        },
        {
          "text": "Er steigt endlich im allerletzten Moment in den Zug ein.",
          "start": 183.56,
          "end": 190.81
        },
        {
          "text": "Die Nummer meines Abteils war auf das Zugticket gedruckt.",
          "start": 190.81,
          "end": 197.45
        },
        {
          "text": "Unser Zug ist auf Gleis 5 angekommen.",
          "start": 197.45,
          "end": 203.36
        },
        {
          "text": "Der Zug hat möglicherweise 10 Minuten Verspätung, deshalb kann ich nicht pünktlich ankommen.",
          "start": 203.36,
          "end": 212.87
        },
        {
          "text": "Wir haben unsere Fahrkarten beim Schalter gelöst.",
          "start": 212.87,
          "end": 219.03
        }
      ]
    }
